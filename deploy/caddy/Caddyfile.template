# Rendered by the release controller for each activation ({{RELEASE_ID}}, {{REDIRECTS}}) and loaded
# through Caddy's admin API. Caddy validates the whole file before switching, so a bad render leaves the
# previous release serving. Hosts come from the caddy container's environment.

{
	email {$ACME_EMAIL}
	# Reachable only on the internal Docker network (never published).
	admin 0.0.0.0:2019 {
		origins caddy:2019
	}
	servers {
		trusted_proxies static private_ranges
	}
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# Internal-only listener (port not published): lets the release controller confirm which release is served.
http://:8088 {
	root * /srv/releases/{{RELEASE_ID}}
	file_server
}

www.{$PUBLIC_HOST} {
	redir https://{$PUBLIC_HOST}{uri} permanent
}

{$PUBLIC_HOST} {
	import security
	encode zstd gzip
	header X-Frame-Options "SAMEORIGIN"
	header Content-Security-Policy "default-src 'self'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src https://www.google.com https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'"

	# Real HTTP redirects for this release (legacy WordPress URLs and staff-managed redirects).
{{REDIRECTS}}

	# Only the public form endpoints reach the API from this host.
	@forms path /api/v1/enquiries /api/v1/applications /api/v1/health
	handle @forms {
		reverse_proxy api:8000
	}
	handle /api/* {
		respond 404
	}

	handle {
		root * /srv/releases/{{RELEASE_ID}}
		@assets path /_astro/* /media/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html path *.html */ /
		header @html Cache-Control "public, max-age=0, must-revalidate"
		try_files {path} {path}/index.html
		file_server
	}
	handle_errors 404 {
		root * /srv/releases/{{RELEASE_ID}}
		rewrite * /404.html
		file_server
	}
}

{$ADMIN_HOST} {
	import security
	encode zstd gzip
	header X-Frame-Options "DENY"
	header X-Robots-Tag "noindex, nofollow"
	header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'"
	handle /api/admin/* {
		reverse_proxy api:8000
	}
	handle /api/* {
		respond 404
	}
	handle {
		reverse_proxy admin:8080
	}
}

{$PREVIEW_HOST} {
	import security
	header X-Robots-Tag "noindex, nofollow"
	header Cache-Control "no-store"
	header Referrer-Policy "no-referrer"
	handle /api/preview/* {
		reverse_proxy api:8000
	}
	handle {
		# Never trust a client-supplied release header; only the API's answer counts.
		request_header -X-Preview-Release
		forward_auth api:8000 {
			uri /api/preview/check
			copy_headers X-Preview-Release
		}
		root * /srv/previews/{http.request.header.X-Preview-Release}
		try_files {path} {path}/index.html
		file_server
	}
}
