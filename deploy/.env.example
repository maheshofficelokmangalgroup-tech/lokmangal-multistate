# Production settings for deploy/compose.prod.yaml. Copy to .env, fill in every value, keep it secret.
# Generate secrets with:  openssl rand -base64 48

# --- Images -------------------------------------------------------------------------------------
IMAGE_OWNER=maheshofficelokmangalgroup-tech
TAG=change-me                       # image tag built by CI (e.g. the git commit)

# --- Domains (DNS A records must point to this server) ------------------------------------------
PUBLIC_HOST=lokmangalmultistate.com
ADMIN_HOST=admin.lokmangalmultistate.com
PREVIEW_HOST=preview.lokmangalmultistate.com
PUBLIC_SITE_URL=https://lokmangalmultistate.com
ADMIN_URL=https://admin.lokmangalmultistate.com
PREVIEW_URL=https://preview.lokmangalmultistate.com
ACME_EMAIL=it@lokmangal.co.in        # Let's Encrypt expiry notices

# --- Database -----------------------------------------------------------------------------------
POSTGRES_PASSWORD=

# --- Keys (base64, at least 32 random bytes each) -----------------------------------------------
SESSION_KEY=                        # hashes session, reset and preview tokens
DATA_ENCRYPTION_KEY=                # encrypts authenticator secrets — back this up separately
DATA_ENCRYPTION_KEY_VERSION=1
BUILD_SERVICE_TOKEN=                # shared by the API and the builder (at least 32 characters)

# --- Email (SMTP) -------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls              # starttls | tls | none
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Lokmangal Website <no-reply@lokmangalmultistate.com>

# --- Backups (restic repository, e.g. s3:https://s3.ap-south-1.amazonaws.com/bucket/lokmangal) ---
BACKUP_REPOSITORY=
BACKUP_PASSWORD=                    # restic encryption password — store a copy offline
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_AT=01:30                     # IST

# --- Tuning -------------------------------------------------------------------------------------
JOB_CONCURRENCY=2
BUILD_TIMEOUT_SECONDS=300
RUST_LOG=info
