---
import Icon from './Icon.astro';
import { siteData } from '../data/site';
import { getLang, localePath, stripLang } from '../i18n';

interface Props { current: string }
const { current } = Astro.props;
const lang = getLang(Astro);
const { nav } = siteData(lang);
// The "About Us" menu from the admin panel's navigation, whatever it is called in this language.
const links = nav.find((n) => n.href === '/about-us/' && n.children)?.children ?? [];
const here = stripLang(current);
---

<section class="section--tight about-nav-wrap">
  <div class="container">
    <p class="about-nav__title" data-reveal>{lang === 'mr' ? 'लोकमंगलबद्दल अधिक जाणून घ्या' : 'Explore more about Lokmangal'}</p>
    <div class="about-nav" data-stagger>
      {links.map((link) => (
        <a href={localePath(link.href, lang)} class:list={['about-nav__link', { 'is-current': link.href === here }]} aria-current={link.href === here ? 'page' : undefined}>
          <span>
            <strong>{link.label}</strong>
            {link.desc && <small>{link.desc}</small>}
          </span>
          <Icon name="arrow-right" size={18} />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .about-nav-wrap { padding-block: clamp(40px, 5vw, 64px); }
  .about-nav__title { margin-bottom: 14px; font-weight: 700; color: var(--ink); font-size: 1.05rem; }
  .about-nav { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); }
  @media (min-width: 900px) { .about-nav { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .about-nav__link {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 16px 18px; border-radius: var(--r); background: var(--surface); border: 1px solid var(--line);
    transition: border-color 0.25s, background 0.25s, transform 0.4s var(--ease-out);
  }
  .about-nav__link strong { display: block; color: var(--ink); font-size: 0.98rem; line-height: 1.3; }
  .about-nav__link small { display: block; margin-top: 2px; color: var(--muted); font-size: 0.84rem; line-height: 1.4; }
  .about-nav__link :global(.icon) { flex: none; color: var(--o-500); transition: transform 0.3s var(--ease-out); }
  .about-nav__link:hover { border-color: var(--o-300); transform: translateY(-3px); }
  .about-nav__link:hover :global(.icon) { transform: translateX(4px); }
  .about-nav__link.is-current { background: var(--g-800); border-color: var(--g-800); }
  .about-nav__link.is-current strong { color: #fff; }
  .about-nav__link.is-current small { color: rgb(255 255 255 / 0.7); }
  .about-nav__link.is-current :global(.icon) { color: var(--gold); }
</style>
