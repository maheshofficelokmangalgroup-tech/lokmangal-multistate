---
import Icon from './Icon.astro';
import { siteData } from '../data/site';
import { depositsData, fmtRate } from '../data/deposits';
import { loansData } from '../data/loans';
import { getLang, hasMarathi, localePath, stripLang, switchTarget } from '../i18n';
import { useT } from '../i18n/ui';

const lang = getLang(Astro);
const t = useT(lang);
const l = (p: string) => localePath(p, lang);
const otherLang = lang === 'mr' ? 'en' : 'mr';
const switchHref = switchTarget(Astro.url.pathname, otherLang);
const { announcement, nav, site } = siteData(lang);
const { schemes } = depositsData(lang);
const { loans } = loansData(lang);
const { schemeBySlug } = depositsData(lang);
const previews: Record<string, string> = {
  '/about-us/': '/images/about/banner.webp',
  '/chairman-message/': '/images/people/board-01.webp',
  '/board-of-directors/': '/images/board/banner.webp',
  '/social-responsibility/': '/images/csr/banner.webp',
  '/annual-reports/': '/images/home/intro.webp',
  '/gallery/': '/images/gallery/gallery-06.webp',
};
const previewFor = (href: string) => previews[href] ?? '/images/about/banner.webp';
const fdRate = schemeBySlug('vishwamangal-fixed-deposit-scheme')?.rate ?? null;
const rdRate = schemeBySlug('vishvamangal-recurring-deposit')?.rate ?? null;
const loanFrom = loans.length ? Math.min(...loans.map((x) => x.rateFrom)) : null;
// Three branded posts that play like stories on the phone in the products menu.
const stories = [
  { img: '/images/home/card-fd.webp', pos: '62% 40%', tag: t('mega.fd'), rate: fdRate, pre: '', note: t('mega.fdNote'), ribbon: t('mega.extra'), cta: t('mega.bookFd'), href: l('/apply-for-deposits/') },
  { img: '/images/home/card-rd.webp', pos: '55% 40%', tag: t('mega.rd'), rate: rdRate, pre: '', note: t('mega.rdNote'), ribbon: '', cta: t('mega.startRd'), href: l('/deposits/vishvamangal-recurring-deposit/') },
  { img: '/images/home/card-loan.webp', pos: '50% 40%', tag: t('mega.loansTag'), rate: loanFrom, pre: t('mega.from'), note: t('mega.loanNote'), ribbon: '', cta: t('mega.applyLoan'), href: l('/apply-loan/') },
].filter((x) => x.rate !== null);

const path = stripLang(Astro.url.pathname);
const productPaths = ['/deposits/', '/loans/', '/interest-rates/', '/calculators/', '/apply-for-deposits/', '/apply-loan/'];
const aboutPaths = ['/about-us/', '/chairman-message/', '/board-of-directors/', '/social-responsibility/', '/annual-reports/', '/gallery/'];
type Item = { href: string; mega?: boolean; children?: unknown[] };
const isActive = (item: Item) => {
  if (item.href === '/') return path === '/';
  if (item.mega) return productPaths.some((p) => path.startsWith(p));
  if (item.href === '/about-us/') return aboutPaths.some((p) => path.startsWith(p));
  return path.startsWith(item.href);
};
---

{announcement.enabled && (
<div class="announce" data-announce>
  <div class="container--wide announce__inner">
    <span class="announce__pulse" aria-hidden="true"></span>
    <Icon name="megaphone" size={16} />
    <p><strong>{announcement.label}</strong> {announcement.text}</p>
    <a href={l(announcement.href)} class="announce__link">{announcement.linkText} <Icon name="arrow-right" size={14} /></a>
    <button class="announce__close" data-announce-close aria-label={t('announce.dismiss')}><Icon name="x" size={16} /></button>
  </div>
</div>
)}

<div class="topbar">
  <div class="container--wide topbar__inner">
    <div class="topbar__info">
      <a href={`mailto:${site.email}`}><Icon name="mail" size={15} />{site.email}</a>
      <a href={site.phoneHref}><Icon name="phone" size={15} />{site.phone}</a>
      <span class="topbar__ifsc"><Icon name="landmark" size={15} />{t('footer.ifsc')}: <strong>{site.ifsc}</strong></span>
    </div>
    <div class="topbar__links">
      <a href={l('/contact-us/')}>{t('nav.contact')}</a>
      <a href={l('/careers/')}>{t('nav.careers')}</a>
      <a href={l('/blog/')}>{t('nav.blog')}</a>
      <span class="topbar__sep" aria-hidden="true"></span>
      {site.social.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="topbar__social"><Icon name={s.icon} size={15} /></a>
      ))}
    </div>
  </div>
</div>

<header class="header" data-header transition:name="site-header" transition:animate="none">
  <div class="container--wide header__inner">
    <a href={l('/')} class="brand" aria-label={t('brand.home')}>
      <img src="/images/brand/logo-full.png" alt={t('brand.logo')} width="854" height="253" class="brand__logo" />
    </a>

    <nav class="nav" aria-label={t('nav.main')}>
      <ul class="nav__list">
        {nav.map((item) => (
          <li class:list={['nav__item', { 'has-menu': item.children || item.mega, 'is-mega': item.mega, 'nav__item--home': item.href === '/' }]} data-nav-item>
            {item.children || item.mega ? (
              <button class:list={['nav__link', { 'is-active': isActive(item) }]} aria-expanded="false" data-nav-trigger>
                {item.label}
                <Icon name="chevron-down" size={15} class="nav__chev" />
              </button>
            ) : (
              <a href={l(item.href)} class:list={['nav__link', { 'is-active': isActive(item) }]} aria-current={isActive(item) ? 'page' : undefined}>
                {item.label}
              </a>
            )}

            {item.children && (
              <div class="dropdown dd">
                <ol class="dd__list">
                  {item.children.map((c, i) => (
                    <li>
                      <a href={l(c.href)} class="dd__link" data-prev={i}>
                        <span class="dd__n">{String(i + 1).padStart(2, '0')}</span>
                        <span class="dd__text">
                          <strong>{c.label}</strong>
                          {c.desc && <small>{c.desc}</small>}
                        </span>
                        <Icon name="arrow-right" size={14} />
                      </a>
                    </li>
                  ))}
                </ol>
                <!-- The page you point at, shown as a photo -->
                <div class="dd__prev" aria-hidden="true">
                  {item.children.map((c, i) => (
                    <figure class="dd__shot" data-i={i}>
                      <img src={previewFor(c.href)} alt="" width="600" height="760" loading="lazy" />
                      <figcaption><span>{String(i + 1).padStart(2, '0')}</span>{c.label}</figcaption>
                    </figure>
                  ))}
                </div>
              </div>
            )}

            {item.mega && (
              <div class="dropdown mega">
                <!-- Rate boards: name, a dotted leader, then the rate -->
                <div class="mega__col">
                  <a href={l('/deposits/')} class="mega__title"><span class="mega__no">01</span>{t('mega.depositsHead')}<small class="mega__unit">{t('mega.unitDeposit')}</small><Icon name="arrow-right" size={14} /></a>
                  <ul class="mega__board">
                    {schemes.map((s) => (
                      <li>
                        <a href={l(`/deposits/${s.slug}/`)}>
                          <span class="mega__name">{s.name}</span>
                          <i class="mega__dots" aria-hidden="true"></i>
                          <b>{s.rate ? `${fmtRate(s.rate)}%` : '2×'}</b>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="mega__col">
                  <a href={l('/loans/')} class="mega__title"><span class="mega__no">02</span>{t('mega.loansHead')}<small class="mega__unit">{t('mega.unitLoan')}</small><Icon name="arrow-right" size={14} /></a>
                  <ul class="mega__board">
                    {loans.map((ln) => (
                      <li>
                        <a href={l(`/loans/#${ln.slug}`)}>
                          <span class="mega__name">{ln.name}</span>
                          <i class="mega__dots" aria-hidden="true"></i>
                          <b>{fmtRate(ln.rateFrom)}%</b>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <div class="mega__more">
                    <a href={l('/interest-rates/')}>{t('nav.rates')}</a>
                    <a href={l('/calculators/')}>{t('nav.calculators')}</a>
                  </div>
                </div>

                <!-- A phone showing Lokmangal's own posts, played like stories -->
                <div class="mg-stage">
                  <div class="mg-phone" role="group" aria-label={t('mega.storyLabel')}>
                    <span class="mg-phone__btn mg-phone__btn--a" aria-hidden="true"></span>
                    <span class="mg-phone__btn mg-phone__btn--b" aria-hidden="true"></span>
                    <span class="mg-phone__btn mg-phone__btn--c" aria-hidden="true"></span>
                    <div class="mg-screen">
                      <span class="mg-island" aria-hidden="true"></span>
                      <div class="mg-status" aria-hidden="true">
                        <span>9:41</span>
                        <span class="mg-status__r"><i class="mg-signal"><b></b><b></b><b></b><b></b></i><i class="mg-battery"></i></span>
                      </div>
                      <div class="mg-bars" aria-hidden="true">
                        {stories.map((_, i) => <span><i class={`mg-anim mg-fill mg-fill--${i}`}></i></span>)}
                      </div>
                      <div class="mg-who" aria-hidden="true">
                        <img src="/images/brand/emblem.png" alt="" width="28" height="28" />
                        <span><b>{t('mega.handle')}</b><small>{t('mega.place')}</small></span>
                      </div>
                      {stories.map((st, i) => (
                        <div class={`mg-anim mg-story mg-story--${i}`}>
                          <img src={st.img} alt="" width="1200" height="751" loading="lazy" style={`object-position:${st.pos}`} />
                          <div class="mg-story__copy">
                            <span class="mg-story__tag">{st.tag}</span>
                            <p class="mg-story__rate">
                              {st.pre && lang !== 'mr' && <small class="mg-story__pre">{st.pre}</small>}
                              {fmtRate(st.rate!)}<span>%</span>
                              {st.pre && lang === 'mr' && <small class="mg-story__pre">{st.pre}</small>}
                            </p>
                            <p class="mg-story__pa">{t('mega.pa')}</p>
                            <p class="mg-story__note">{st.note}</p>
                            {st.ribbon && <p class="mg-story__ribbon">{st.ribbon}</p>}
                            <a href={st.href} class="mg-story__cta">{st.cta} <Icon name="arrow-right" size={15} /></a>
                          </div>
                        </div>
                      ))}
                      <span class="mg-home" aria-hidden="true"></span>
                    </div>
                  </div>
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <button class="search-trigger" data-search-open aria-label={t('search.site')} aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K">
        <Icon name="search" size={18} />
        <span class="search-trigger__label">{t('search')}</span>
        <kbd class="search-trigger__kbd">Ctrl K</kbd>
      </button>
      {hasMarathi('/') && <a href={switchHref} class="lang-switch" hreflang={otherLang} lang={otherLang} aria-label={t('lang.toLabel')} data-lang-switch={otherLang}>{t('lang.to')}</a>}
      <div class="nav__item has-menu login" data-nav-item>
        <button class="btn btn--ghost btn--sm login__btn" aria-expanded="false" data-nav-trigger>
          <Icon name="log-in" size={17} /> {t('login')}
        </button>
        <div class="dropdown dropdown--right">
          <ul class="dropdown__list">
            <li>
              <a href={site.appUrl} target="_blank" rel="noopener" class="dropdown__link">
                <span class="dropdown__icon"><Icon name="smartphone" size={18} /></span>
                <span><strong>{t('login.app')}</strong><small>{t('login.appSub')}</small></span>
              </a>
            </li>
            <li>
              <a href={l('/other-services/')} class="dropdown__link">
                <span class="dropdown__icon"><Icon name="globe" size={18} /></span>
                <span><strong>{t('login.net')}</strong><small>{t('login.netSub')}</small></span>
              </a>
            </li>
          </ul>
        </div>
      </div>
      <a href={l('/open-an-account/')} class="btn btn--primary btn--sm header__cta">{t('cta.openAccount')} <Icon name="arrow-right" size={16} class="icon--arrow" /></a>
      <button class="burger" aria-label={t('nav.menu')} aria-expanded="false" aria-controls="drawer" data-burger>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="drawer" data-drawer aria-hidden="true">
  <div class="drawer__panel">
    <div class="drawer__top">
      <img src="/images/brand/emblem.png" alt="" width="42" height="51" class="drawer__emblem" />
      <span class="drawer__title">{lang === 'mr' ? 'लोकमंगल' : 'Lokmangal'}<small>{lang === 'mr' ? 'मल्टीस्टेट' : 'Multistate'}</small></span>
      <button class="drawer__close" data-drawer-close aria-label={t('nav.menuClose')}><Icon name="x" size={22} /></button>
    </div>
    <button class="drawer__search" data-search-open aria-haspopup="dialog">
      <Icon name="search" size={18} /> {t('search.drawer')}
    </button>
    <nav aria-label={t('nav.mobile')}>
      <ul class="drawer__list">
        <li style="--i:0"><a href={l('/')} class="drawer__link">{t('home')}</a></li>
        <li style="--i:1">
          <details class="drawer__group">
            <summary class="drawer__link">{t('nav.about')} <Icon name="chevron-down" size={20} /></summary>
            <div class="drawer__sub">
              {nav[1].children!.map((c) => <a href={l(c.href)}>{c.label}</a>)}
            </div>
          </details>
        </li>
        <li style="--i:2">
          <details class="drawer__group">
            <summary class="drawer__link">{t('nav.deposits')} <Icon name="chevron-down" size={20} /></summary>
            <div class="drawer__sub">
              <a href={l('/deposits/')}><strong>{t('nav.allDeposits')}</strong></a>
              {schemes.map((s) => <a href={l(`/deposits/${s.slug}/`)}>{s.name}</a>)}
              <a href={l('/interest-rates/')}>{t('nav.rates')}</a>
            </div>
          </details>
        </li>
        <li style="--i:3">
          <details class="drawer__group">
            <summary class="drawer__link">{t('nav.loans')} <Icon name="chevron-down" size={20} /></summary>
            <div class="drawer__sub">
              <a href={l('/loans/')}><strong>{t('nav.allLoans')}</strong></a>
              {loans.map((ln) => <a href={l(`/loans/#${ln.slug}`)}>{ln.name}</a>)}
              <a href={l('/apply-loan/')}>{t('nav.applyLoan')}</a>
            </div>
          </details>
        </li>
        <li style="--i:4"><a href={l('/other-services/')} class="drawer__link">{t('nav.services')}</a></li>
        <li style="--i:5"><a href={l('/rural-wealth-manager/')} class="drawer__link">{t('nav.rwm')}</a></li>
        <li style="--i:6"><a href={l('/calculators/')} class="drawer__link">{t('nav.calculators')}</a></li>
        <li style="--i:7"><a href={l('/faq/')} class="drawer__link">{t('nav.faq')}</a></li>
        <li style="--i:8"><a href={l('/branches/')} class="drawer__link">{t('nav.branches')}</a></li>
        <li style="--i:9"><a href={l('/contact-us/')} class="drawer__link">{t('nav.contact')}</a></li>
      </ul>
    </nav>
    <div class="drawer__foot">
      <a href={l('/open-an-account/')} class="btn btn--primary btn--block">{t('cta.openAnAccount')} <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
      <a href={site.appUrl} target="_blank" rel="noopener" class="btn btn--outline-light btn--block"><Icon name="smartphone" size={18} /> {t('login.app')}</a>
      <div class="drawer__contact">
        <a href={site.phoneHref}><Icon name="phone" size={16} /> {site.phone}</a>
        <a href={`mailto:${site.email}`}><Icon name="mail" size={16} /> {site.email}</a>
      </div>
    </div>
  </div>
</div>

<style>
  /* Language switch */
  .lang-switch {
    display: inline-flex; align-items: center; justify-content: center; min-height: 42px; padding: 0 14px;
    border-radius: 10px; border: 1px solid var(--line); background: var(--surface);
    font-weight: 600; font-size: 0.92rem; line-height: 1; color: var(--g-800); white-space: nowrap;
    transition: border-color var(--dur-s), background var(--dur-s), color var(--dur-s);
  }
  .lang-switch:hover { border-color: var(--g-600); background: var(--g-50); color: var(--g-900); }
  @media (max-width: 420px) { .lang-switch { min-height: 40px; padding: 0 10px; font-size: 0.88rem; } }

  /* Announcement */
  .announce {
    background: linear-gradient(90deg, var(--o-strong-hover), var(--o-strong) 55%, #b84c0c);
    color: #fff;
    font-size: 0.86rem;
  }
  .announce.is-hidden { display: none; }
  .announce__inner { display: flex; align-items: center; gap: 10px; min-height: 40px; padding-block: 6px; }
  .announce__inner p { flex: 1; min-width: 0; line-height: 1.4; }
  .announce__pulse {
    width: 8px; height: 8px; border-radius: 50%; background: #fff; flex: none;
    box-shadow: 0 0 0 0 rgb(255 255 255 / 0.7);
   
  }
  @keyframes pulse { 70% { box-shadow: 0 0 0 10px rgb(255 255 255 / 0); } 100% { box-shadow: 0 0 0 0 rgb(255 255 255 / 0); } }
  .announce__link { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; white-space: nowrap; border-bottom: 1px solid rgb(255 255 255 / 0.5); }
  .announce__link:hover { border-color: #fff; }
  .announce__close { color: #fff; opacity: 0.8; padding: 6px; border-radius: 50%; display: grid; }
  .announce__close:hover { opacity: 1; background: rgb(255 255 255 / 0.15); }
  @media (max-width: 720px) { .announce__inner p { font-size: 0.8rem; } .announce__inner > :global(.icon) { display: none; } }

  /* Top bar */
  .topbar { background: var(--g-950); color: rgb(255 255 255 / 0.72); font-size: 0.84rem; }
  .topbar__inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 42px; }
  .topbar a, .topbar__ifsc { display: inline-flex; align-items: center; gap: 7px; transition: color 0.2s; }
  .topbar a:hover { color: #fff; }
  .topbar__info, .topbar__links { display: flex; align-items: center; gap: 22px; }
  .topbar__ifsc strong { color: var(--o-300); font-weight: 700; letter-spacing: 0.04em; }
  .topbar__sep { width: 1px; height: 16px; background: rgb(255 255 255 / 0.2); }
  .topbar__social { width: 28px; height: 28px; justify-content: center; border-radius: 50%; }
  .topbar__social:hover { background: rgb(255 255 255 / 0.12); }
  .topbar__links { gap: 16px; }
  @media (max-width: 1100px) { .topbar__links > a:not(.topbar__social), .topbar__sep { display: none; } }
  @media (max-width: 760px) { .topbar { display: none; } }

  /* Header */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.86);
    backdrop-filter: saturate(1.6) blur(16px);
    -webkit-backdrop-filter: saturate(1.6) blur(16px);
    border-bottom: 1px solid rgb(228 223 212 / 0.7);
    transition: transform 0.45s var(--ease-out), box-shadow 0.35s, background 0.3s;
  }
  .header.is-scrolled { box-shadow: 0 10px 30px -18px rgb(5 42 26 / 0.35); background: rgb(255 255 255 / 0.94); }
  .header.is-hidden { transform: translateY(-100%); }
  .header__inner { display: flex; align-items: center; gap: 24px; height: var(--header-h); transition: height 0.35s var(--ease-out); }
  .header.is-scrolled .header__inner { height: 72px; }
  .brand { flex: none; display: block; }
  .brand__logo { width: auto; height: 50px; transition: height 0.35s var(--ease-out), transform 0.4s var(--ease-spring); }
  .brand:hover .brand__logo { transform: scale(1.03); }
  .header.is-scrolled .brand__logo { height: 44px; }

  .nav { margin-inline: auto; }
  .nav__list { list-style: none; display: flex; align-items: center; gap: 2px; }
  .nav__item { position: relative; }
  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 10px 13px;
    border-radius: 999px;
    font-weight: 650;
    font-size: 0.93rem;
    color: var(--ink-2);
    white-space: nowrap;
    transition: color 0.2s, background 0.2s;
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 3px;
    width: 18px;
    height: 3px;
    border-radius: 3px;
    background: var(--o-500);
    transform: translateX(-50%) scaleX(0);
    transition: transform 0.35s var(--ease-out);
  }
  .nav__link:hover, .nav__item.is-open > .nav__link { color: var(--g-700); background: var(--g-50); }
  .nav__link.is-active { color: var(--g-700); }
  .nav__link.is-active::after { transform: translateX(-50%) scaleX(1); }
  .nav__chev { transition: transform 0.3s var(--ease-out); }
  .nav__item.is-open .nav__chev { transform: rotate(180deg); }

  .dropdown {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    min-width: 300px;
    padding: 10px;
    background: #fff;
    border-radius: 20px;
    border: 1px solid var(--line-2);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 8px) scale(0.98);
    transform-origin: top center;
    /* closing (exit) is quicker than opening */
    transition: opacity var(--dur-m-exit) var(--ease-in), transform var(--dur-m-exit) var(--ease-in), visibility var(--dur-m-exit);
  }
  .nav__item.is-open > .dropdown,
  .nav__item.has-menu:hover > .dropdown {
    transition: opacity var(--dur-m) var(--ease-out), transform var(--dur-m) var(--ease-out), visibility var(--dur-m);
  }
  .dropdown::before { content: ''; position: absolute; inset: -14px 0 auto; height: 14px; }
  .dropdown--right { left: auto; right: 0; transform: translate(0, 10px) scale(0.98); transform-origin: top right; }
  .nav__item.is-open > .dropdown { opacity: 1; visibility: visible; transform: translate(-50%, 0) scale(1); }
  .nav__item.is-open > .dropdown--right { transform: translate(0, 0) scale(1); }
  @media (hover: hover) and (min-width: 1281px) {
    .nav__item.has-menu:hover > .dropdown { opacity: 1; visibility: visible; transform: translate(-50%, 0) scale(1); }
    .nav__item.has-menu:hover > .dropdown--right { transform: translate(0, 0) scale(1); }
    .nav__item.has-menu:hover > .nav__link .nav__chev { transform: rotate(180deg); }
  }
  .dropdown__list { list-style: none; display: grid; gap: 2px; }
