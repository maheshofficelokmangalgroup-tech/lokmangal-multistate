---
// The shared layout of the application pages: photo banner, the form beside what happens next and a checklist
// of documents that remembers its ticks on this device.
import Icon from './Icon.astro';
import { siteData } from '../data/site';
import { getLang, localePath } from '../i18n';
import { pageCopy, useT } from '../i18n/ui';

interface Props {
  banner: string;
  eyebrow: string;
  title: string;
  accent: string;
  lead: string;
  crumbs: { label: string; href?: string }[];
  stepsTitle: string;
  steps: { title: string; text: string }[];
  docsTitle: string;
  docs: string[];
  /** Keeps each page's ticks separate on the device. */
  docsKey: string;
}
const { banner, eyebrow, title, accent, lead, crumbs, stepsTitle, steps, docsTitle, docs, docsKey } = Astro.props;
const lang = getLang(Astro);
const t = useT(lang);
const l = (p: string) => localePath(p, lang);
const { site } = siteData(lang);
const c = pageCopy(
  lang,
  'apply-desk',
  {
    apply: 'Fill in the form',
    call: 'Call {phone}',
    hint: 'Tick what you already have.',
    count: '{n} of {total} ready',
    done: 'All set for your branch visit',
    talk: 'Prefer to talk?',
    branches: 'Find your nearest branch',
  },
  {
    apply: 'फॉर्म भरा',
    call: '{phone} वर कॉल करा',
    hint: 'तुमच्याकडे असलेल्यांवर खूण करा.',
    count: '{total} पैकी {n} तयार',
    done: 'शाखेत जाण्याची पूर्ण तयारी झाली',
    talk: 'फोनवर बोलायचे आहे?',
    branches: 'जवळची शाखा शोधा',
  },
);
const total = String(docs.length);
---

<section class="ad-hero">
  <img src={banner} alt="" class="ad-hero__img" width="1672" height="941" fetchpriority="high" />
  <div class="container ad-hero__inner">
    <nav class="ad-crumbs" aria-label={t('breadcrumb')}>
      <a href={l('/')}>{t('home')}</a>
      {crumbs.map((cr) => (
        <>
          <Icon name="chevron-right" size={14} />
          {cr.href ? <a href={cr.href}>{cr.label}</a> : <span aria-current="page">{cr.label}</span>}
        </>
      ))}
    </nav>
    <div class="ad-hero__copy">
      <p class="ad-hero__eyebrow">{eyebrow}</p>
      <h1 class="h1 ad-hero__title" data-reveal>{title} <em>{accent}</em></h1>
      <p class="lead ad-hero__lead" data-reveal style="--d:120ms">{lead}</p>
      <div class="btn-row" data-reveal style="--d:200ms">
        <a href="#apply" class="btn btn--primary btn--lg">{c('apply')} <Icon name="arrow-down" size={18} /></a>
        <a href={site.phoneHref} class="btn btn--light btn--lg">{c('call', { phone: site.phone })}</a>
      </div>
    </div>
  </div>
</section>

<section class="section ad-sec" id="apply">
  <div class="container ad-grid">
    <div data-reveal="left"><slot /></div>
    <aside class="ad-side">
      <div class="ad-next" data-reveal="right">
        <p class="ad-side__title">{stepsTitle}</p>
        <ol>
          {steps.map((s, i) => (
            <li>
              <span class="ad-next__n">{i + 1}</span>
              <div><h2>{s.title}</h2><p>{s.text}</p></div>
            </li>
          ))}
        </ol>
      </div>
      <div class="ad-docs" data-reveal="right" style="--d:120ms" data-docs={docsKey}>
        <p class="ad-side__title">{docsTitle}</p>
        <p class="ad-docs__hint">{c('hint')}</p>
        <ul>
          {docs.map((d, i) => (
            <li><label><input type="checkbox" data-doc={i} /><span class="ad-docs__box" aria-hidden="true"></span><span>{d}</span></label></li>
          ))}
        </ul>
        <div class="ad-docs__meter" aria-hidden="true"><span data-docs-bar></span></div>
        <p class="ad-docs__count" aria-live="polite" data-docs-count data-tpl={c('count')} data-done={c('done')}>{c('count', { n: '0', total })}</p>
      </div>
      <a href={site.phoneHref} class="ad-call" data-reveal="right" style="--d:200ms">
        <span><small>{c('talk')}</small><strong>{site.phone}</strong></span>
        <Icon name="arrow-up-right" size={20} />
      </a>
      <a href={l('/branches/')} class="link-arrow ad-branch">{c('branches')} <Icon name="arrow-right" size={16} /></a>
    </aside>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const box = document.querySelector<HTMLElement>('[data-docs]');
    if (!box) return;
    const checks = Array.from(box.querySelectorAll<HTMLInputElement>('[data-doc]'));
    const bar = box.querySelector<HTMLElement>('[data-docs-bar]');
    const count = box.querySelector<HTMLElement>('[data-docs-count]');
    const key = `lm-docs-${box.dataset.docs}`;
    let saved: number[] = [];
    try { saved = JSON.parse(localStorage.getItem(key) ?? '[]'); } catch { /* ignore */ }
    checks.forEach((c, i) => (c.checked = saved.includes(i)));
    const update = () => {
      const n = checks.filter((c) => c.checked).length;
      const total = checks.length;
      if (bar) bar.style.width = `${(n / total) * 100}%`;
      if (count) count.textContent = n === total ? (count.dataset.done ?? '') : (count.dataset.tpl ?? '').replace('{n}', String(n)).replace('{total}', String(total));
      box.classList.toggle('is-done', n === total);
      try { localStorage.setItem(key, JSON.stringify(checks.flatMap((c, i) => (c.checked ? [i] : [])))); } catch { /* ignore */ }
    };
    checks.forEach((c) => c.addEventListener('change', update));
    update();
  });
</script>

<style>
  .ad-hero { position: relative; isolation: isolate; overflow: hidden; display: flex; min-height: clamp(480px, 62vh, 580px); color: #fff; background: var(--g-950); }
  .ad-hero__img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 75% 35%; animation: ad-settle 14s cubic-bezier(0.16, 1, 0.3, 1) both; }
  @keyframes ad-settle { from { transform: scale(1.12); } }
  .ad-hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(5 42 26 / 0.96) 0%, rgb(5 42 26 / 0.86) 36%, rgb(5 42 26 / 0.36) 60%, rgb(5 42 26 / 0.06) 84%, transparent 100%), linear-gradient(0deg, rgb(5 42 26 / 0.5), transparent 30%); }
  .ad-hero__inner { display: flex; flex-direction: column; padding-block: clamp(36px, 5vw, 60px) clamp(44px, 6vw, 72px); }
  .ad-crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 0.86rem; font-weight: 600; color: rgb(255 255 255 / 0.65); }
  .ad-crumbs a { color: rgb(255 255 255 / 0.85); }
  .ad-crumbs span { color: var(--gold); }
  .ad-hero__copy { margin-block: auto; padding-top: clamp(20px, 3vw, 32px); max-width: 620px; min-width: 0; display: grid; gap: 18px; }
  .ad-hero__eyebrow { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--g-300); }
  :global(html[lang='mr']) .ad-hero__eyebrow { letter-spacing: 0; text-transform: none; font-size: 0.95rem; }
  .ad-hero__title { color: #fff; }
  .ad-hero__title em { display: block; color: var(--gold); }
  .ad-hero__lead { color: rgb(255 255 255 / 0.88); }
  @media (max-width: 899px) {
    .ad-hero { min-height: 0; }
    .ad-hero__img { inset: 0 0 auto 0; height: min(62vw, 300px); }
    .ad-hero::after { background: linear-gradient(180deg, rgb(5 42 26 / 0.35) 0, rgb(5 42 26 / 0.1) 80px, var(--g-950) min(62vw, 300px)); }
    .ad-hero__copy { padding-top: calc(min(62vw, 300px) - 70px); }
  }

  .ad-sec { background: var(--surface); scroll-margin-top: calc(var(--header-h) + 8px); }
  .ad-grid { display: grid; gap: clamp(28px, 4vw, 52px); align-items: start; }
  @media (min-width: 1020px) { .ad-grid { grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); } .ad-side { position: sticky; top: calc(var(--header-h) + 20px); } }
  .ad-side { display: grid; gap: 18px; }
  .ad-side__title { font-size: 0.8rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--g-900); }
  :global(html[lang='mr']) .ad-side__title { letter-spacing: 0; text-transform: none; font-size: 1rem; }
  .ad-next { padding: 22px 24px; border-radius: var(--r-lg); background: var(--bg); border: 1px solid var(--line-2); }
  .ad-next ol { list-style: none; margin: 14px 0 0; padding: 0; position: relative; display: grid; gap: 16px; }
  .ad-next ol::before { content: ''; position: absolute; left: 14px; top: 8px; bottom: 8px; width: 2px; background: repeating-linear-gradient(180deg, var(--o-300) 0 6px, transparent 6px 11px); }
  .ad-next li { position: relative; display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 12px; }
  .ad-next__n { position: relative; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--o-strong); color: #fff; font-weight: 800; font-size: 0.9rem; box-shadow: 0 0 0 4px var(--bg); }
  .ad-next h2 { font-size: 0.98rem; line-height: 1.3; color: var(--g-900); }
  .ad-next p { margin-top: 2px; font-size: 0.88rem; color: var(--muted); }
  .ad-docs { padding: 22px 24px; border-radius: var(--r-lg); background: #fff; border-top: 4px solid var(--gold); box-shadow: var(--shadow); }
  .ad-docs__hint { margin-top: 4px; font-size: 0.86rem; color: var(--muted); }
  .ad-docs ul { list-style: none; margin: 12px 0 0; padding: 0; }
  .ad-docs label { position: relative; display: flex; align-items: flex-start; gap: 12px; padding: 9px 0; border-bottom: 1px dashed var(--line); cursor: pointer; font-weight: 600; font-size: 0.93rem; color: var(--ink-2); }
  .ad-docs input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .ad-docs__box { flex: none; position: relative; width: 20px; height: 20px; margin-top: 1px; border-radius: 5px; border: 2px solid var(--muted-2); background: #fff; transition: background 0.2s, border-color 0.2s; }
  .ad-docs__box::after { content: ''; position: absolute; left: 5px; top: 1px; width: 5px; height: 10px; border: solid transparent; border-width: 0 2.5px 2.5px 0; rotate: 45deg; }
  .ad-docs input:checked + .ad-docs__box { background: var(--g-700); border-color: var(--g-700); }
  .ad-docs input:checked + .ad-docs__box::after { border-color: #fff; }
  .ad-docs input:checked ~ span:last-child { color: var(--muted); text-decoration: line-through; text-decoration-color: var(--g-300); }
  .ad-docs input:focus-visible + .ad-docs__box { outline: 2px solid var(--o-500); outline-offset: 2px; }
  .ad-docs__meter { margin-top: 14px; height: 6px; border-radius: 6px; background: var(--line-2); overflow: hidden; }
  .ad-docs__meter span { display: block; width: 0; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--o-500), var(--gold)); transition: width 0.5s var(--ease-out); }
  .ad-docs.is-done .ad-docs__meter span { background: var(--g-600); }
  .ad-docs__count { margin-top: 8px; font-size: 0.84rem; font-weight: 700; color: var(--g-800); }
  .ad-call { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 18px 20px; border-radius: var(--r-lg); background: var(--g-800); color: #fff; transition: transform 0.4s var(--ease-out), box-shadow 0.4s; }
  .ad-call small { display: block; font-weight: 600; opacity: 0.85; }
  .ad-call strong { font-size: 1.2rem; }
  .ad-call:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .ad-branch { justify-self: start; }
  @media (prefers-reduced-motion: reduce) { .ad-hero__img { animation: none; } }
</style>
