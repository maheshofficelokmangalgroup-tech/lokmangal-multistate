---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  steps: { title: string; text: string }[];
  docs: string[];
  docsTitle?: string;
}
const { steps, docs, docsTitle = 'Keep these documents handy' } = Astro.props;
---

<section class="section">
  <div class="container apply">
    <div class="apply__form" data-reveal="left"><slot /></div>
    <aside class="apply__side">
      <div class="steps" data-reveal="right">
        <p class="eyebrow">How it works</p>
        <ol>
          {steps.map((s, i) => (
            <li style={`--i:${i}`}>
              <span class="steps__n">{i + 1}</span>
              <div><h3>{s.title}</h3><p>{s.text}</p></div>
            </li>
          ))}
        </ol>
      </div>
      <div class="card" data-reveal="right" style="--d:120ms">
        <span class="icon-badge icon-badge--orange"><Icon name="file-text" size={22} /></span>
        <h3 class="h4 mt-2">{docsTitle}</h3>
        <ul class="check-list mt-3">{docs.map((d) => <li>{d}</li>)}</ul>
      </div>
      <a href={site.phoneHref} class="help" data-reveal="right" style="--d:200ms">
        <span class="icon-badge icon-badge--dark"><Icon name="phone" size={22} /></span>
        <div><small>Prefer to talk?</small><strong>{site.phone}</strong></div>
        <Icon name="arrow-up-right" size={20} class="help__go" />
      </a>
    </aside>
  </div>
</section>

<style>
  .apply { display: grid; gap: clamp(32px, 4vw, 56px); align-items: start; }
  @media (min-width: 1020px) { .apply { grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); } .apply__side { position: sticky; top: calc(var(--header-h) + 20px); } }
  .apply__side { display: grid; gap: 20px; }
  .steps { padding: 28px; border-radius: var(--r-xl); color: rgb(255 255 255 / 0.75); background: radial-gradient(90% 80% at 100% 0%, rgb(236 106 30 / 0.35), transparent 60%), linear-gradient(150deg, var(--g-800), var(--g-950)); }
  .steps .eyebrow { color: var(--g-300); }
  .steps ol { list-style: none; margin-top: 18px; display: grid; gap: 18px; position: relative; }
  .steps ol::before { content: ''; position: absolute; left: 17px; top: 10px; bottom: 10px; width: 2px; background: rgb(255 255 255 / 0.12); }
  .steps li { position: relative; display: flex; gap: 16px; }
  .steps__n { position: relative; z-index: 1; display: grid; place-items: center; flex: none; width: 36px; height: 36px; border-radius: 50%; background: var(--o-strong); color: #fff; font-weight: 800; box-shadow: 0 0 0 5px rgb(236 106 30 / 0.2); }
  .steps h3 { color: #fff; font-size: 1rem; }
  .steps p { font-size: 0.9rem; margin-top: 2px; }
  .help { display: flex; align-items: center; gap: 14px; padding: 18px 20px; border-radius: var(--r-lg); background: var(--o-strong); color: #fff; transition: transform 0.4s var(--ease-out), box-shadow 0.4s; }
  .help .icon-badge { background: rgb(255 255 255 / 0.18); color: #fff; }
  .help small { display: block; font-weight: 600; }
  .help strong { font-size: 1.15rem; }
  .help :global(.help__go) { margin-left: auto; transition: transform 0.3s; }
  .help:hover { transform: translateY(-4px); box-shadow: var(--shadow-o); }
  .help:hover :global(.help__go) { transform: translate(3px, -3px); }
</style>
