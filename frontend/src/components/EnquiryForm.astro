---
import Icon from './Icon.astro';
import { jobOpenings, site, siteData } from '../data/site';
import { depositsData } from '../data/deposits';
import { loansData } from '../data/loans';
import { getLang } from '../i18n';
import { pageCopy } from '../i18n/ui';

type Variant = 'account' | 'deposit' | 'loan' | 'contact' | 'callback' | 'service' | 'career';
interface Props {
  variant: Variant;
  title?: string;
  subtitle?: string;
  submitLabel?: string;
  preset?: string;
  dark?: boolean;
}
const lang = getLang(Astro);
// Labels follow the page's language; the values sent to the office (scheme, loan and account names) stay English.
const f = pageCopy(
  lang,
  'enquiry-form',
  {
    submit: 'Submit', firstName: 'First name', middleName: 'Middle name', lastName: 'Last name', contactNumber: 'Contact number',
    email: 'Email', city: 'City', accountType: 'Account type you would like to open', depositType: 'Which deposit would you like to open?',
    message: 'Message', fullName: 'Full name', residentCity: 'Resident city', loanType: 'Loan type', chooseLoan: 'Choose loan type',
    loanAmount: 'Required loan amount (₹)', phone: 'Phone number', location: 'Location', help: 'How can we help?', yourLocation: 'Your location',
    position: 'Position', other: 'Other', experience: 'Experience (years)', currentCity: 'Current city', about: 'Tell us about yourself',
    resume: 'Please also email your résumé to', consent: 'I agree to be contacted by Lokmangal Multistate about my enquiry.',
    thanks: 'Thank you!', received: 'We have received your details. Our team will get in touch with you shortly.',
    refBefore: 'Your reference number is', refAfter: 'Please keep it for your records.', callNow: 'Need help right away? Call {phone}',
    savings: 'Savings Account', current: 'Current Account', rd: 'Recurring Deposit',
  },
  {
    submit: 'पाठवा', firstName: 'पहिले नाव', middleName: 'मधले नाव', lastName: 'आडनाव', contactNumber: 'संपर्क क्रमांक',
    email: 'ईमेल', city: 'शहर / गाव', accountType: 'कोणते खाते उघडायचे आहे?', depositType: 'कोणती ठेव उघडायची आहे?',
    message: 'संदेश', fullName: 'पूर्ण नाव', residentCity: 'राहण्याचे शहर / गाव', loanType: 'कर्जाचा प्रकार', chooseLoan: 'कर्जाचा प्रकार निवडा',
    loanAmount: 'हवी असलेली कर्ज रक्कम (₹)', phone: 'फोन क्रमांक', location: 'ठिकाण', help: 'आम्ही कशी मदत करू?', yourLocation: 'तुमचे ठिकाण',
    position: 'पद', other: 'इतर', experience: 'अनुभव (वर्षे)', currentCity: 'सध्याचे शहर', about: 'तुमच्याबद्दल सांगा',
    resume: 'कृपया तुमचा बायोडेटा या पत्त्यावरही ईमेल करा:', consent: 'माझ्या चौकशीबाबत लोकमंगल मल्टीस्टेटने माझ्याशी संपर्क साधण्यास माझी संमती आहे.',
    thanks: 'धन्यवाद!', received: 'तुमची माहिती आम्हाला मिळाली आहे. आमची टीम लवकरच तुमच्याशी संपर्क साधेल.',
    refBefore: 'तुमचा संदर्भ क्रमांक', refAfter: 'कृपया तो जपून ठेवा.', callNow: 'लगेच मदत हवी आहे? {phone} वर कॉल करा',
    savings: 'बचत खाते', current: 'चालू खाते', rd: 'रिकरिंग ठेव',
  },
);
const { variant, title, subtitle, submitLabel = f('submit'), preset, dark = false } = Astro.props;
const id = `f-${variant}-${Math.random().toString(36).slice(2, 7)}`;
// Option labels in the page's language; the values the office receives stay English.
const depositOptions = depositsData(lang).schemes.map((s) => ({ value: depositsData('en').schemeBySlug(s.slug)?.name ?? s.name, label: s.name }));
const loanOptions = loansData(lang).loanFormOptions;
const jobOptions = siteData(lang).jobOpenings.map((j, i) => ({ value: jobOpenings[i]?.title ?? j.title, label: j.title }));
---

<div class:list={['form-card', { 'form-card--dark': dark }]} data-form-card>
  {title && (
    <div class="form-card__head">
      <h2 class="h3">{title}</h2>
      {subtitle && <p class="muted">{subtitle}</p>}
    </div>
  )}

  <form class="form" action={site.formEndpoint || undefined} method="post" data-enquiry novalidate={false}>
    <input type="hidden" name="form" value={variant} />
    <input type="hidden" name="page" value={Astro.url.pathname} />
    <input type="hidden" name="ts" value="" data-ts />
    <input type="hidden" name="consent_version" value={variant === 'career' ? '2026-10-application' : '2026-10-enquiry'} />
    <div class="hp" aria-hidden="true">
      <label for={`${id}-website`}>Website</label>
      <input type="text" id={`${id}-website`} name="website" tabindex="-1" autocomplete="off" />
    </div>

    {(variant === 'account' || variant === 'deposit') && (
      <>
        <div class="form-grid">
          <div class="field"><label for={`${id}-fn`}>{f('firstName')} <span class="req">*</span></label><input id={`${id}-fn`} name="first_name" required autocomplete="given-name" /></div>
          <div class="field"><label for={`${id}-mn`}>{f('middleName')}</label><input id={`${id}-mn`} name="middle_name" autocomplete="additional-name" /></div>
          <div class="field"><label for={`${id}-ln`}>{f('lastName')} <span class="req">*</span></label><input id={`${id}-ln`} name="last_name" required autocomplete="family-name" /></div>
        </div>
        <div class="form-grid">
          <div class="field"><label for={`${id}-ph`}>{f('contactNumber')} <span class="req">*</span></label><input id={`${id}-ph`} name="phone" type="tel" inputmode="tel" pattern="[0-9+\\s-]{10,15}" required autocomplete="tel" /></div>
          <div class="field"><label for={`${id}-em`}>{f('email')} <span class="req">*</span></label><input id={`${id}-em`} name="email" type="email" required autocomplete="email" /></div>
          <div class="field"><label for={`${id}-ct`}>{f('city')} <span class="req">*</span></label><input id={`${id}-ct`} name="city" required autocomplete="address-level2" /></div>
        </div>
        {variant === 'account' ? (
          <div class="field">
            <label for={`${id}-type`}>{f('accountType')} <span class="req">*</span></label>
            <select id={`${id}-type`} name="account_type" required>
              {([['Savings Account', f('savings')], ['Current Account', f('current')], ['Recurring Deposit', f('rd')]] as const).map(([value, label]) => <option value={value} selected={value === preset}>{label}</option>)}
            </select>
          </div>
        ) : (
          <div class="field">
            <label for={`${id}-type`}>{f('depositType')} <span class="req">*</span></label>
            <select id={`${id}-type`} name="deposit_type" required>
              {depositOptions.map((o) => <option value={o.value} selected={o.value === preset}>{o.label}</option>)}
            </select>
          </div>
        )}
        <div class="field"><label for={`${id}-msg`}>{f('message')}</label><textarea id={`${id}-msg`} name="message" rows="4"></textarea></div>
      </>
    )}

    {variant === 'loan' && (
      <>
        <div class="form-grid">
          <div class="field"><label for={`${id}-nm`}>{f('fullName')} <span class="req">*</span></label><input id={`${id}-nm`} name="name" required autocomplete="name" /></div>
          <div class="field"><label for={`${id}-ph`}>{f('contactNumber')} <span class="req">*</span></label><input id={`${id}-ph`} name="phone" type="tel" inputmode="tel" pattern="[0-9+\\s-]{10,15}" required autocomplete="tel" /></div>
        </div>
        <div class="form-grid">
          <div class="field"><label for={`${id}-em`}>{f('email')} <span class="req">*</span></label><input id={`${id}-em`} name="email" type="email" required autocomplete="email" /></div>
          <div class="field"><label for={`${id}-ct`}>{f('residentCity')} <span class="req">*</span></label><input id={`${id}-ct`} name="city" required autocomplete="address-level2" /></div>
        </div>
        <div class="form-grid">
          <div class="field">
            <label for={`${id}-type`}>{f('loanType')} <span class="req">*</span></label>
            <select id={`${id}-type`} name="loan_type" required data-loan-select>
              <option value="">{f('chooseLoan')}</option>
              {loanOptions.map((o) => <option value={o.value} selected={o.value === preset}>{o.label}</option>)}
            </select>
          </div>
          <div class="field"><label for={`${id}-amt`}>{f('loanAmount')} <span class="req">*</span></label><input id={`${id}-amt`} name="amount" type="number" min="1000" step="1" inputmode="numeric" required /></div>
        </div>
        <div class="field"><label for={`${id}-msg`}>{f('message')}</label><textarea id={`${id}-msg`} name="message" rows="4"></textarea></div>
      </>
    )}

    {(variant === 'contact' || variant === 'service') && (
      <>
        <div class="form-grid">
          <div class="field"><label for={`${id}-nm`}>{f('fullName')} <span class="req">*</span></label><input id={`${id}-nm`} name="name" required autocomplete="name" /></div>
          <div class="field"><label for={`${id}-ph`}>{f('phone')} <span class="req">*</span></label><input id={`${id}-ph`} name="phone" type="tel" inputmode="tel" pattern="[0-9+\\s-]{10,15}" required autocomplete="tel" /></div>
        </div>
        <div class="form-grid">
          <div class="field"><label for={`${id}-em`}>{f('email')} <span class="req">*</span></label><input id={`${id}-em`} name="email" type="email" required autocomplete="email" /></div>
          {variant === 'service' && <div class="field"><label for={`${id}-loc`}>{f('location')} <span class="req">*</span></label><input id={`${id}-loc`} name="city" required autocomplete="address-level2" /></div>}
        </div>
        <div class="field"><label for={`${id}-msg`}>{f('help')} {variant === 'contact' && <span class="req">*</span>}</label><textarea id={`${id}-msg`} name="message" rows="5" required={variant === 'contact'}></textarea></div>
      </>
    )}

    {variant === 'callback' && (
      <>
        <div class="field"><label for={`${id}-nm`}>{f('fullName')} <span class="req">*</span></label><input id={`${id}-nm`} name="name" required autocomplete="name" /></div>
        <div class="field"><label for={`${id}-ph`}>{f('contactNumber')} <span class="req">*</span></label><input id={`${id}-ph`} name="phone" type="tel" inputmode="tel" pattern="[0-9+\\s-]{10,15}" required autocomplete="tel" /></div>
        <div class="field"><label for={`${id}-em`}>{f('email')} <span class="req">*</span></label><input id={`${id}-em`} name="email" type="email" required autocomplete="email" /></div>
        <div class="field"><label for={`${id}-loc`}>{f('yourLocation')} <span class="req">*</span></label><input id={`${id}-loc`} name="city" required autocomplete="address-level2" /></div>
        {preset && <input type="hidden" name="interest" value={preset} />}
      </>
    )}

    {variant === 'career' && (
      <>
        <div class="form-grid">
          <div class="field"><label for={`${id}-nm`}>{f('fullName')} <span class="req">*</span></label><input id={`${id}-nm`} name="name" required autocomplete="name" /></div>
          <div class="field"><label for={`${id}-ph`}>{f('phone')} <span class="req">*</span></label><input id={`${id}-ph`} name="phone" type="tel" inputmode="tel" pattern="[0-9+\\s-]{10,15}" required autocomplete="tel" /></div>
        </div>
        <div class="form-grid">
          <div class="field"><label for={`${id}-em`}>{f('email')} <span class="req">*</span></label><input id={`${id}-em`} name="email" type="email" required autocomplete="email" /></div>
          <div class="field">
            <label for={`${id}-pos`}>{f('position')} <span class="req">*</span></label>
            <select id={`${id}-pos`} name="position" required>
              {jobOptions.map((j) => <option value={j.value}>{j.label}</option>)}
              <option value="Other">{f('other')}</option>
            </select>
          </div>
        </div>
        <div class="form-grid">
          <div class="field"><label for={`${id}-exp`}>{f('experience')}</label><input id={`${id}-exp`} name="experience" type="number" min="0" max="50" inputmode="numeric" /></div>
          <div class="field"><label for={`${id}-ct`}>{f('currentCity')} <span class="req">*</span></label><input id={`${id}-ct`} name="city" required autocomplete="address-level2" /></div>
        </div>
        <div class="field"><label for={`${id}-msg`}>{f('about')}</label><textarea id={`${id}-msg`} name="message" rows="4"></textarea></div>
        <p class="form__note">{f('resume')} <a href={`mailto:${site.hrEmail}`}>{site.hrEmail}</a>.</p>
      </>
    )}

    <label class="consent">
      <input type="checkbox" name="consent" required />
      <span>{f('consent')}</span>
    </label>

    <button type="submit" class="btn btn--primary btn--lg btn--block" data-submit>
      <span data-submit-label>{submitLabel}</span>
      <Icon name="arrow-right" size={18} class="icon--arrow" />
      <span class="spinner" aria-hidden="true"></span>
    </button>
    <p class="form__status" role="status" aria-live="polite" data-status></p>
  </form>

  <div class="form-success" data-success hidden>
    <svg class="form-success__check" viewBox="0 0 52 52" aria-hidden="true"><circle cx="26" cy="26" r="24" /><path d="M15 27l7 7 15-16" /></svg>
    <h3 class="h3">{f('thanks')}</h3>
    <p class="muted">{f('received')}</p>
    <p class="form-success__ref" data-reference hidden>{f('refBefore')} <strong></strong>. {f('refAfter')}</p>
    <a href={site.phoneHref} class="link-arrow">{f('callNow', { phone: site.phone })} <Icon name="arrow-right" size={16} /></a>
  </div>
</div>

<style>
  .form-card {
    position: relative;
    background: var(--surface);
    border-radius: var(--r-xl);
    padding: clamp(24px, 3.5vw, 40px);
    border: 1px solid var(--line-2);
    box-shadow: var(--shadow);
  }
  .form-card__head { margin-bottom: 22px; }
  .form-card__head > * + * { margin-top: 8px; }
  .form-card--dark { background: rgb(255 255 255 / 0.04); border-color: rgb(255 255 255 / 0.12); box-shadow: none; backdrop-filter: blur(10px); }
  .form-card--dark h2 { color: #fff; }
  .form-card--dark .muted, .form-card--dark .consent { color: rgb(255 255 255 / 0.7); }
  .form-card--dark :global(.field label) { color: #fff; }
  .form-card--dark :global(.field input), .form-card--dark :global(.field select), .form-card--dark :global(.field textarea) {
    background: rgb(255 255 255 / 0.06); border-color: rgb(255 255 255 / 0.16); color: #fff;
  }
  .form-card--dark :global(.field select option) { color: var(--ink); }

  .consent { display: flex; align-items: flex-start; gap: 10px; font-size: 0.86rem; color: var(--muted); cursor: pointer; }
  .consent input { width: 18px; height: 18px; margin-top: 2px; accent-color: var(--g-600); flex: none; }

  [data-submit] .spinner {
    display: none; width: 18px; height: 18px; border-radius: 50%;
    border: 2.5px solid rgb(255 255 255 / 0.35); border-top-color: #fff; animation: spin 0.8s linear infinite;
  }
  [data-submit].is-loading .spinner { display: inline-block; }
  [data-submit].is-loading :global(.icon) { display: none; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .form__status:empty { display: none; }
  .form__status { padding: 12px 14px; border-radius: 12px; background: #fdecec; color: #9b2c2c; font-size: 0.9rem; }
  .form__status :global(a) { font-weight: 700; text-decoration: underline; }

  .form-success { text-align: center; display: grid; gap: 12px; justify-items: center; padding: 24px 0; }
  .form-success[hidden] { display: none; }
  .form-success__check { width: 84px; height: 84px; }
  .form-success__check circle { fill: var(--g-100); stroke: var(--g-500); stroke-width: 2; stroke-dasharray: 160; stroke-dashoffset: 160; animation: draw 0.8s var(--ease-out) forwards; }
  .form-success__check path { fill: none; stroke: var(--g-600); stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 40; stroke-dashoffset: 40; animation: draw 0.5s 0.6s var(--ease-out) forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
</style>
