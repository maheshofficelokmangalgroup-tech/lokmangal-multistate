---
import Icon from './Icon.astro';
import { fmtRate, type Scheme } from '../data/deposits';
import { getLang, localePath } from '../i18n';
import { useT } from '../i18n/ui';

interface Props {
  scheme: Scheme;
  index?: number;
}
const { scheme: s, index = 0 } = Astro.props;
const lang = getLang(Astro);
const t = useT(lang);
const detailsHref = localePath(`/deposits/${s.slug}/`, lang);
---

<article class:list={['scheme', `scheme--${s.kind}`]} data-kind={s.kind} style={`--i:${index}`}>
  <div class="scheme__top">
    <span class="chip">{t(`kind.${s.kind}` as 'kind.fd')}</span>
    {lang === 'en' && <span class="scheme__mr" lang="mr">{s.nameMr}</span>}
  </div>
  <div class="scheme__rate" transition:name={`rate-${s.slug}`}>
    {s.rate !== null ? (
      <p><span class="scheme__num">{fmtRate(s.rate)}</span><span class="scheme__pct">%</span></p>
    ) : (
      <p><span class="scheme__num">2</span><span class="scheme__pct">×</span></p>
    )}
    <small>{s.rateNote}</small>
  </div>
  <h3 class="scheme__name"><a href={detailsHref}>{s.name}</a></h3>
  <p class="scheme__pitch">{s.pitch}</p>
  <dl class="scheme__facts">
    {s.highlight.map((h) => (
      <div><dt>{h.label}</dt><dd>{h.value}</dd></div>
    ))}
  </dl>
  <div class="scheme__actions">
    <a href={detailsHref} class="link-arrow">{t('btn.details')} <Icon name="arrow-right" size={16} /></a>
    <a href={`${localePath('/apply-for-deposits/', lang)}?scheme=${encodeURIComponent(s.name)}`} class="btn btn--green btn--sm">{t('btn.apply')}</a>
  </div>
  <span class="scheme__shine" aria-hidden="true"></span>
</article>

<style>
  .scheme {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--line-2);
    box-shadow: var(--shadow-xs);
    transition: transform 0.55s var(--ease-out), box-shadow 0.55s var(--ease-out), border-color 0.3s;
  }
  .scheme::before {
    content: '';
    position: absolute;
    z-index: -1;
    width: 240px;
    height: 240px;
    right: -90px;
    top: -110px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--g-100), transparent 70%);
    transition: transform 0.8s var(--ease-out), background 0.4s;
  }
  .scheme:hover { transform: translateY(-8px); box-shadow: var(--shadow); border-color: transparent; }
  .scheme:hover::before { transform: scale(1.6); }
  .scheme__top { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .scheme__mr { font-size: 0.82rem; color: var(--muted); font-weight: 600; text-align: right; }
  .scheme__rate p { display: flex; align-items: flex-start; line-height: 0.9; color: var(--g-700); }
  .scheme__num { font-size: clamp(3.4rem, 6vw, 4.2rem); font-weight: 800; letter-spacing: -0.05em; }
  .scheme__pct { font-size: 1.8rem; font-weight: 800; margin-top: 6px; margin-left: 2px; }
  .scheme__rate small { display: block; margin-top: 6px; font-size: 0.82rem; font-weight: 600; color: var(--muted); }
  .scheme__name { font-size: 1.22rem; letter-spacing: -0.015em; }
  .scheme__name a::after { content: ''; position: absolute; inset: 0; z-index: 0; }
  .scheme__pitch { color: var(--muted); font-size: 0.95rem; }
  .scheme__facts { margin: 4px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .scheme__facts div { padding: 10px; border-radius: 12px; background: var(--bg); border: 1px solid var(--line-2); }
  .scheme__facts dt { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted-2); }
  .scheme__facts dd { margin: 2px 0 0; font-weight: 800; color: var(--ink); font-size: 0.92rem; font-variant-numeric: tabular-nums; }
  .scheme__actions { margin-top: auto; padding-top: 10px; display: flex; justify-content: space-between; align-items: center; gap: 10px; position: relative; z-index: 1; }
  .scheme__shine {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background: linear-gradient(115deg, transparent 35%, rgb(255 255 255 / 0.55) 50%, transparent 65%);
    transform: translateX(-120%);
    transition: transform 1s var(--ease);
  }
  .scheme:hover .scheme__shine { transform: translateX(120%); }
</style>
