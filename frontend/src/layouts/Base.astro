---
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '@fontsource/poppins/latin-800.css';
import '@fontsource/poppins/devanagari-400.css';
import '@fontsource/poppins/devanagari-500.css';
import '@fontsource/poppins/devanagari-600.css';
import '@fontsource/poppins/devanagari-700.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import poppins400 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import poppins600 from '@fontsource/poppins/files/poppins-latin-600-normal.woff2?url';
import Header from '../components/Header.astro';
import SearchDialog from '../components/SearchDialog.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { siteData } from '../data/site';
import { isPreview, ratesExpired, ratesLastValidDayFor, ratesValidUntil } from '../lib/content';
import { getLang, hasMarathi, langTags, ogLocales, stripLang } from '../i18n';
import { runtimeStrings, useT } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}
const lang = getLang(Astro);
const t = useT(lang);
const { site } = siteData(lang);
const { title, description = site.description, image = '/images/brand/og-icon.png', jsonLd, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : t('title.home', { name: site.name });
const bare = stripLang(Astro.url.pathname);
const alternates = hasMarathi(bare) ? [['en-IN', bare], ['mr-IN', bare === '/' ? '/mr/' : `/mr${bare}`], ['x-default', bare]] : [];
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'FinancialService',
  name: site.legalName,
  alternateName: site.name,
  url: site.url,
  logo: `${site.url}/images/brand/logo-full.png`,
  image: ogImage,
  telephone: site.phone,
  email: site.email,
  slogan: site.tagline,
  foundingDate: String(site.founded),
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.address.line1}, ${site.address.line2}`,
    addressLocality: site.address.city,
    postalCode: site.address.pin,
    addressRegion: site.address.state,
    addressCountry: 'IN',
  },
  areaServed: ['Maharashtra', 'Karnataka'],
  sameAs: site.social.map((s) => s.href),
};
const ld = [orgLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang={lang} data-rates-valid-until={ratesValidUntil} data-rates-expired={ratesExpired ? "true" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map(([hl, href]) => <link rel="alternate" hreflang={hl} href={new URL(href, site.url).href} />)}
    {(noindex || isPreview) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#083822" />
    <link rel="preload" href={poppins400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poppins600} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocales[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@LMCSOfficial" />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script type="application/json" id="i18n" set:html={JSON.stringify(runtimeStrings(lang))} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">{t('skip')}</a>
    <div class="scroll-progress" data-progress aria-hidden="true"></div>

    {isPreview && (
      <div class="site-flag site-flag--preview" role="note">{t('preview')}</div>
    )}
    <div class="site-flag site-flag--rates" role="status" data-rates-notice hidden={!ratesExpired}>
      {t('rates.expired', { date: ratesLastValidDayFor(lang), phone: site.phone })}
    </div>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <div class="fab" data-fab>
      <a href={site.phoneHref} class="fab__btn fab__call" aria-label={t('fab.call', { phone: site.phone })}>
        <Icon name="phone" size={20} />
      </a>
      <button class="fab__btn fab__top" data-to-top aria-label={t('fab.top')}>
        <svg viewBox="0 0 48 48" class="fab__ring" aria-hidden="true"><circle cx="24" cy="24" r="22" pathLength="100" data-top-ring></circle></svg>
        <Icon name="arrow-up" size={20} />
      </button>
    </div>

    <dialog class="lightbox" data-lightbox aria-label={t('lightbox')}>
      <button class="lightbox__close" data-lightbox-close aria-label={t('lightbox.close')}><Icon name="x" size={24} /></button>
      <button class="lightbox__nav lightbox__prev" data-lightbox-prev aria-label={t('lightbox.prev')}><Icon name="chevron-left" size={26} /></button>
      <figure class="lightbox__figure">
        <img src="" alt="" data-lightbox-img />
        <figcaption data-lightbox-caption></figcaption>
      </figure>
      <button class="lightbox__nav lightbox__next" data-lightbox-next aria-label={t('lightbox.next')}><Icon name="chevron-right" size={26} /></button>
    </dialog>

    <SearchDialog />

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>

<style is:global>
  main:focus { outline: none; }
  .skip-link {
    position: fixed; left: 16px; top: -60px; z-index: var(--z-skip);
    padding: 12px 18px; border-radius: 12px; background: var(--g-800); color: #fff; font-weight: 700;
    transition: top 0.2s;
  }
  .skip-link:focus { top: 16px; }

  .scroll-progress {
    position: fixed; inset: 0 0 auto; height: 3px; z-index: var(--z-progress);
    background: linear-gradient(90deg, var(--g-500), var(--gold), var(--o-500));
    transform-origin: 0 50%;
    transform: scaleX(var(--progress, 0));
    pointer-events: none;
  }

  .fab { position: fixed; right: max(18px, env(safe-area-inset-right)); bottom: max(18px, env(safe-area-inset-bottom)); z-index: var(--z-fab); display: grid; gap: 10px; }
  .fab__btn {
    position: relative; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%;
    box-shadow: var(--shadow); transition: transform 0.45s var(--ease-spring), opacity 0.3s, background 0.25s;
  }
  .fab__call { background: var(--o-500); color: #fff; }
  .fab__call:hover { background: var(--o-600); transform: scale(1.08) rotate(-12deg); }
  @keyframes fab-ring { 0%, 100% { box-shadow: var(--shadow), 0 0 0 0 rgb(236 106 30 / 0.45); } 50% { box-shadow: var(--shadow), 0 0 0 12px rgb(236 106 30 / 0); } }
  .fab__top { background: #fff; color: var(--g-800); opacity: 0; transform: translateY(16px) scale(0.8); pointer-events: none; }
  .fab__top.is-visible { opacity: 1; transform: none; pointer-events: auto; }
  .fab__top:hover { transform: translateY(-3px); }
  .fab__ring { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
  .fab__ring circle { fill: none; stroke: var(--o-500); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: var(--ring, 100); }
  @media (min-width: 900px) { .fab__call { display: none; } }

  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: transparent; color: #fff; overflow: hidden;
  }
  .lightbox::backdrop { background: rgb(3 22 14 / 0.9); backdrop-filter: blur(10px); }
  .lightbox[open] { display: grid; place-items: center; animation: lb-in var(--dur-m) var(--ease-out); }
  .lightbox.is-closing { animation: lb-out var(--dur-m-exit) var(--ease-in) forwards; }
  .lightbox.is-closing::backdrop { animation: lb-out var(--dur-m-exit) var(--ease-in) forwards; }
  @keyframes lb-in { from { opacity: 0; } }
  @keyframes lb-out { to { opacity: 0; } }
  .lightbox__figure { margin: 0; max-width: min(92vw, 1100px); display: grid; gap: 14px; justify-items: center; }
  .lightbox__figure img { max-height: 80dvh; width: auto; border-radius: 16px; box-shadow: 0 30px 80px rgb(0 0 0 / 0.5); transform-origin: center; }
  .lightbox__figure figcaption { font-weight: 600; color: rgb(255 255 255 / 0.85); text-align: center; }
  .lightbox__close, .lightbox__nav {
    position: fixed; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%;
    background: rgb(255 255 255 / 0.1); color: #fff; border: 1px solid rgb(255 255 255 / 0.2); transition: background 0.2s, transform 0.3s var(--ease-out);
  }
  .lightbox__close:hover, .lightbox__nav:hover { background: var(--o-500); }
  .lightbox__close { top: 18px; right: 18px; }
  .lightbox__prev { left: 18px; top: 50%; transform: translateY(-50%); }
  .lightbox__next { right: 18px; top: 50%; transform: translateY(-50%); }
  .lightbox.is-single .lightbox__nav { display: none; }
  @media (max-width: 640px) { .lightbox__nav { top: auto; bottom: 20px; transform: none; } }
</style>
