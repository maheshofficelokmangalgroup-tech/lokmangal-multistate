---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { rwmCategories } from '../data/services';
import { site } from '../data/site';
---

<Base title="Rural Wealth Manager" description="Lokmangal Rural Wealth Manager — investments, loans, demat & trading, gold & silver and insurance services for rural India, all in one place.">
  <PageHero
    title="Rural"
    accent="Wealth Manager"
    eyebrow="ग्रामीण संपत्ती व्यवस्थापन सुविधा"
    subtitle="Making the rural economy stronger. Investments, loans, equity, commodities and insurance — complete wealth management for rural families, under one trusted roof."
    crumbs={[{ label: 'Rural Wealth Manager' }]}
  >
    <a href={site.phoneHref} class="btn btn--primary"><Icon name="phone" size={18} /> Call {site.phone}</a>
    <a href="#rwm-enquiry" class="btn btn--outline-light">Request a callback</a>
    <div slot="aside" class="rwm-hero">
      <p lang="mr" class="rwm-hero__mr">आता होईल<br /><strong>ग्रामीण अर्थव्यवस्था</strong><br />अधिक सक्षम</p>
      <p class="rwm-hero__en">Now the rural economy becomes even stronger.</p>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Five services, one relationship</p>
        <h2 class="h2">Everything your family needs to <em>grow wealth</em></h2>
        <p class="lead">Our Rural Wealth Managers bring financial products that were once available only in cities to the doorsteps of villages and small towns.</p>
      </div>
      <div class="rwm-grid" data-stagger>
        {rwmCategories.map((c) => (
          <article class="rwm-card">
            <div class="rwm-card__head">
              <span class="icon-badge icon-badge--dark"><Icon name={c.icon} size={24} /></span>
              <div>
                <h3 class="h4">{c.title}</h3>
                <p lang="mr">{c.titleMr}</p>
              </div>
            </div>
            <ul>
              {c.items.map(([en, mr]) => (
                <li><Icon name="check" size={16} /><span>{en}<small lang="mr">{mr}</small></span></li>
              ))}
            </ul>
          </article>
        ))}
        <article class="rwm-card rwm-card--cta">
          <h3 class="h4">Speak to a Rural Wealth Manager</h3>
          <p>Get personal guidance on investments, insurance and loans for your family.</p>
          <a href={site.phoneHref} class="btn btn--light btn--sm"><Icon name="phone" size={16} /> {site.phone}</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--cream" id="rwm-enquiry">
    <div class="container split">
      <a href="/images/misc/rural-wealth-manager.webp" class="rwm-poster" data-zoom="rwm" data-caption="Rural Wealth Manager — ग्रामीण संपत्ती व्यवस्थापन सुविधा" data-reveal="left">
        <img src="/images/misc/rural-wealth-manager.webp" alt="Rural Wealth Manager leaflet" width="1152" height="1600" loading="lazy" />
        <span class="rwm-poster__hint"><Icon name="search" size={16} /> View leaflet</span>
      </a>
      <div data-reveal="right">
        <EnquiryForm variant="service" title="Request a callback" subtitle="Tell us what you’re looking for and a Rural Wealth Manager will contact you." />
      </div>
    </div>
  </section>
</Base>

<style>
  .rwm-hero { padding: clamp(28px, 4vw, 44px); border-radius: var(--r-xl); background: radial-gradient(100% 100% at 100% 0%, rgb(243 179 61 / 0.35), transparent 60%), rgb(255 255 255 / 0.06); border: 1px solid rgb(255 255 255 / 0.14); backdrop-filter: blur(10px); }
  .rwm-hero__mr { font-family: var(--font-deva); font-size: clamp(1.6rem, 3vw, 2.3rem); line-height: 1.3; color: #fff; font-weight: 600; }
  .rwm-hero__mr strong { color: var(--gold); font-weight: 700; }
  .rwm-hero__en { margin-top: 12px; color: rgb(255 255 255 / 0.7); }

  .rwm-grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .rwm-card { padding: 28px; border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line-2); transition: transform 0.5s var(--ease-out), box-shadow 0.5s; }
  .rwm-card:hover { transform: translateY(-6px); box-shadow: var(--shadow); }
  .rwm-card__head { display: flex; align-items: center; gap: 14px; padding-bottom: 18px; margin-bottom: 18px; border-bottom: 1px dashed var(--line); }
  .rwm-card__head .icon-badge { background: var(--g-800); color: var(--o-300); }
  .rwm-card__head p { color: var(--o-600); font-weight: 700; }
  .rwm-card ul { list-style: none; display: grid; gap: 12px; }
  .rwm-card li { display: flex; gap: 12px; align-items: flex-start; font-weight: 700; color: var(--ink); }
  .rwm-card li :global(.icon) { flex: none; margin-top: 3px; color: #fff; background: var(--g-500); border-radius: 50%; padding: 3px; width: 20px; height: 20px; }
  .rwm-card li small { display: block; font-weight: 500; color: var(--muted); font-size: 0.92rem; }
  .rwm-card--cta { display: grid; gap: 12px; align-content: center; justify-items: start; color: #fff; background: linear-gradient(140deg, #b84c0c, #9f3f0a); border: 0; }
  .rwm-card--cta h3 { color: #fff; }
  .rwm-poster { position: relative; display: block; max-width: 480px; margin-inline: auto; border-radius: var(--r-xl); overflow: hidden; box-shadow: var(--shadow-lg); cursor: zoom-in; rotate: -2deg; transition: rotate 0.6s var(--ease-out); }
  .rwm-poster:hover { rotate: 0deg; }
  .rwm-poster img { width: 100%; height: auto; }
  .rwm-poster__hint { position: absolute; left: 16px; bottom: 16px; display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; background: rgb(255 255 255 / 0.94); font-weight: 700; font-size: 0.84rem; color: var(--g-800); }
</style>
