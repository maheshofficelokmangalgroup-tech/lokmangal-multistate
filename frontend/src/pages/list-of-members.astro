---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { memberLists } from '../data/site';
---

<Base title="List of Members" description="Provisional list of members / delegates eligible to vote: Lokmangal Multistate Board of Directors election 2025, district-wise PDFs.">
  <PageHero
    title="List of"
    accent="members"
    eyebrow="Election 2025"
    subtitle="Provisional list of members / delegates eligible to vote, published district-wise."
    crumbs={[{ label: 'Notices', href: '/notices/' }, { label: 'List of Members' }]}
    compact
  />

  <section class="section">
    <div class="container">
      <div class="note" data-reveal>
        <Icon name="help-circle" size={22} />
        <p>These are scanned documents and some files are large (up to {Math.max(...memberLists.map((m) => m.sizeMb))} MB). We recommend downloading over Wi-Fi.</p>
      </div>
      <div class="districts" data-stagger>
        {memberLists.map((m) => (
          <a href={m.href} target="_blank" rel="noopener" class="district">
            <span class="district__pdf">PDF</span>
            <strong>{m.district}</strong>
            <small>{m.sizeMb} MB</small>
            <span class="district__go"><Icon name="download" size={18} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .note { display: flex; gap: 12px; align-items: flex-start; padding: 16px 20px; margin-bottom: 28px; border-radius: var(--r); background: var(--o-50); border: 1px solid var(--o-100); color: var(--ink-2); }
  .note :global(.icon) { color: var(--o-600); flex: none; margin-top: 2px; }
  .districts { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); }
  .district { position: relative; display: grid; gap: 6px; justify-items: start; padding: 22px; border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line-2); transition: transform 0.45s var(--ease-out), box-shadow 0.45s; }
  .district:hover { transform: translateY(-6px); box-shadow: var(--shadow); }
  .district__pdf { padding: 4px 9px; border-radius: 8px; background: #c0392b; color: #fff; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; }
  .district strong { font-size: 1.15rem; color: var(--ink); margin-top: 8px; }
  .district small { color: var(--muted); font-weight: 600; }
  .district__go { position: absolute; right: 18px; bottom: 18px; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: var(--g-50); color: var(--g-700); transition: background 0.25s, color 0.25s; }
  .district:hover .district__go { background: var(--g-700); color: #fff; }
</style>
