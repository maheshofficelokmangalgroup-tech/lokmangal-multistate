---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import Calculator from '../../../components/Calculator.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { depositsData, fmtRate, type Scheme } from '../../../data/deposits';
import { siteData } from '../../../data/site';
import { schemeBanner } from '../../../lib/scheme-banner';
import { getLang, langPaths, localePath } from '../../../i18n';
import { pageCopy, useT } from '../../../i18n/ui';

export function getStaticPaths() {
  return langPaths();
}

const lang = getLang(Astro);
const t = useT(lang);
const l = (p: string) => localePath(p, lang);
const { site } = siteData(lang);
const { schemes, fdSlabs, specialCategories, depositDocuments, depositBenefits } = depositsData(lang);
const english = depositsData('en');

const c = pageCopy(
  lang,
  'deposits',
  {
    metaTitle: 'Deposit Schemes',
    metaDescription: 'Fixed deposits up to {top}% p.a., monthly income, recurring deposits, Lakshadish RD and the Daam Duppat doubling scheme from Lokmangal Multistate. Rates valid from {validity}.',
    eyebrow: 'Deposit schemes',
    title: 'Save for the future,',
    accent: 'up to {top}% a year',
    lead: 'Fixed, recurring, monthly income and doubling deposits for every goal. Rates valid from {validity}.',
    apply: 'Apply for a deposit',
    rates: 'Interest rate chart',
    pause: 'Pause the changing pictures',
    play: 'Play the changing pictures',
    chipFd: 'Fixed deposit',
    chipMonthly: 'Monthly income',
    chipRd: 'Recurring',
    chipLakshadish: 'Lakshadish',
    chipDouble: 'Daam Duppat',
    allEyebrow: 'All schemes',
    allTitle: 'Choose the plan that',
    allAccent: 'fits your goal',
    filterLabel: 'Filter schemes',
    filterAll: 'All schemes',
    count: '{n} schemes',
    fdEyebrow: 'Vishwamangal Fixed Deposit',
    fdTitle: 'Fixed deposit rates',
    fdAccent: 'by tenure',
    fdLead: 'Rates valid from {validity}.',
    tenure: 'Tenure',
    regular: 'Regular',
    special: 'Special categories',
    specialWho: 'Special categories:',
    tds: 'TDS is applicable on interest earned, except for society members.',
    fdLink: 'See the Fixed Deposit scheme',
    who: 'Who can invest?',
    whoText: 'Any resident Indian individual or entity, including senior citizens, HUFs, minors through guardians, associations, trusts and institutions.',
    docs: 'Documents required',
    docsText: 'Bring these to your nearest branch:',
    branch: 'Find your nearest branch',
    calcEyebrow: 'Deposit calculator',
    calcTitle: 'Watch your money',
    calcAccent: 'grow',
    ctaTitle: 'Ready to start',
    ctaAccent: 'saving?',
    ctaText: 'Visit any of our branches with your KYC documents, or apply online and our team will help you open your deposit.',
  },
  {
    metaTitle: 'ठेव योजना',
    metaDescription: 'लोकमंगल मल्टीस्टेटच्या ठेव योजना: वार्षिक {top}% पर्यंत मुदत ठेव, मासिक उत्पन्न, रिकरिंग ठेव, लक्षदिश आणि दाम दुप्पट योजना. दर {validity} या कालावधीसाठी लागू.',
    eyebrow: 'ठेव योजना',
    title: 'भविष्यासाठी बचत,',
    accent: 'वार्षिक {top}% पर्यंत',
    lead: 'प्रत्येक उद्दिष्टासाठी मुदत, रिकरिंग, मासिक उत्पन्न आणि दाम दुप्पट ठेवी. दर {validity} या कालावधीसाठी लागू.',
    apply: 'ठेवीसाठी अर्ज करा',
    rates: 'व्याजदर तक्ता',
    pause: 'बदलणारी चित्रे थांबवा',
    play: 'बदलणारी चित्रे सुरू करा',
    chipFd: 'मुदत ठेव',
    chipMonthly: 'मासिक उत्पन्न',
    chipRd: 'रिकरिंग',
    chipLakshadish: 'लक्षदिश',
    chipDouble: 'दाम दुप्पट',
    allEyebrow: 'सर्व योजना',
    allTitle: 'तुमच्या उद्दिष्टाला',
    allAccent: 'साजेशी योजना निवडा',
    filterLabel: 'योजना निवडा',
    filterAll: 'सर्व योजना',
    count: '{n} योजना',
    fdEyebrow: 'विश्वमंगल मुदत ठेव',
    fdTitle: 'मुदतीनुसार',
    fdAccent: 'मुदत ठेव दर',
    fdLead: 'दर {validity} या कालावधीसाठी लागू.',
    tenure: 'मुदत',
    regular: 'सर्वसाधारण',
    special: 'विशेष गट',
    specialWho: 'विशेष गट:',
    tds: 'संस्थेच्या सभासदांना वगळून, मिळणाऱ्या व्याजावर टीडीएस लागू.',
    fdLink: 'मुदत ठेव योजना पहा',
    who: 'कोण गुंतवणूक करू शकते?',
    whoText: 'ज्येष्ठ नागरिक, एचयूएफ, पालकांमार्फत अज्ञान, संघटना, ट्रस्ट आणि संस्थांसह कोणतीही निवासी भारतीय व्यक्ती किंवा संस्था.',
    docs: 'आवश्यक कागदपत्रे',
    docsText: 'जवळच्या शाखेत ही कागदपत्रे घेऊन या:',
    branch: 'जवळची शाखा शोधा',
    calcEyebrow: 'ठेव कॅल्क्युलेटर',
    calcTitle: 'तुमचे पैसे',
    calcAccent: 'वाढताना पहा',
    ctaTitle: 'बचतीला',
    ctaAccent: 'सुरुवात करूया?',
    ctaText: 'केवायसी कागदपत्रांसह आमच्या कोणत्याही शाखेत या, किंवा ऑनलाइन अर्ज करा; ठेव उघडण्यासाठी आमची टीम मदत करेल.',
  },
);

const rateText = (s: Scheme) => (s.rate !== null ? `${fmtRate(s.rate)}%` : '2×');
const top = Math.max(...schemes.map((s) => s.rate ?? 0));
const vars = { top: fmtRate(top), validity: site.ratesValidity };
// Forms receive the English scheme name, whatever language the page is in.
const applyHref = (slug: string) => `${l('/apply-for-deposits/')}?scheme=${encodeURIComponent(english.schemeBySlug(slug)?.name ?? slug)}`;

// Banner: one picture per kind of deposit, cross-fading; the chips name each one with its rate.
const pick = (slug: string) => schemes.find((s) => s.slug === slug);
const heroSlides = (
  [
    [pick('vishwamangal-fixed-deposit-scheme'), c('chipFd')],
    [pick('vishvamangal-monthly-interest'), c('chipMonthly')],
    [pick('vishvamangal-recurring-deposit'), c('chipRd')],
    [pick('lakshadish-deposit-scheme-1'), c('chipLakshadish')],
    [pick('daam-duppat-yojna'), c('chipDouble')],
  ] as [Scheme | undefined, string][]
)
  .filter((x): x is [Scheme, string] => !!x[0])
  .map(([s, label]) => ({ s, label, banner: schemeBanner(s.slug, s.kind) }))
  .filter((x) => x.banner);

const kinds = ['all', 'fd', 'rd', 'monthly', 'double'] as const;
const kindCount = (k: (typeof kinds)[number]) => (k === 'all' ? schemes.length : schemes.filter((s) => s.kind === k).length);

const slabMax = Math.max(...fdSlabs.map((r) => Math.max(r.regular, r.special)));
const bar = (r: number) => Math.round(22 + (r / slabMax) * 78);
const fdScheme = pick('vishwamangal-fixed-deposit-scheme');
---

<Base title={c('metaTitle')} description={c('metaDescription', vars)}>
  <!-- BANNER -->
  <section class="dp-hero" data-dep-hero>
    <div class="dp-hero__media" aria-hidden="true">
      {heroSlides.length > 0
        ? heroSlides.map((h, i) => <img src={h.banner!} alt="" class:list={['dp-hero__img', { 'is-active': i === 0 }]} width="1672" height="941" fetchpriority={i === 0 ? 'high' : 'low'} data-dep-slide />)
        : <img src="/images/about/banner.webp" alt="" class="dp-hero__img is-active" width="1672" height="941" />}
    </div>
    <div class="container">
      <nav class="dp-crumbs" aria-label={t('breadcrumb')}>
        <a href={l('/')}>{t('home')}</a>
        <Icon name="chevron-right" size={14} />
        <span aria-current="page">{c('eyebrow')}</span>
      </nav>
      <div class="dp-hero__copy">
        <p class="dp-hero__eyebrow">{c('eyebrow')}</p>
        <h1 class="h1 dp-hero__title" data-reveal>{c('title')} <em>{c('accent', vars)}</em></h1>
        <p class="lead dp-hero__lead" data-reveal style="--d:120ms">{c('lead', vars)}</p>
        {heroSlides.length > 0 && (
          <div class="dp-chips" data-reveal style="--d:200ms">
            {heroSlides.map((h, i) => (
              <a href={l(`/deposits/${h.s.slug}/`)} class:list={['dp-chip', { 'is-active': i === 0 }]} data-dep-chip={i}>
                <strong>{rateText(h.s)}</strong>
                <span>{h.label}</span>
              </a>
            ))}
            {heroSlides.length > 1 && (
              <button type="button" class="dp-toggle" data-dep-toggle aria-pressed="false" aria-label={c('pause')} data-label-pause={c('pause')} data-label-play={c('play')}>
                <svg class="dp-toggle__pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1.2" /><rect x="14" y="5" width="4" height="14" rx="1.2" /></svg>
                <svg class="dp-toggle__play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l12-7.5z" /></svg>
              </button>
            )}
          </div>
        )}
        <div class="btn-row" data-reveal style="--d:280ms">
          <a href={l('/apply-for-deposits/')} class="btn btn--primary btn--lg">{c('apply')} <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
          <a href={l('/interest-rates/')} class="btn btn--ghost btn--lg">{c('rates')}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="dp-benefits-wrap">
    <div class="container">
      <ol class="dp-benefits" data-stagger>
        {depositBenefits.map((b, i) => (
          <li><span class="dp-benefits__n">{String(i + 1).padStart(2, '0')}</span><div><strong>{b.title}</strong><small>{b.text}</small></div></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ALL SCHEMES -->
  <section class="section dp-all">
    <div class="container">
      <div class="dp-all__head" data-reveal>
        <div>
          <p class="eyebrow">{c('allEyebrow')}</p>
          <h2 class="h2">{c('allTitle')} <em>{c('allAccent')}</em></h2>
        </div>
        <div class="dp-filters" data-filter-group="#scheme-grid" role="group" aria-label={c('filterLabel')}>
          {kinds.map((k) => (
            <button type="button" class="dp-filter" data-filter={k} aria-pressed={k === 'all' ? 'true' : 'false'}>
              {k === 'all' ? c('filterAll') : t(`kind.${k}` as 'kind.fd')}
              <span class="dp-filter__n">{kindCount(k)}</span>
            </button>
          ))}
        </div>
      </div>
      <ul class="dp-grid" id="scheme-grid" data-stagger>
        {schemes.map((s) => {
          const img = schemeBanner(s.slug, s.kind);
          return (
            <li class="dp-card" data-kind={s.kind}>
              <div class="dp-card__media">
                {img ? <img src={img} alt="" width="1672" height="941" loading="lazy" /> : <span class="dp-card__ph">{rateText(s)}</span>}
                <span class="dp-card__kind">{t(`kind.${s.kind}` as 'kind.fd')}</span>
              </div>
              <div class="dp-card__body">
                <p class="dp-card__rate"><strong>{rateText(s)}</strong> <span>{s.rateNote}</span></p>
                <h3 class="dp-card__name"><a href={l(`/deposits/${s.slug}/`)}>{s.name}</a></h3>
                {lang === 'en' && <p class="dp-card__mr" lang="mr">{s.nameMr}</p>}
                <p class="dp-card__pitch">{s.pitch}</p>
                <dl class="dp-card__facts">
                  {s.highlight.slice(0, 3).map((h) => <div><dt>{h.label}</dt><dd>{h.value}</dd></div>)}
                </dl>
                <div class="dp-card__actions">
                  <span class="dp-card__more">{t('btn.details')} <Icon name="arrow-right" size={16} /></span>
                  <a href={applyHref(s.slug)} class="btn btn--green btn--sm">{t('btn.apply')}</a>
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- FD RATES -->
  <section class="section dp-fd">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{c('fdEyebrow')}</p>
        <h2 class="h2">{c('fdTitle')} <em>{c('fdAccent')}</em></h2>
        <p class="lead">{c('fdLead', vars)}</p>
      </div>
      <div class="dp-fd__board" data-reveal>
        <table class="dp-rates">
          <thead>
            <tr><th scope="col">{c('tenure')}</th><th scope="col"><i class="dp-key dp-key--r"></i>{c('regular')}</th><th scope="col"><i class="dp-key dp-key--s"></i>{c('special')}</th></tr>
          </thead>
          <tbody>
            {fdSlabs.map((r, i) => (
              <tr style={`--i:${i}`}>
                <th scope="row">{r.tenure}</th>
                <td><span class="dp-bar dp-bar--r" style={`--w:${bar(r.regular)}%`}><b>{fmtRate(r.regular)}%</b></span></td>
                <td><span class="dp-bar dp-bar--s" style={`--w:${bar(r.special)}%`}><b>{fmtRate(r.special)}%</b></span></td>
              </tr>
            ))}
          </tbody>
        </table>
        <div class="dp-fd__notes">
          <p><strong>{c('specialWho')}</strong> {specialCategories}</p>
          <p>{c('tds')}</p>
          {fdScheme && <a href={l(`/deposits/${fdScheme.slug}/`)} class="link-arrow">{c('fdLink')} <Icon name="arrow-right" size={15} /></a>}
        </div>
      </div>
    </div>
  </section>

  <!-- WHO AND DOCUMENTS -->
  <section class="section dp-docs">
    <div class="container dp-two">
      <div class="dp-box dp-box--green" data-reveal="left">
        <h2 class="dp-box__title">{c('who')}</h2>
        <p>{c('whoText')}</p>
        <a href={l('/branches/')} class="dp-box__link">{c('branch')} <Icon name="arrow-right" size={16} /></a>
      </div>
      <div class="dp-box" data-reveal="right">
        <h2 class="dp-box__title">{c('docs')}</h2>
        <p class="muted">{c('docsText')}</p>
        <ul class="check-list">{depositDocuments.map((d) => <li>{d}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- CALCULATOR -->
  <section class="section dp-calc">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">{c('calcEyebrow')}</p>
        <h2 class="h2">{c('calcTitle')} <em>{c('calcAccent')}</em></h2>
      </div>
      <div data-reveal="zoom"><Calculator only={['fd', 'rd', 'monthly']} /></div>
    </div>
  </section>

  <CtaBand title={c('ctaTitle')} accent={c('ctaAccent')} text={c('ctaText')} />
</Base>

<script>
  // Banner pictures cross-fade every 5 seconds. Pointing at or focusing a chip shows that scheme's picture;
  // the button pauses it, and it holds still off screen and with reduced motion.
  document.addEventListener('astro:page-load', () => {
    const hero = document.querySelector<HTMLElement>('[data-dep-hero]');
    if (!hero) return;
    const slides = Array.from(hero.querySelectorAll<HTMLElement>('[data-dep-slide]'));
    const chips = Array.from(hero.querySelectorAll<HTMLElement>('[data-dep-chip]'));
    if (slides.length < 2) return;
    const show = (n: number) => {
      index = (n + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle('is-active', i === index));
      chips.forEach((c, i) => c.classList.toggle('is-active', i === index));
    };
    let index = 0;
    let paused = false;
    let holding = false;
    let visible = true;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    chips.forEach((chip, i) => {
      chip.addEventListener('pointerenter', () => { holding = true; show(i); });
      chip.addEventListener('pointerleave', () => { holding = false; });
      chip.addEventListener('focus', () => { holding = true; show(i); });
      chip.addEventListener('blur', () => { holding = false; });
    });
    const toggle = hero.querySelector<HTMLButtonElement>('[data-dep-toggle]');
    toggle?.addEventListener('click', () => {
      paused = !paused;
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.setAttribute('aria-label', (paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) ?? '');
    });
    if (reduce) {
      paused = true;
      toggle?.setAttribute('aria-pressed', 'true');
    }
    const io = new IntersectionObserver(([e]) => { visible = e.isIntersecting; });
    io.observe(hero);
    const timer = window.setInterval(() => {
      if (!paused && !holding && visible && !document.hidden) show(index + 1);
    }, 5000);
    document.addEventListener('astro:before-swap', () => { window.clearInterval(timer); io.disconnect(); }, { once: true });
  });
</script>

<style>
  /* ---------- Banner (same frame as the scheme pages) ---------- */
  .dp-hero {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: clamp(560px, 76vh, 720px); display: flex; flex-direction: column;
    padding: clamp(32px, 5vw, 56px) 0 clamp(48px, 6vw, 80px); background: #fff8f0;
  }
  .dp-hero > .container { flex: 1; display: flex; flex-direction: column; }
  .dp-hero__media { position: absolute; inset: 0; z-index: -2; }
  .dp-hero__img {
    position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 100% 50%;
    opacity: 0; transform: scale(1.06); transition: opacity 1s var(--ease), transform 6s linear;
  }
  .dp-hero__img.is-active { opacity: 1; transform: scale(1); }
  .dp-hero::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(90deg, #fff8f0 0%, #fff8f0 30%, rgb(255 248 240 / 0.82) 40%, rgb(255 248 240 / 0) 53%);
  }
  .dp-crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 0.86rem; font-weight: 600; color: var(--muted); }
  .dp-crumbs a { color: var(--g-700); }
  .dp-crumbs span { color: var(--o-700); }
  .dp-hero__copy { margin-block: auto; padding-top: clamp(24px, 4vw, 40px); max-width: 580px; display: grid; gap: 16px; justify-items: start; }
  .dp-hero__eyebrow { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--g-600); }
  :global(html[lang='mr']) .dp-hero__eyebrow { letter-spacing: 0; text-transform: none; font-size: 0.95rem; }
  .dp-hero__title { color: var(--g-900); }
  .dp-hero__title em { display: block; color: var(--o-600); }
  .dp-hero__lead { color: var(--ink-2); }
  .dp-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .dp-chip {
    display: inline-flex; align-items: baseline; gap: 7px; padding: 8px 14px; border-radius: 999px;
    background: #fff; border: 1px solid var(--line); color: var(--ink-2); font-size: 0.86rem; font-weight: 600;
    transition: background 0.3s, border-color 0.3s, color 0.3s, transform 0.35s var(--ease-out);
  }
  .dp-chip strong { font-size: 1.02rem; font-weight: 800; color: var(--o-600); font-variant-numeric: tabular-nums; transition: color 0.3s; }
  .dp-chip:hover { transform: translateY(-2px); border-color: var(--o-300); }
  .dp-chip.is-active { background: var(--g-800); border-color: var(--g-800); color: #fff; }
  .dp-chip.is-active strong { color: var(--gold); }
  .dp-toggle { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--line); background: #fff; color: var(--g-800); }
  .dp-toggle:hover { border-color: var(--g-600); }
  .dp-toggle__play { display: none; }
  .dp-toggle[aria-pressed='true'] .dp-toggle__play { display: block; }
  .dp-toggle[aria-pressed='true'] .dp-toggle__pause { display: none; }
  @media (min-width: 900px) and (max-width: 1199px) {
    .dp-hero::after { background: linear-gradient(90deg, #fff8f0 0%, #fff8f0 38%, rgb(255 248 240 / 0.8) 46%, rgb(255 248 240 / 0) 58%); }
    .dp-hero__copy { max-width: 440px; }
  }
  @media (max-width: 899px) {
    .dp-hero { min-height: 0; padding-top: 18px; }
    .dp-hero__media { inset: 0 0 auto 0; height: min(78vw, 380px); }
    .dp-hero__img { object-position: 96% 50%; }
    .dp-hero::after { background: linear-gradient(180deg, rgb(255 248 240 / 0.5) 0, rgb(255 248 240 / 0) 60px, rgb(255 248 240 / 0) calc(min(78vw, 380px) - 70px), #fff8f0 min(78vw, 380px)); }
    .dp-hero__copy { padding-top: calc(min(78vw, 380px) - 30px); }
  }

  /* ---------- Benefits ---------- */
  .dp-benefits-wrap { background: var(--g-800); color: rgb(255 255 255 / 0.8); }
  .dp-benefits { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
