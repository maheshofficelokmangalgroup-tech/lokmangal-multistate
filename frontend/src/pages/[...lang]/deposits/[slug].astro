---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import Calculator from '../../../components/Calculator.astro';
import EnquiryForm from '../../../components/EnquiryForm.astro';
import { depositsData, fmtRate, type Scheme } from '../../../data/deposits';
import { siteData } from '../../../data/site';
import { getLang, localePath, type Lang } from '../../../i18n';
import { pageCopy, useT } from '../../../i18n/ui';
import { compute } from '@lokmangal/finance';
import { schemeBanner } from '../../../lib/scheme-banner';

export function getStaticPaths() {
  return [undefined, 'mr'].flatMap((lang) =>
    depositsData(lang === 'mr' ? 'mr' : 'en').schemes.map((s) => ({ params: { lang, slug: s.slug }, props: { scheme: s } })),
  );
}

const { scheme: s } = Astro.props as { scheme: Scheme };
const lang: Lang = getLang(Astro);
const t = useT(lang);
const l = (p: string) => localePath(p, lang);
const { site } = siteData(lang);
const { schemes, depositDocuments, depositBenefits, fdSlabs, specialCategories } = depositsData(lang);
// Forms and the office work with the English scheme name, whatever language the page is in.
const englishName = depositsData('en').schemeBySlug(s.slug)?.name ?? s.name;
const applyHref = `${l('/apply-for-deposits/')}?scheme=${encodeURIComponent(englishName)}`;
const kind = t(`kind.${s.kind}` as 'kind.fd');

// The scheme's own banner, or the branch photo until it has one.
const ownBanner = schemeBanner(s.slug, s.kind);
const banner = ownBanner ?? '/images/about/banner.webp';

const c = pageCopy(
  lang,
  'deposit-scheme',
  {
    metaDescription: '{name}: {pitch} {kind} from Lokmangal Multistate Co-operative Society.',
    book: 'Book this deposit',
    calculate: 'Calculate returns',
    keyEyebrow: 'Key information',
    keyTitle: 'The scheme',
    keyAccent: 'at a glance',
    example: 'Example',
    exFd: 'Deposit {amount} for {months} months',
    exRd: 'Save {amount} a month for {months} months',
    exMonthly: 'Deposit {amount} for {months} months or more',
    exDouble: 'Deposit {amount} once',
    atMaturity: 'at maturity',
    everyMonth: 'every month',
    inMonths: 'in {months} months',
    interest: 'Interest earned',
    invested: 'You put in',
    exNote: 'Worked out with the current approved rate. Figures are indicative; TDS may apply.',
    ladder: 'Rate by tenure',
    regular: 'Regular',
    special: 'Special categories',
    specialWho: 'Special categories:',
    featEyebrow: 'Features',
    featTitle: 'What you',
    featAccent: 'get',
    who: 'Who can invest?',
    docs: 'Documents required',
    calcEyebrow: 'Calculator',
    calcTitle: 'Estimate your',
    calcAccent: 'returns',
    bookEyebrow: 'Book this deposit',
    bookTitle: 'We will',
    bookAccent: 'call you back',
    bookText: 'Share your details and our team will call you to book {name}. You can also visit any branch.',
    formTitle: 'Request a callback',
    formSubmit: 'Request a callback',
    applyOnline: 'Prefer the full application?',
    applyLink: 'Fill the deposit form',
    othersEyebrow: 'Other plans',
    othersTitle: 'Compare with',
    othersAccent: 'other deposits',
    allSchemes: 'All schemes',
  },
  {
    metaDescription: '{name}: {pitch} लोकमंगल मल्टीस्टेट को-ऑपरेटिव्ह सोसायटीची {kind}.',
    book: 'ही ठेव करा',
    calculate: 'परतावा मोजा',
    keyEyebrow: 'महत्त्वाची माहिती',
    keyTitle: 'योजना',
    keyAccent: 'एका नजरेत',
    example: 'उदाहरण',
    exFd: '{amount} ची ठेव, {months} महिन्यांसाठी',
    exRd: 'दरमहा {amount}, {months} महिने',
    exMonthly: '{amount} ची ठेव, {months} महिने किंवा अधिक',
    exDouble: '{amount} ची एकदाच ठेव',
    atMaturity: 'मुदतपूर्तीला',
    everyMonth: 'दरमहा',
    inMonths: '{months} महिन्यांत',
    interest: 'मिळणारे व्याज',
    invested: 'तुमची गुंतवणूक',
    exNote: 'सध्याच्या मंजूर दराने मोजलेले. आकडे अंदाजे आहेत; टीडीएस लागू होऊ शकतो.',
    ladder: 'मुदतीनुसार व्याजदर',
    regular: 'सर्वसाधारण',
    special: 'विशेष गट',
    specialWho: 'विशेष गट:',
    featEyebrow: 'वैशिष्ट्ये',
    featTitle: 'तुम्हाला काय',
    featAccent: 'मिळते',
    who: 'कोण गुंतवणूक करू शकते?',
    docs: 'आवश्यक कागदपत्रे',
    calcEyebrow: 'कॅल्क्युलेटर',
    calcTitle: 'तुमचा परतावा',
    calcAccent: 'मोजा',
    bookEyebrow: 'ही ठेव करा',
    bookTitle: 'आम्ही तुम्हाला',
    bookAccent: 'कॉल करू',
    bookText: 'तुमची माहिती द्या; {name} साठी आमची टीम तुम्हाला कॉल करेल. तुम्ही कोणत्याही शाखेतही येऊ शकता.',
    formTitle: 'कॉल करण्याची विनंती',
    formSubmit: 'विनंती पाठवा',
    applyOnline: 'पूर्ण अर्ज भरायचा आहे?',
    applyLink: 'ठेव अर्ज भरा',
    othersEyebrow: 'इतर योजना',
    othersTitle: 'इतर ठेवींशी',
    othersAccent: 'तुलना करा',
    allSchemes: 'सर्व योजना',
  },
);

const rupees = (n: number) => `₹${new Intl.NumberFormat('en-IN', { maximumFractionDigits: 0 }).format(Math.round(n))}`;
const decimals = (r: number) => (fmtRate(r).includes('.') ? 2 : 0);

// The worked example uses the same formula and approved rate as the calculator.
const calc = compute(s.calc.mode, s.calc.amount, s.calc.rate, s.calc.months);
const example =
  s.kind === 'double'
    ? { line: c('exDouble', { amount: rupees(s.calc.amount) }), value: s.calc.amount * 2, after: c('inMonths', { months: s.calc.months }), interest: s.calc.amount }
    : s.calc.mode === 'monthly'
      ? { line: c('exMonthly', { amount: rupees(s.calc.amount), months: s.calc.months }), value: calc.result, after: c('everyMonth'), interest: null }
      : {
          line: c(s.calc.mode === 'rd' ? 'exRd' : 'exFd', { amount: rupees(s.calc.amount), months: s.calc.months }),
          value: calc.result,
          after: c('atMaturity'),
          interest: calc.b2,
        };

const isFlagshipFd = s.slug === 'vishwamangal-fixed-deposit-scheme';
const slabMax = Math.max(...fdSlabs.map((r) => r.special));
const slabMin = Math.min(...fdSlabs.map((r) => r.regular));
const bar = (r: number) => Math.round(26 + ((r - slabMin) / (slabMax - slabMin || 1)) * 74);

const others = schemes.filter((o) => o.slug !== s.slug);
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'FinancialProduct',
  name: s.name,
  description: s.pitch,
  provider: { '@type': 'FinancialService', name: site.legalName },
  ...(s.rate !== null ? { interestRate: s.rate } : {}),
};
---

<Base title={s.name} description={c('metaDescription', { name: s.name, pitch: s.pitch, kind })} image={s.image} jsonLd={productLd}>
  <!-- BANNER: a photo on the right, the scheme and its approved rate on the left -->
  <section class:list={['sd-hero', { 'sd-hero--own': ownBanner }]}>
    <img src={banner} alt="" class="sd-hero__img" width="1672" height="941" fetchpriority="high" />
    <div class="container">
      <nav class="sd-crumbs" aria-label={t('breadcrumb')}>
        <a href={l('/')}>{t('home')}</a>
        <Icon name="chevron-right" size={14} />
        <a href={l('/deposits/')}>{t('nav.deposits')}</a>
        <Icon name="chevron-right" size={14} />
        <span aria-current="page">{s.name}</span>
      </nav>
      <div class="sd-hero__copy">
        <span class="sd-chip">{kind}</span>
        <h1 class="h1 sd-hero__title" data-reveal>{s.name}</h1>
        {lang === 'en' && <p class="sd-hero__mr" lang="mr">{s.nameMr}</p>}
        <div class="sd-hero__rate" transition:name={`rate-${s.slug}`} data-reveal style="--d:120ms">
          <p class="sd-hero__value">
            {s.rate !== null
              ? <><span data-count={s.rate} data-decimals={decimals(s.rate)}>{fmtRate(s.rate)}</span><small>%</small></>
              : <><span>2</span><small>×</small></>}
          </p>
          <p class="sd-hero__note">{s.rateNote}</p>
        </div>
        <p class="lead sd-hero__pitch" data-reveal style="--d:200ms">{s.pitch}</p>
        <dl class="sd-hero__facts" data-stagger>
          {s.highlight.slice(0, 3).map((h) => <div><dt>{h.label}</dt><dd>{h.value}</dd></div>)}
        </dl>
        <div class="btn-row" data-reveal style="--d:300ms">
          <a href={applyHref} class="btn btn--primary btn--lg">{c('book')} <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
          <a href="#calculator" class="btn btn--ghost btn--lg"><Icon name="calculator" size={18} /> {c('calculate')}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- AT A GLANCE: the scheme's facts as a passbook page, next to a worked example -->
  <section class="section sd-glance">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{c('keyEyebrow')}</p>
        <h2 class="h2">{c('keyTitle')} <em>{c('keyAccent')}</em></h2>
      </div>
      <div class="sd-glance__grid">
        <div class="sd-book" data-reveal="left">
          <p class="sd-intro">{s.intro}</p>
          <dl class="sd-facts">
            {s.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
          </dl>
        </div>
        <div class="sd-side" data-reveal="right">
          <div class="sd-example">
            <p class="sd-example__kicker">{c('example')}</p>
            <p class="sd-example__line">{example.line}</p>
            <p class="sd-example__value"><span data-count={Math.round(example.value)} data-prefix="₹">{rupees(example.value)}</span></p>
            <p class="sd-example__after">{example.after}</p>
            {example.interest !== null && (
              <p class="sd-example__split"><span>{c('interest')}</span><strong>{rupees(example.interest)}</strong></p>
            )}
            <p class="sd-example__note">{c('exNote')}</p>
          </div>

          {isFlagshipFd && (
            <figure class="sd-ladder" aria-label={c('ladder')}>
              <figcaption class="sd-ladder__title">
                {c('ladder')}
                <span><i class="sd-key sd-key--r"></i>{c('regular')} <i class="sd-key sd-key--s"></i>{c('special')}</span>
              </figcaption>
              <ol class="sd-ladder__rows">
                {fdSlabs.map((r, i) => (
                  <li style={`--i:${i}`}>
                    <span class="sd-ladder__tenure">{r.tenure}</span>
                    <span class="sd-ladder__bars">
                      <span class="sd-ladder__bar sd-ladder__bar--r" style={`--w:${bar(r.regular)}%`}><b>{fmtRate(r.regular)}%</b></span>
                      <span class="sd-ladder__bar sd-ladder__bar--s" style={`--w:${bar(r.special)}%`}><b>{fmtRate(r.special)}%</b></span>
                    </span>
                  </li>
                ))}
              </ol>
              <p class="sd-ladder__who"><strong>{c('specialWho')}</strong> {specialCategories}</p>
            </figure>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES, ELIGIBILITY, DOCUMENTS -->
  <section class="section sd-features-sec">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{c('featEyebrow')}</p>
        <h2 class="h2">{c('featTitle')} <em>{c('featAccent')}</em></h2>
      </div>
      <ol class="sd-features" data-stagger>
        {s.features.map((f, i) => (
          <li><span class="sd-features__n">{String(i + 1).padStart(2, '0')}</span><span>{f}</span></li>
        ))}
      </ol>
      <div class="sd-two">
        <div class="sd-card" data-reveal="left">
          <h3 class="sd-card__title">{c('who')}</h3>
          <p>{s.eligibility}</p>
        </div>
        <div class="sd-card sd-card--docs" data-reveal="right">
          <h3 class="sd-card__title">{c('docs')}</h3>
          <ul class="check-list">{depositDocuments.map((d) => <li>{d}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CALCULATOR -->
  <section class="section sd-calc" id="calculator">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">{c('calcEyebrow')}</p>
        <h2 class="h2">{c('calcTitle')} <em>{c('calcAccent')}</em></h2>
      </div>
      <div data-reveal="zoom">
        <Calculator mode={s.calc.mode} amount={s.calc.amount} rate={s.calc.rate} months={s.calc.months} only={[s.calc.mode]} />
      </div>
    </div>
  </section>

  <!-- BOOK -->
  <section class="section sd-book-sec">
    <div class="container split">
      <div class="stack" style="--stack:1.2rem">
        <p class="eyebrow" data-reveal>{c('bookEyebrow')}</p>
        <h2 class="h2" data-reveal>{c('bookTitle')} <em>{c('bookAccent')}</em></h2>
        <p class="lead" data-reveal>{c('bookText', { name: s.name })}</p>
        <ol class="sd-benefits" data-stagger>
          {depositBenefits.map((b, i) => (
            <li><span>{String(i + 1).padStart(2, '0')}</span><div><strong>{b.title}</strong><small>{b.text}</small></div></li>
          ))}
        </ol>
        <p class="sd-apply" data-reveal>{c('applyOnline')} <a href={applyHref} class="link-arrow">{c('applyLink')} <Icon name="arrow-right" size={15} /></a></p>
      </div>
      <div data-reveal="right">
        <EnquiryForm variant="callback" title={c('formTitle')} submitLabel={c('formSubmit')} preset={englishName} />
      </div>
    </div>
  </section>

  <!-- OTHER PLANS -->
  <section class="section sd-others">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div class="section-head__text">
          <p class="eyebrow">{c('othersEyebrow')}</p>
          <h2 class="h2">{c('othersTitle')} <em>{c('othersAccent')}</em></h2>
        </div>
        <a href={l('/deposits/')} class="btn btn--ghost">{c('allSchemes')} <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
      </div>
      <ul class="sd-plans" data-stagger>
        {others.map((o) => (
          <li>
            <a href={l(`/deposits/${o.slug}/`)}>
              <span class="sd-plans__rate">{o.rate !== null ? `${fmtRate(o.rate)}%` : '2×'}</span>
              <span class="sd-plans__text"><strong>{o.name}</strong><small>{o.pitch}</small></span>
              <Icon name="arrow-right" size={18} class="sd-plans__go" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ---------- Banner ---------- */
  .sd-hero {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: clamp(560px, 76vh, 720px); display: flex; flex-direction: column;
    padding: clamp(32px, 5vw, 56px) 0 clamp(48px, 6vw, 80px); background: #fff8f0;
  }
  .sd-hero > .container { flex: 1; display: flex; flex-direction: column; }
  .sd-hero__img {
    position: absolute; inset: 0 0 0 30%; z-index: -2; width: 70%; height: 100%; max-width: none;
    object-fit: cover; object-position: 60% 40%;
    animation: sd-settle 14s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes sd-settle { from { transform: scale(1.1); } }
  /* Cream on the left for the words, fading into the photo. */
  .sd-hero::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(90deg, #fff8f0 0%, #fff8f0 34%, rgb(255 248 240 / 0.86) 46%, rgb(255 248 240 / 0.15) 66%, transparent 80%);
  }
  .sd-crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 0.86rem; font-weight: 600; color: var(--muted); }
  .sd-crumbs a { color: var(--g-700); }
  .sd-crumbs a:hover { color: var(--o-700); }
  .sd-crumbs span { color: var(--o-700); }
  .sd-hero__copy { margin-block: auto; padding-top: clamp(24px, 4vw, 40px); max-width: 600px; display: grid; gap: 14px; justify-items: start; }
  .sd-chip { padding: 6px 13px; border-radius: 999px; background: var(--g-700); color: #fff; font-size: 0.8rem; font-weight: 700; }
  .sd-hero__title { color: var(--g-900); }
  .sd-hero__mr { margin-top: -4px; font-size: 1.15rem; font-weight: 700; color: var(--o-600); }
  .sd-hero__rate { display: flex; align-items: flex-end; gap: 14px; flex-wrap: wrap; }
  .sd-hero__value { display: flex; align-items: flex-start; line-height: 0.85; color: var(--o-600); }
  .sd-hero__value span { font-size: clamp(4.2rem, 9vw, 6.4rem); font-weight: 800; letter-spacing: -0.05em; font-variant-numeric: tabular-nums; }
  .sd-hero__value small { margin: 6px 0 0 4px; font-size: clamp(2rem, 3.6vw, 2.6rem); font-weight: 800; color: var(--gold); }
  .sd-hero__note { padding-bottom: 8px; font-weight: 700; color: var(--g-800); max-width: 200px; line-height: 1.35; }
  .sd-hero__pitch { color: var(--ink-2); }
  .sd-hero__facts { margin: 2px 0 6px; display: flex; flex-wrap: wrap; gap: 12px 0; padding-top: 14px; border-top: 1px solid rgb(201 169 120 / 0.5); }
  .sd-hero__facts > div { padding: 0 20px; border-left: 1px solid rgb(201 169 120 / 0.5); }
  .sd-hero__facts > div:first-child { padding-left: 0; border-left: 0; }
  .sd-hero__facts dt { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--o-700); }
  :global(html[lang='mr']) .sd-hero__facts dt { letter-spacing: 0; text-transform: none; font-size: 0.82rem; }
  .sd-hero__facts dd { margin: 3px 0 0; font-size: 1.05rem; font-weight: 800; color: var(--g-800); font-variant-numeric: tabular-nums; }
  /* Scheme banners are composed with an empty left side, so they fill the whole band. */
  .sd-hero--own .sd-hero__img { inset: 0; width: 100%; object-position: 100% 50%; }
  .sd-hero--own::after { background: linear-gradient(90deg, #fff8f0 0%, #fff8f0 30%, rgb(255 248 240 / 0.8) 40%, rgb(255 248 240 / 0) 52%); }
  .sd-hero--own .sd-hero__rate {
    padding: 8px 16px 8px 12px; border-radius: 999px; gap: 8px; align-items: baseline;
    background: #fff; border: 1px solid var(--o-200); box-shadow: 0 10px 24px -16px rgb(120 60 10 / 0.5);
  }
  .sd-hero--own .sd-hero__value { line-height: 1; }
  .sd-hero--own .sd-hero__value span { font-size: 1.6rem; letter-spacing: -0.02em; }
  .sd-hero--own .sd-hero__value small { margin: 0 0 0 1px; font-size: 1.1rem; color: var(--o-600); }
  .sd-hero--own .sd-hero__note { padding: 0; max-width: none; font-size: 0.92rem; }
  @media (min-width: 900px) and (max-width: 1199px) {
    .sd-hero--own .sd-hero__img { object-position: 100% 50%; }
    .sd-hero--own::after { background: linear-gradient(90deg, #fff8f0 0%, #fff8f0 38%, rgb(255 248 240 / 0.8) 46%, rgb(255 248 240 / 0) 58%); }
    .sd-hero--own .sd-hero__copy { max-width: 430px; }
  }
  @media (max-width: 899px) {
    .sd-hero { min-height: 0; padding-top: 18px; }
    .sd-hero__img { inset: 0 0 auto 0; width: 100%; height: min(64vw, 320px); }
    .sd-hero::after { background: linear-gradient(180deg, rgb(255 248 240 / 0.55) 0, rgb(255 248 240 / 0) 70px, rgb(255 248 240 / 0) calc(min(64vw, 320px) - 120px), #fff8f0 min(64vw, 320px)); }
    .sd-hero__copy { padding-top: calc(min(64vw, 320px) - 60px); }
    .sd-hero--own .sd-hero__img { inset: 0 0 auto 0; width: 100%; height: min(78vw, 380px); object-position: 96% 50%; }
    .sd-hero--own::after { background: linear-gradient(180deg, rgb(255 248 240 / 0.5) 0, rgb(255 248 240 / 0) 60px, rgb(255 248 240 / 0) calc(min(78vw, 380px) - 70px), #fff8f0 min(78vw, 380px)); }
    .sd-hero--own .sd-hero__copy { padding-top: calc(min(78vw, 380px) - 30px); }
  }
  @media (max-width: 479px) {
    .sd-hero__facts > div { padding: 0 12px; }
    .sd-hero__facts dd { font-size: 0.92rem; }
  }

  /* ---------- At a glance ---------- */
  .sd-glance { background: var(--surface); }
  .sd-glance__grid { display: grid; gap: clamp(20px, 3vw, 32px); align-items: start; }
  @media (min-width: 960px) { .sd-glance__grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); } }
  .sd-book {
    padding: clamp(24px, 3.5vw, 40px); border-radius: var(--r-lg); background: #fbf6ee; border: 1px solid #ecdfc8;
  }
  .sd-intro { font-size: clamp(1.02rem, 1.4vw, 1.12rem); line-height: 1.75; color: var(--ink-2); }
  .sd-facts { margin: 22px 0 0; display: grid; }
  .sd-facts div { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 13px 2px; border-top: 1px dashed #d8cbb6; }
  .sd-facts dt { color: var(--muted); font-weight: 600; font-size: 0.95rem; }
  .sd-facts dd { margin: 0; text-align: right; font-weight: 700; color: var(--g-800); font-variant-numeric: tabular-nums; }
  .sd-side { display: grid; gap: 18px; }
  .sd-example {
