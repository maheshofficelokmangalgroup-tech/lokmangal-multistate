---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { siteData, jobOpenings as jobsEn } from '../../data/site';
import { branchesData } from '../../data/branches';
import { getLang, langPaths, localePath } from '../../i18n';
import { pageCopy, useT } from '../../i18n/ui';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

export function getStaticPaths() {
  return langPaths();
}

const lang = getLang(Astro);
const t = useT(lang);
const l = (p: string) => localePath(p, lang);
const { site, jobOpenings, gallery } = siteData(lang);
const { branchCount, divisions } = branchesData(lang);

const c = pageCopy(
  lang,
  'careers',
  {
    metaTitle: 'Careers',
    metaDescription: 'Build your career with Lokmangal Multistate Co-operative Society: roles in business development, account management, relationship management and IT across Maharashtra and Karnataka.',
    eyebrow: 'Careers at Lokmangal',
    title: 'Build a career',
    accent: 'that matters',
    lead: 'Looking for work that motivates you, challenges you and helps you grow? Join the team that serves farmers, families and small businesses across Maharashtra and Karnataka.',
    seeRoles: 'See open roles',
    emailCv: 'Email your résumé',
    factRoles: 'roles open',
    factBranches: 'branches',
    factDivisions: 'divisions',
    whyEyebrow: 'Why join us',
    whyTitle: 'More than a job,',
    whyAccent: 'a purpose',
    w1: 'Learn from the best',
    w1t: 'Work alongside experienced people in the co-operative sector and learn on the job.',
    w2: 'Grow with us',
    w2t: 'A growing network of branches means real chances to take on more responsibility.',
    w3: 'Make a difference',
    w3t: 'Your work directly supports farmers, families and small businesses.',
    w4: 'A lively team',
    w4t: 'A warm, close-knit team that celebrates its successes together.',
    rolesEyebrow: 'Roles we hire for',
    rolesTitle: 'Find your',
    rolesAccent: 'place with us',
    rolesLead: 'Openings are announced on this page and at our branches. You are welcome to apply for any of these roles at any time.',
    applyRole: 'Apply for this role',
    lifeEyebrow: 'Life at Lokmangal',
    lifeTitle: 'Days we',
    lifeAccent: 'spend together',
    stepsEyebrow: 'How to apply',
    stepsTitle: 'Three simple',
    stepsAccent: 'steps',
    s1: 'Fill in the form',
    s1t: 'Tell us about yourself and the role you want, using the form below.',
    s2: 'Email your résumé',
    s2t: 'Send your résumé to {email}, with the role in the subject line.',
    s3: 'Hear from HR',
    s3t: 'Our HR team will get in touch if your profile matches an opening.',
    formEyebrow: 'Apply now',
    formTitle: 'Send us your',
    formAccent: 'application',
    formLead: 'Fill in the form and email your résumé to {email}.',
    good1: 'Experience in a financial institution is an advantage',
    good2: 'Openings across divisions in Maharashtra and Karnataka',
    good3: 'Head office: {address}',
    copy: 'Copy',
    copied: 'Copied',
    formCard: 'Job application',
    formSubmit: 'Submit application',
  },
  {
    metaTitle: 'करिअर',
    metaDescription: 'लोकमंगल मल्टीस्टेट को-ऑपरेटिव्ह सोसायटीत करिअर घडवा: महाराष्ट्र आणि कर्नाटकात बिझनेस डेव्हलपमेंट, अकाउंट मॅनेजमेंट, रिलेशनशिप मॅनेजमेंट आणि आयटी क्षेत्रातील संधी.',
    eyebrow: 'लोकमंगलमध्ये करिअर',
    title: 'अर्थपूर्ण',
    accent: 'करिअर घडवा',
    lead: 'तुम्हाला प्रेरणा देणारे, आव्हान देणारे आणि पुढे नेणारे काम हवे आहे? महाराष्ट्र आणि कर्नाटकातील शेतकरी, कुटुंबे आणि लघु व्यवसायांची सेवा करणाऱ्या आमच्या टीममध्ये सामील व्हा.',
    seeRoles: 'उपलब्ध पदे पाहा',
    emailCv: 'तुमचा बायोडेटा ईमेल करा',
    factRoles: 'पदे उपलब्ध',
    factBranches: 'शाखा',
    factDivisions: 'विभाग',
    whyEyebrow: 'आमच्यासोबत का?',
    whyTitle: 'फक्त नोकरी नाही,',
    whyAccent: 'एक ध्येय',
    w1: 'अनुभवी लोकांकडून शिका',
    w1t: 'सहकार क्षेत्रातील अनुभवी लोकांसोबत काम करा आणि कामातूनच शिका.',
    w2: 'आमच्यासोबत प्रगती करा',
    w2t: 'वाढत्या शाखांच्या जाळ्यामुळे जास्त जबाबदारी घेण्याच्या खऱ्या संधी.',
    w3: 'बदल घडवा',
    w3t: 'तुमचे काम थेट शेतकरी, कुटुंबे आणि लघु व्यवसायांना आधार देते.',
    w4: 'उत्साही टीम',
    w4t: 'यश एकत्र साजरे करणारी आपुलकीची, जवळची टीम.',
    rolesEyebrow: 'आम्ही भरती करतो ती पदे',
    rolesTitle: 'आमच्यासोबत',
    rolesAccent: 'तुमची जागा शोधा',
    rolesLead: 'रिक्त पदे या पानावर आणि आमच्या शाखांमध्ये जाहीर केली जातात. यापैकी कोणत्याही पदासाठी तुम्ही केव्हाही अर्ज करू शकता.',
    applyRole: 'या पदासाठी अर्ज करा',
    lifeEyebrow: 'लोकमंगलमधील दिवस',
    lifeTitle: 'आम्ही एकत्र',
    lifeAccent: 'घालवलेले क्षण',
    stepsEyebrow: 'अर्ज कसा करावा',
    stepsTitle: 'फक्त तीन',
    stepsAccent: 'पायऱ्या',
    s1: 'फॉर्म भरा',
    s1t: 'खालील फॉर्ममध्ये तुमची माहिती आणि हवे असलेले पद सांगा.',
    s2: 'बायोडेटा ईमेल करा',
    s2t: 'तुमचा बायोडेटा {email} वर पाठवा, विषयात पदाचे नाव लिहा.',
    s3: 'एचआरकडून संपर्क',
    s3t: 'तुमची माहिती एखाद्या रिक्त पदाशी जुळल्यास आमची एचआर टीम तुमच्याशी संपर्क करेल.',
    formEyebrow: 'आत्ताच अर्ज करा',
    formTitle: 'तुमचा',
    formAccent: 'अर्ज पाठवा',
    formLead: 'फॉर्म भरा आणि तुमचा बायोडेटा {email} वर ईमेल करा.',
    good1: 'वित्तीय संस्थेतील अनुभव असल्यास प्राधान्य',
    good2: 'महाराष्ट्र आणि कर्नाटकातील विभागांमध्ये संधी',
    good3: 'मुख्य कार्यालय: {address}',
    copy: 'कॉपी',
    copied: 'कॉपी झाले',
    formCard: 'नोकरीसाठी अर्ज',
    formSubmit: 'अर्ज पाठवा',
  },
);

const hasFile = (p: string) => existsSync(join(process.cwd(), 'public', p));
const banner = hasFile('/images/careers/banner.webp') ? '/images/careers/banner.webp' : '/images/branches/banner.webp';
const why = [1, 2, 3, 4].map((n) => ({ title: c(`w${n}` as 'w1'), text: c(`w${n}t` as 'w1t') }));
// English titles go to the form's position list, so the office always receives the same names.
const roles = jobOpenings.map((j, i) => ({ ...j, value: jobsEn[i]?.title ?? j.title, place: j.location }));
// Real photos of the team, from the gallery.
const life = ['/images/gallery/gallery-06.webp', '/images/gallery/gallery-01.webp', '/images/gallery/gallery-08.webp']
  .map((src) => gallery.find((g) => g.src === src))
  .filter((g): g is { src: string; caption: string } => !!g);
const mail = `<a href="mailto:${site.hrEmail}" class="text-green"><strong>${site.hrEmail}</strong></a>`;
const steps = [1, 2, 3].map((n) => ({ title: c(`s${n}` as 's1'), text: c(`s${n}t` as 's1t', { email: mail }) }));
const address = `${site.address.line1}, ${site.address.line2}, ${site.address.city}`;
---

<Base title={c('metaTitle')} description={c('metaDescription')}>
  <!-- BANNER -->
  <section class="cr-hero">
    <img src={banner} alt="" class="cr-hero__img" width="1920" height="1080" fetchpriority="high" />
    <div class="container cr-hero__inner">
      <nav class="cr-crumbs" aria-label={t('breadcrumb')}>
        <a href={l('/')}>{t('home')}</a>
        <Icon name="chevron-right" size={14} />
        <span aria-current="page">{c('metaTitle')}</span>
      </nav>
      <div class="cr-hero__copy">
        <p class="cr-hero__eyebrow">{c('eyebrow')}</p>
        <h1 class="h1 cr-hero__title" data-reveal>{c('title')} <em>{c('accent')}</em></h1>
        <p class="lead cr-hero__lead" data-reveal style="--d:120ms">{c('lead')}</p>
        <div class="btn-row" data-reveal style="--d:200ms">
          <a href="#roles" class="btn btn--primary btn--lg">{c('seeRoles')} <Icon name="arrow-down" size={18} /></a>
          <a href={`mailto:${site.hrEmail}`} class="btn btn--light btn--lg">{c('emailCv')}</a>
        </div>
        <dl class="cr-facts" data-stagger>
          <div><dt>{c('factRoles')}</dt><dd><span data-count={roles.length}>{roles.length}</span></dd></div>
          <div><dt>{c('factBranches')}</dt><dd><span data-count={branchCount}>{branchCount}</span></dd></div>
          <div><dt>{c('factDivisions')}</dt><dd><span data-count={divisions.length}>{divisions.length}</span></dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- WHY: four tiles in a checkerboard of cream and green -->
  <section class="section cr-why">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{c('whyEyebrow')}</p>
        <h2 class="h2">{c('whyTitle')} <em>{c('whyAccent')}</em></h2>
      </div>
      <ol class="cr-why__grid" data-stagger>
        {why.map((w, i) => (
          <li class:list={['cr-why__tile', { 'cr-why__tile--dark': i % 2 === 1 }]}>
            <span class="cr-why__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ROLES: a job board -->
  <section class="section cr-roles" id="roles">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div class="section-head__text">
          <p class="eyebrow">{c('rolesEyebrow')}</p>
          <h2 class="h2">{c('rolesTitle')} <em>{c('rolesAccent')}</em></h2>
        </div>
        <p class="lead cr-roles__lead">{c('rolesLead')}</p>
      </div>
      <ol class="cr-board" data-stagger>
        {roles.map((r, i) => (
          <li class="cr-job">
            <span class="cr-job__n">{String(i + 1).padStart(2, '0')}</span>
            <div class="cr-job__main">
              <h3 class="cr-job__title">{r.title}</h3>
              <p class="cr-job__text">{r.text}</p>
            </div>
            {r.place ? <p class="cr-job__place">{r.place}</p> : <span aria-hidden="true"></span>}
            <a href="#apply" class="cr-job__apply" data-role={r.value}>{c('applyRole')} <Icon name="arrow-right" size={16} /></a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- LIFE: real photos of the team -->
  {life.length > 0 && (
    <section class="section cr-life">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">{c('lifeEyebrow')}</p>
          <h2 class="h2">{c('lifeTitle')} <em>{c('lifeAccent')}</em></h2>
        </div>
        <ul class="cr-life__grid" data-stagger>
          {life.map((g, i) => (
            <li class:list={['cr-life__item', `cr-life__item--${i}`]}>
              <img src={g.src} alt={g.caption} width="1400" height="1050" loading="lazy" />
              <span class="cr-life__cap">{g.caption}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- STEPS -->
  <section class="section cr-steps-sec">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">{c('stepsEyebrow')}</p>
        <h2 class="h2">{c('stepsTitle')} <em>{c('stepsAccent')}</em></h2>
      </div>
      <ol class="cr-steps">
        <span class="cr-steps__line" aria-hidden="true"></span>
        {steps.map((s, i) => (
          <li data-reveal style={`--d:${i * 140}ms`}>
            <span class="cr-steps__n">{i + 1}</span>
            <h3>{s.title}</h3>
            <p set:html={s.text} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- APPLY -->
  <section class="section cr-apply" id="apply">
    <div class="container split">
      <div class="stack" style="--stack:1.2rem" data-reveal>
        <p class="eyebrow">{c('formEyebrow')}</p>
        <h2 class="h2">{c('formTitle')} <em>{c('formAccent')}</em></h2>
        <p class="lead" set:html={c('formLead', { email: mail })} />
        <div class="cr-mail">
          <span class="cr-mail__addr">{site.hrEmail}</span>
          <button type="button" class="cr-mail__copy" data-copy={site.hrEmail} data-done={c('copied')}>{c('copy')}</button>
        </div>
        <ul class="cr-good">
          <li>{c('good1')}</li>
          <li>{c('good2')}</li>
          <li>{c('good3', { address })}</li>
        </ul>
      </div>
      <div data-reveal="right"><EnquiryForm variant="career" title={c('formCard')} submitLabel={c('formSubmit')} /></div>
    </div>
  </section>
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    // "Apply for this role" chooses that role in the application form.
    const select = document.querySelector<HTMLSelectElement>('#apply select[name="position"]');
    document.querySelectorAll<HTMLAnchorElement>('[data-role]').forEach((a) =>
      a.addEventListener('click', () => {
        if (!select) return;
        select.value = a.dataset.role ?? '';
        select.dispatchEvent(new Event('change', { bubbles: true }));
        select.classList.add('is-picked');
        setTimeout(() => select.classList.remove('is-picked'), 1600);
        setTimeout(() => document.querySelector<HTMLInputElement>('#apply input[name="name"]')?.focus({ preventScroll: true }), 700);
      }),
    );
    // Copy the HR email address.
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      const label = btn.textContent ?? '';
      btn.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(btn.dataset.copy ?? ''); } catch { /* the address is on screen to copy by hand */ }
        btn.textContent = btn.dataset.done ?? label;
        btn.classList.add('is-done');
        setTimeout(() => { btn.textContent = label; btn.classList.remove('is-done'); }, 1800);
      });
    });
  });
</script>

<style>
  /* ---------- Banner ---------- */
  .cr-hero { position: relative; isolation: isolate; overflow: hidden; display: flex; min-height: clamp(560px, 76vh, 700px); color: #fff; background: var(--g-950); }
  .cr-hero__img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 72% 35%; animation: cr-settle 14s cubic-bezier(0.16, 1, 0.3, 1) both; }
  @keyframes cr-settle { from { transform: scale(1.12); } }
  .cr-hero::after {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg, rgb(4 36 23 / 0.96) 0%, rgb(4 36 23 / 0.86) 36%, rgb(4 36 23 / 0.36) 60%, rgb(4 36 23 / 0.06) 84%, transparent 100%), linear-gradient(0deg, rgb(4 36 23 / 0.55), transparent 30%);
  }
  .cr-hero__inner { display: flex; flex-direction: column; padding-block: clamp(40px, 6vw, 72px) clamp(48px, 6vw, 80px); }
  .cr-crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 0.86rem; font-weight: 600; color: rgb(255 255 255 / 0.6); }
  .cr-crumbs a { color: rgb(255 255 255 / 0.8); }
  .cr-crumbs span { color: var(--gold); }
  .cr-hero__copy { margin-block: auto; padding-top: clamp(24px, 4vw, 40px); max-width: 640px; min-width: 0; display: grid; gap: 20px; }
  .cr-hero__eyebrow { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--g-300); }
  :global(html[lang='mr']) .cr-hero__eyebrow { letter-spacing: 0; text-transform: none; font-size: 0.95rem; }
  .cr-hero__title { color: #fff; }
  .cr-hero__title em { display: block; color: var(--gold); }
  .cr-hero__lead { color: rgb(255 255 255 / 0.86); }
  .cr-facts { display: flex; flex-wrap: wrap; margin: 6px 0 0; padding-top: 18px; border-top: 1px solid rgb(255 255 255 / 0.16); }
  .cr-facts > div { display: flex; flex-direction: column-reverse; gap: 2px; padding-right: clamp(18px, 3vw, 32px); margin-right: clamp(18px, 3vw, 32px); border-right: 1px solid rgb(255 255 255 / 0.16); }
  .cr-facts > div:last-child { border-right: 0; margin-right: 0; padding-right: 0; }
  .cr-facts dd { margin: 0; font-size: clamp(2rem, 3.6vw, 2.6rem); font-weight: 800; line-height: 1; letter-spacing: -0.03em; color: var(--gold); }
  .cr-facts dt { font-size: 0.86rem; font-weight: 600; color: rgb(255 255 255 / 0.75); }
  @media (max-width: 899px) {
    .cr-hero { min-height: 0; }
    .cr-hero__img { inset: 0 0 auto 0; height: min(66vw, 320px); }
    .cr-hero::after { background: linear-gradient(180deg, rgb(4 36 23 / 0.35) 0, rgb(4 36 23 / 0.1) 80px, var(--g-950) min(66vw, 320px)); }
    .cr-hero__copy { padding-top: calc(min(66vw, 320px) - 70px); }
  }

  /* ---------- Why: checkerboard tiles ---------- */
  .cr-why { background: var(--bg); }
  .cr-why__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(12px, 1.6vw, 18px); grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .cr-why__tile {
    position: relative; display: flex; flex-direction: column; gap: 10px; min-height: 280px; padding: clamp(22px, 2.4vw, 30px);
    border-radius: var(--r-lg); background: #fff; border: 1px solid var(--line-2); overflow: hidden;
    transition: transform 0.45s var(--ease-out), box-shadow 0.45s var(--ease-out);
  }
  .cr-why__tile::after { content: ''; position: absolute; inset: auto 0 0 0; height: 4px; background: var(--o-500); transform: scaleX(0); transform-origin: left; transition: transform 0.5s var(--ease-out); }
  .cr-why__tile:hover { transform: translateY(-6px); box-shadow: 0 30px 50px -34px rgb(5 42 26 / 0.55); }
  .cr-why__tile:hover::after { transform: scaleX(1); }
  .cr-why__n { margin-bottom: auto; font-size: clamp(2.6rem, 4vw, 3.4rem); font-weight: 800; line-height: 1; letter-spacing: -0.04em; color: transparent; -webkit-text-stroke: 1.5px var(--o-500); }
  .cr-why__tile h3 { margin-top: 28px; font-size: 1.16rem; line-height: 1.3; color: var(--g-900); }
  .cr-why__tile p { font-size: 0.93rem; color: var(--muted); }
  .cr-why__tile--dark { background: var(--g-900); border-color: var(--g-900); }
  .cr-why__tile--dark .cr-why__n { -webkit-text-stroke-color: var(--gold); }
  .cr-why__tile--dark h3 { color: #fff; }
  .cr-why__tile--dark p { color: rgb(255 255 255 / 0.75); }
  .cr-why__tile--dark::after { background: var(--gold); }
  @media (max-width: 999px) { .cr-why__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .cr-why__tile { min-height: 230px; } }
  @media (max-width: 519px) {
    .cr-why__grid { grid-template-columns: 1fr; }
    .cr-why__tile { min-height: 0; display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 18px; row-gap: 4px; }
    .cr-why__n { grid-row: span 2; margin: 0; font-size: 2.4rem; }
    .cr-why__tile h3 { margin-top: 2px; }
  }

  /* ---------- Roles: job board ---------- */
  .cr-roles { background: var(--surface); scroll-margin-top: var(--header-h); }
  .cr-roles__lead { max-width: 460px; }
  .cr-board { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--g-900); }
  .cr-job {
    position: relative; display: grid; grid-template-columns: 3rem minmax(0, 1fr) auto auto; gap: 8px 28px; align-items: center;
    padding: 26px 18px; border-bottom: 1px solid var(--line); transition: background 0.3s;
  }
  .cr-job::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--o-500); transform: scaleY(0); transform-origin: top; transition: transform 0.4s var(--ease-out); }
