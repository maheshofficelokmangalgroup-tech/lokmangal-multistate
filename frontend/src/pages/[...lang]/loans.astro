---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Calculator from '../../components/Calculator.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import CtaBand from '../../components/CtaBand.astro';
import { loansData, type Loan } from '../../data/loans';
import { siteData } from '../../data/site';
import { fmtRate } from '../../data/deposits';
import { getLang, langPaths, localePath } from '../../i18n';
import { pageCopy, useT } from '../../i18n/ui';
import { compute } from '@lokmangal/finance';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

export function getStaticPaths() {
  return langPaths();
}

const lang = getLang(Astro);
const t = useT(lang);
const l = (p: string) => localePath(p, lang);
const { stats } = siteData(lang);
const { loans, loanBenefits } = loansData(lang);
const english = loansData('en').loans;

const c = pageCopy(
  lang,
  'loans',
  {
    metaTitle: 'Loans',
    metaDescription: 'Agriculture, housing, vehicle, personal, warehouse, cash credit, hypothecation, mortgage, microfinance and bachat gat loans from Lokmangal Multistate, with quick approval and little paperwork.',
    eyebrow: 'Loans',
    title: 'A loan for your',
    accent: 'farm, home or business',
    lead: 'Quick processing, little paperwork and easy repayment, from a branch team that knows your town.',
    apply: 'Apply for a loan',
    emi: 'EMI calculator',
    pause: 'Pause the changing pictures',
    play: 'Play the changing pictures',
    from: 'from {rate}%',
    catAll: 'All loans',
    catAgri: 'Farm',
    catHome: 'Home & property',
    catBusiness: 'Business',
    catPersonal: 'Personal & vehicle',
    allEyebrow: 'Our loan products',
    allTitle: 'Find the loan that',
    allAccent: 'fits you',
    filterLabel: 'Filter loans',
    interest: 'Interest',
    amount: 'Amount',
    details: 'Eligibility & documents',
    applyFor: 'Apply',
    viewDetails: 'View details',
    fromWord: 'from',
    pa: 'p.a.',
    guarantors: 'Guarantors',
    period: 'Period',
    security: 'Security',
    close: 'Close',
    sheetLead: 'Interest and amount',
    emiExample: 'Borrow {amount} for {years} years and pay about',
    emiPer: 'a month at {rate}%',
    emiNote: 'Indicative, at the lowest rate for this loan.',
    calcThis: 'Work out your EMI',
    emiEyebrow: 'EMI calculator',
    emiTitle: 'Plan your',
    emiAccent: 'repayments',
    helpEyebrow: 'Talk to us',
    helpTitle: 'Not sure which loan is',
    helpAccent: 'right for you?',
    helpText: 'Tell us what you need and a loan officer from your nearest branch will call you with options, eligibility and the documents you need.',
    help1: 'Personal guidance from a local branch team',
    help2: 'Clear rates with no hidden charges',
    help3: 'Quick processing and disbursal',
    formTitle: 'Get a callback',
    formSubtitle: 'About any loan.',
    ctaTitle: 'Turn your plans into',
    ctaAccent: 'reality',
    ctaText: 'Apply online in minutes or visit any of our {branches} branches. Our team will help you every step of the way.',
  },
  {
    metaTitle: 'कर्ज',
    metaDescription: 'लोकमंगल मल्टीस्टेटकडून शेती, गृह, वाहन, वैयक्तिक, वखार, कॅश क्रेडिट, हायपोथिकेशन, तारण, सूक्ष्म वित्त आणि बचत गट कर्ज; जलद मंजुरी आणि कमी कागदपत्रे.',
    eyebrow: 'कर्ज',
    title: 'कर्ज तुमच्या',
    accent: 'शेती, घर किंवा व्यवसायासाठी',
    lead: 'जलद प्रक्रिया, कमी कागदपत्रे आणि सोपी परतफेड; तुमच्या गावाची जाण असलेल्या शाखा टीमकडून.',
    apply: 'कर्जासाठी अर्ज करा',
    emi: 'हप्ता (EMI) कॅल्क्युलेटर',
    pause: 'बदलणारी चित्रे थांबवा',
    play: 'बदलणारी चित्रे सुरू करा',
    from: '{rate}% पासून',
    catAll: 'सर्व कर्ज',
    catAgri: 'शेती',
    catHome: 'घर व मालमत्ता',
    catBusiness: 'व्यवसाय',
    catPersonal: 'वैयक्तिक व वाहन',
    allEyebrow: 'आमच्या कर्ज योजना',
    allTitle: 'तुमच्यासाठी योग्य',
    allAccent: 'कर्ज शोधा',
    filterLabel: 'कर्ज निवडा',
    interest: 'व्याज',
    amount: 'रक्कम',
    details: 'पात्रता व कागदपत्रे',
    applyFor: 'अर्ज करा',
    viewDetails: 'तपशील पहा',
    fromWord: 'पासून',
    pa: 'वार्षिक',
    guarantors: 'जामीनदार',
    period: 'कालावधी',
    security: 'तारण',
    close: 'बंद करा',
    sheetLead: 'व्याज आणि रक्कम',
    emiExample: '{amount} कर्ज {years} वर्षांसाठी घेतल्यास हप्ता सुमारे',
    emiPer: 'दरमहा, {rate}% दराने',
    emiNote: 'अंदाजे, या कर्जाच्या सर्वात कमी दराने.',
    calcThis: 'तुमचा हप्ता मोजा',
    emiEyebrow: 'हप्ता कॅल्क्युलेटर',
    emiTitle: 'तुमच्या परतफेडीचे',
    emiAccent: 'नियोजन करा',
    helpEyebrow: 'आमच्याशी बोला',
    helpTitle: 'कोणते कर्ज योग्य आहे',
    helpAccent: 'हे ठरत नाही?',
    helpText: 'तुमची गरज सांगा; जवळच्या शाखेतील कर्ज अधिकारी पर्याय, पात्रता आणि आवश्यक कागदपत्रांसह तुम्हाला कॉल करतील.',
    help1: 'स्थानिक शाखा टीमकडून वैयक्तिक मार्गदर्शन',
    help2: 'छुपे शुल्क नसलेले स्पष्ट दर',
    help3: 'जलद प्रक्रिया आणि वितरण',
    formTitle: 'कॉल करण्याची विनंती',
    formSubtitle: 'कोणत्याही कर्जाबाबत.',
    ctaTitle: 'तुमची स्वप्ने',
    ctaAccent: 'प्रत्यक्षात आणा',
    ctaText: 'काही मिनिटांत ऑनलाइन अर्ज करा किंवा आमच्या {branches} पैकी कोणत्याही शाखेत या. प्रत्येक टप्प्यावर आमची टीम मदत करेल.',
  },
);

// Loan groups for the filter and the banner. A loan added later without a group shows under "All loans".
type Cat = 'agri' | 'home' | 'business' | 'personal';
const groupOf: Record<string, Cat> = {
  'agriculture-term-loan': 'agri',
  'warehouse-loan': 'agri',
  'housing-loan': 'home',
  'land-mortgage-loan': 'home',
  'property-mortgage-loan': 'home',
  'cash-credit': 'business',
  'hypothecation-loan': 'business',
  microfinance: 'business',
  'bachat-gat-loan': 'business',
  'vehicle-loan': 'personal',
  'personal-loan': 'personal',
};
const catLabel: Record<Cat, string> = { agri: c('catAgri'), home: c('catHome'), business: c('catBusiness'), personal: c('catPersonal') };
const cats = (Object.keys(catLabel) as Cat[]).filter((k) => loans.some((ln) => groupOf[ln.slug] === k));
const minRate = (list: Loan[]) => Math.min(...list.map((ln) => ln.rateFrom));

// Banner pictures per group: frontend/public/images/loans/banner-<group>.webp, or a site photo until then.
const fallback: Record<Cat, string> = { agri: '/images/hero/hero-1.webp', home: '/images/about/banner.webp', business: '/images/hero/hero-3.webp', personal: '/images/hero/hero-2.webp' };
const bannerFor = (k: Cat) => {
  const own = `/images/loans/banner-${k}.webp`;
  return existsSync(join(process.cwd(), 'public', own)) ? { src: own, own: true } : { src: fallback[k], own: false };
};
const slides = cats.map((k) => ({ k, label: catLabel[k], rate: minRate(loans.filter((ln) => groupOf[ln.slug] === k)), ...bannerFor(k) }));

const englishName = (slug: string) => english.find((e) => e.slug === slug)?.name ?? slug;
// A second fact for each card, found by the English label so it works in both languages.
const fact = (ln: Loan, label: string) => {
  const i = english.find((e) => e.slug === ln.slug)?.details.findIndex(([k]) => k === label) ?? -1;
  return i >= 0 ? ln.details[i] : null;
};
const secondFact = (ln: Loan) => fact(ln, 'Guarantors') ?? fact(ln, 'Period') ?? fact(ln, 'Security');
// Term loans repaid in monthly instalments get a worked EMI example (₹1 lakh over 3 years).
const emiLoans = new Set(['agriculture-term-loan', 'housing-loan', 'vehicle-loan', 'personal-loan', 'warehouse-loan', 'land-mortgage-loan', 'property-mortgage-loan']);
const rupees = (n: number) => `₹${new Intl.NumberFormat('en-IN', { maximumFractionDigits: 0 }).format(Math.round(n))}`;
const emiOf = (ln: Loan) => compute('emi', 100000, ln.rateFrom, 36).result;
const branches = stats.find((s) => s.prefix === '' && s.suffix === '')?.value ?? 60;
---

<Base title={c('metaTitle')} description={c('metaDescription')}>
  <!-- BANNER -->
  <section class="ln-hero" data-ln-hero>
    <div class="ln-hero__media" aria-hidden="true">
      {slides.map((s, i) => (
        <img src={s.src} alt="" class:list={['ln-hero__img', { 'is-active': i === 0, 'ln-hero__img--own': s.own }]} width="1920" height="1080" fetchpriority={i === 0 ? 'high' : 'low'} data-ln-slide />
      ))}
    </div>
    <div class="container">
      <nav class="ln-crumbs" aria-label={t('breadcrumb')}>
        <a href={l('/')}>{t('home')}</a>
        <Icon name="chevron-right" size={14} />
        <span aria-current="page">{c('eyebrow')}</span>
      </nav>
      <div class="ln-hero__copy">
        <p class="ln-hero__eyebrow">{c('eyebrow')}</p>
        <h1 class="h1 ln-hero__title" data-reveal>{c('title')} <em>{c('accent')}</em></h1>
        <p class="lead ln-hero__lead" data-reveal style="--d:120ms">{c('lead')}</p>
        <div class="ln-chips" data-reveal style="--d:200ms">
          {slides.map((s, i) => (
            <a href={`${l('/loans/')}?type=${s.k}#products`} class:list={['ln-chip', { 'is-active': i === 0 }]} data-ln-chip={i}>
              <span>{s.label}</span>
              <strong>{c('from', { rate: fmtRate(s.rate) })}</strong>
            </a>
          ))}
          {slides.length > 1 && (
            <button type="button" class="ln-toggle" data-ln-toggle aria-pressed="false" aria-label={c('pause')} data-label-pause={c('pause')} data-label-play={c('play')}>
              <svg class="ln-toggle__pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1.2" /><rect x="14" y="5" width="4" height="14" rx="1.2" /></svg>
              <svg class="ln-toggle__play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l12-7.5z" /></svg>
            </button>
          )}
        </div>
        <div class="btn-row" data-reveal style="--d:280ms">
          <a href={l('/apply-loan/')} class="btn btn--primary btn--lg">{c('apply')} <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
          <a href="#emi" class="btn btn--ghost btn--lg"><Icon name="calculator" size={18} /> {c('emi')}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="ln-benefits-wrap">
    <div class="container">
      <ol class="ln-benefits" data-stagger>
        {loanBenefits.map((b, i) => (
          <li><span class="ln-benefits__n">{String(i + 1).padStart(2, '0')}</span><div><strong>{b.title}</strong><small>{b.text}</small></div></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section class="section ln-all" id="products">
    <div class="container">
      <div class="ln-all__head" data-reveal>
        <div>
          <p class="eyebrow">{c('allEyebrow')}</p>
          <h2 class="h2">{c('allTitle')} <em>{c('allAccent')}</em></h2>
        </div>
        <div class="ln-filters" data-filter-group="#loan-grid" role="group" aria-label={c('filterLabel')}>
          <button type="button" class="ln-filter" data-filter="all" aria-pressed="true">{c('catAll')} <span class="ln-filter__n">{loans.length}</span></button>
          {cats.map((k) => (
            <button type="button" class="ln-filter" data-filter={k} aria-pressed="false">
              {catLabel[k]} <span class="ln-filter__n">{loans.filter((ln) => groupOf[ln.slug] === k).length}</span>
            </button>
          ))}
        </div>
      </div>
      <ul class="ln-grid" id="loan-grid" data-stagger>
        {loans.map((ln) => {
          const k = groupOf[ln.slug];
          const f2 = secondFact(ln);
          return (
            <li class="ln-card" id={ln.slug} data-kind={k ?? 'other'}>
              <div class="ln-card__media">
                <img src={ln.image} alt="" width="1200" height="751" loading="lazy" />
                {k && <span class="ln-card__tag">{catLabel[k]}</span>}
                <span class="ln-card__price" aria-hidden="true">
                  {lang === 'en' && <small>{c('fromWord')}</small>}
                  <strong>{fmtRate(ln.rateFrom)}<em>%</em></strong>
                  <small>{lang === 'mr' ? c('fromWord') : c('pa')}</small>
                </span>
              </div>
              <div class="ln-card__body">
                <h3 class="ln-card__name">{ln.name}</h3>
                <p class="ln-card__summary">{ln.summary}</p>
                <dl class="ln-card__facts">
                  <div><dt>{c('interest')}</dt><dd>{ln.rate}</dd></div>
                  <div><dt>{c('amount')}</dt><dd>{ln.amount}</dd></div>
                  {f2 && <div><dt>{f2[0]}</dt><dd>{f2[1]}</dd></div>}
                </dl>
                <div class="ln-card__actions">
                  <button type="button" class="ln-card__more" data-sheet-open={ln.slug} aria-haspopup="dialog">
                    {c('viewDetails')} <Icon name="arrow-up-right" size={16} />
                  </button>
                  <a href={`${l('/apply-loan/')}?type=${encodeURIComponent(englishName(ln.slug))}`} class="ln-card__apply">{c('applyFor')} <Icon name="arrow-right" size={16} /></a>
                </div>
              </div>

              <dialog class="ln-sheet" data-sheet={ln.slug} aria-labelledby={`sheet-${ln.slug}`}>
                <div class="ln-sheet__panel">
                  <div class="ln-sheet__media">
                    <img src={ln.image} alt="" width="1200" height="751" loading="lazy" />
                    <button type="button" class="ln-sheet__close" data-sheet-close aria-label={c('close')}><Icon name="x" size={20} /></button>
                    {k && <span class="ln-card__tag">{catLabel[k]}</span>}
                  </div>
                  <div class="ln-sheet__body">
                    <h3 class="ln-sheet__title" id={`sheet-${ln.slug}`}>{ln.name}</h3>
                    <p class="ln-sheet__summary">{ln.summary}</p>
                    <div class="ln-sheet__key">
                      <div><span>{c('interest')}</span><strong>{ln.rate}</strong></div>
                      <div><span>{c('amount')}</span><strong>{ln.amount}</strong></div>
                    </div>
                    {emiLoans.has(ln.slug) && (
                      <div class="ln-sheet__emi">
                        <p>{c('emiExample', { amount: rupees(100000), years: 3 })}</p>
                        <p class="ln-sheet__emi-value"><strong>{rupees(emiOf(ln))}</strong> <span>{c('emiPer', { rate: fmtRate(ln.rateFrom) })}</span></p>
                        <small>{c('emiNote')}</small>
                      </div>
                    )}
                    <h4 class="ln-sheet__sub">{c('details')}</h4>
                    <dl class="ln-sheet__details">
                      {ln.details.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
                    </dl>
                    <div class="ln-sheet__actions">
                      <a href={`${l('/apply-loan/')}?type=${encodeURIComponent(englishName(ln.slug))}`} class="btn btn--primary">{c('applyFor')} <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
                      {emiLoans.has(ln.slug) && <button type="button" class="btn btn--ghost" data-sheet-emi={ln.rateFrom}><Icon name="calculator" size={18} /> {c('calcThis')}</button>}
                    </div>
                  </div>
                </div>
              </dialog>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- EMI -->
  <section class="section ln-emi" id="emi">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">{c('emiEyebrow')}</p>
        <h2 class="h2">{c('emiTitle')} <em>{c('emiAccent')}</em></h2>
      </div>
      <div data-reveal="zoom"><Calculator mode="emi" only={['emi']} /></div>
    </div>
  </section>

  <!-- HELP -->
  <section class="section ln-help">
    <div class="container split">
      <div class="stack" style="--stack:1.2rem">
        <p class="eyebrow" data-reveal>{c('helpEyebrow')}</p>
        <h2 class="h2" data-reveal>{c('helpTitle')} <em>{c('helpAccent')}</em></h2>
        <p class="lead" data-reveal>{c('helpText')}</p>
        <ol class="ln-points" data-stagger>
          {[c('help1'), c('help2'), c('help3')].map((p, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{p}</li>)}
        </ol>
      </div>
      <div data-reveal="right"><EnquiryForm variant="loan" title={c('formTitle')} subtitle={c('formSubtitle')} /></div>
    </div>
  </section>

  <CtaBand title={c('ctaTitle')} accent={c('ctaAccent')} text={c('ctaText', { branches })} />
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    // Loan details open in a sheet (slides in from the right, or up from the bottom on phones).
    const sheets = Array.from(document.querySelectorAll<HTMLDialogElement>('[data-sheet]'));
    const closeSheet = (d: HTMLDialogElement) => {
      if (!d.open || d.classList.contains('is-closing')) return;
      d.classList.add('is-closing');
      const done = () => { d.classList.remove('is-closing'); d.close(); };
      d.addEventListener('animationend', done, { once: true });
      setTimeout(() => d.open && done(), 450);
    };
    const openSheet = (slug: string) => {
      const d = sheets.find((s) => s.dataset.sheet === slug);
      if (!d || d.open) return;
      d.showModal();
      history.replaceState(history.state, '', `#${slug}`);
    };
    document.querySelectorAll<HTMLElement>('[data-sheet-open]').forEach((b) => b.addEventListener('click', () => openSheet(b.dataset.sheetOpen!)));
    sheets.forEach((d) => {
      d.querySelector('[data-sheet-close]')?.addEventListener('click', () => closeSheet(d));
      d.addEventListener('click', (e) => { if (e.target === d) closeSheet(d); });
      d.addEventListener('cancel', (e) => { e.preventDefault(); closeSheet(d); });
      d.addEventListener('close', () => {
        if (location.hash === `#${d.dataset.sheet}`) history.replaceState(history.state, '', location.pathname + location.search);
      });
      // "Work out your EMI": close the sheet and set the calculator below to this loan's rate.
      d.querySelector<HTMLElement>('[data-sheet-emi]')?.addEventListener('click', (e) => {
        const rate = Number((e.currentTarget as HTMLElement).dataset.sheetEmi);
        closeSheet(d);
        const emi = document.getElementById('emi');
        emi?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        emi?.querySelector('[data-calc]')?.dispatchEvent(new CustomEvent('calc:set', { detail: { ratePct: rate } }));
      });
    });
    // Links like /loans/#housing-loan (from the homepage and the menu) open that loan's details.
    const fromHash = location.hash ? decodeURIComponent(location.hash.slice(1)) : '';
    if (fromHash && sheets.some((s) => s.dataset.sheet === fromHash)) {
      document.getElementById(fromHash)?.scrollIntoView({ block: 'center' });
      setTimeout(() => openSheet(fromHash), 350);
    }

    // Banner pictures cross-fade every 5 seconds; a chip under the pointer or in focus shows its group.
    const hero = document.querySelector<HTMLElement>('[data-ln-hero]');
    if (!hero) return;
    const slides = Array.from(hero.querySelectorAll<HTMLElement>('[data-ln-slide]'));
    const chips = Array.from(hero.querySelectorAll<HTMLElement>('[data-ln-chip]'));
    if (slides.length < 2) return;
    let index = 0;
    let paused = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let holding = false;
    let visible = true;
    const show = (n: number) => {
      index = (n + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle('is-active', i === index));
      chips.forEach((c, i) => c.classList.toggle('is-active', i === index));
    };
    chips.forEach((chip, i) => {
      chip.addEventListener('pointerenter', () => { holding = true; show(i); });
      chip.addEventListener('pointerleave', () => { holding = false; });
      chip.addEventListener('focus', () => { holding = true; show(i); });
      chip.addEventListener('blur', () => { holding = false; });
    });
    const toggle = hero.querySelector<HTMLButtonElement>('[data-ln-toggle]');
    if (paused) toggle?.setAttribute('aria-pressed', 'true');
    toggle?.addEventListener('click', () => {
      paused = !paused;
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.setAttribute('aria-label', (paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) ?? '');
    });
    const io = new IntersectionObserver(([e]) => { visible = e.isIntersecting; });
    io.observe(hero);
    const timer = window.setInterval(() => { if (!paused && !holding && visible && !document.hidden) show(index + 1); }, 5000);
    document.addEventListener('astro:before-swap', () => { window.clearInterval(timer); io.disconnect(); }, { once: true });
  });
</script>

<style>
  /* ---------- Banner ---------- */
  .ln-hero {
    position: relative; isolation: isolate; overflow: hidden;
