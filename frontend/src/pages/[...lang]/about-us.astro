---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import AboutNav from '../../components/AboutNav.astro';
import { siteData } from '../../data/site';
import { peopleFor } from '../../data/people';
import { getLang, langPaths, localePath } from '../../i18n';
import { pageCopy, useT } from '../../i18n/ui';

export function getStaticPaths() {
  return langPaths();
}

const lang = getLang(Astro);
const t = useT(lang);
const l = (p: string) => localePath(p, lang);
const { site, stats, gallery } = siteData(lang);
const { chairman, mentor } = peopleFor(lang);

const c = pageCopy(
  lang,
  'about-us',
  {
    metaTitle: 'About Us',
    metaDescription: 'Lokmangal Multistate Co-operative Society Ltd. was founded in 2004 to empower farmers, small entrepreneurs and weaker sections of society. Learn about our journey, vision and values.',
    eyebrow: 'About Lokmangal',
    title: 'Growing with our members',
    accent: 'since 2004',
    lead: 'Lokmangal Multistate Co-operative Society works with farmers, small entrepreneurs, young people and families who need fair access to savings and credit.',
    findBranch: 'Find a branch',
    chairmanMsg: 'Chairman’s message',
    factSince: 'Since',
    factReg: 'Registration No.',
    factBranches: 'Branches',
    factArea: 'Serving',
    factAreaValue: 'Maharashtra & Karnataka',
    whoEyebrow: 'Who we are',
    whoTitle: 'A multi-state co-operative',
    whoAccent: 'owned by its members',
    whoP1: 'The idea of empowering people came from our mentor, {mentor}, and a group of like-minded people who joined him. Today Lokmangal Multistate serves members through branches and ATMs in the towns and villages of Maharashtra and Karnataka.',
    whoP2: 'Our motto is {motto}. We work to bring people from every walk of life into the financial mainstream, with honest dealing, clear and efficient service, trained staff and the leadership of our chairman, {chairman}.',
    motto: 'success through total dedication',
    contact: 'Get in touch',
    board: 'Board of Directors',
    videoAlt: 'Watch: Lokmangal Multistate introduction video',
    videoPlay: 'Play video',
    videoCaption: 'Watch our story',
    numbersEyebrow: 'Lokmangal in numbers',
    vision: 'Our vision',
    visionText: 'To be a forward-looking, technology-driven and customer-centric co-operative society that serves every section of society, creating value for members and employees through co-operative wealth, as we move towards a pan-India presence.',
    promise: 'Our promise',
    promiseText: 'We expect more of ourselves than anyone else expects of us. Every day we try to give our members a pleasant, rewarding experience, guided by the principles below.',
    valuesEyebrow: 'What we stand for',
    valuesTitle: 'Five principles behind',
    valuesAccent: 'every branch',
    v1: 'Trust and transparency',
    v1t: 'Every decision is taken collectively by an elected board, and our books are audited every year.',
    v2: 'Trained staff',
    v2t: 'Branch teams who know their communities and guide members at every step.',
    v3: 'Trusted network',
    v3t: 'Branches and ATMs in the towns and villages of Maharashtra and Karnataka.',
    v4: 'Digital banking',
    v4t: 'Net banking, mobile banking, UPI, IMPS, NEFT/RTGS and SMS banking.',
    v5: 'Financial inclusion',
    v5t: 'Bringing people from all walks of life into the formal financial system.',
    journeyEyebrow: 'Our journey so far',
    journeyTitle: 'From Solapur to',
    journeyAccent: 'two states',
    journeyLead: 'Lokmangal runs on co-operative principles in every part of its business.',
    j1y: '2004',
    j1: 'A society is born',
    j1t: 'Lokmangal Multistate Co-operative Society Ltd. was registered under the {act} (Registration No. {reg}), inspired by the vision of our mentor {mentor}.',
    j2y: '2008',
    j2: 'Full operations begin',
    j2t: 'Operations began in Solapur district, where most of our first members came from farming families. Our first aim was simple: give financial support to people who wanted to start or grow something of their own.',
    j3y: 'Growth',
    j3: 'Beyond financial services',
    j3t: 'Under the leadership of {chairman}, Lokmangal added dairy, with chilling plants at Mangalvedha, Karmala and Sangola, and a fertiliser business that makes biotic and chemical fertilisers and distributes IFFCO products.',
    j4y: 'Today',
    j4: 'Touching lakhs of lives',
    j4t: 'With {branches} branches in Maharashtra and Karnataka, a growing ATM network and digital channels, Lokmangal serves lakhs of members and plans to reach many more.',
    welcome: 'You are welcome to join the {family}. Together we can build stronger communities on co-operative principles.',
    family: 'Lokmangal family',
    momentsEyebrow: 'Moments',
    momentsTitle: 'Life at',
    momentsAccent: 'Lokmangal',
    momentsLink: 'Open the photo gallery',
  },
  {
    metaTitle: 'आमच्याबद्दल',
    metaDescription: 'लोकमंगल मल्टीस्टेट को-ऑपरेटिव्ह सोसायटी लि.ची स्थापना 2004 मध्ये शेतकरी, लघुउद्योजक आणि समाजातील दुर्बल घटकांना सक्षम करण्यासाठी झाली. आमची वाटचाल, दृष्टी आणि मूल्ये जाणून घ्या.',
    eyebrow: 'लोकमंगलबद्दल',
    title: 'सभासदांसोबत वाटचाल,',
    accent: '2004 पासून',
    lead: 'लोकमंगल मल्टीस्टेट को-ऑपरेटिव्ह सोसायटी शेतकरी, लघुउद्योजक, तरुण आणि कुटुंबांसोबत काम करते, ज्यांना बचत आणि कर्जाची योग्य सुविधा हवी आहे.',
    findBranch: 'शाखा शोधा',
    chairmanMsg: 'अध्यक्षांचा संदेश',
    factSince: 'स्थापना',
    factReg: 'नोंदणी क्र.',
    factBranches: 'शाखा',
    factArea: 'कार्यक्षेत्र',
    factAreaValue: 'महाराष्ट्र व कर्नाटक',
    whoEyebrow: 'आम्ही कोण आहोत',
    whoTitle: 'सभासदांच्या मालकीची',
    whoAccent: 'बहुराज्य सहकारी संस्था',
    whoP1: 'लोकांना सक्षम करण्याची कल्पना आमचे मार्गदर्शक {mentor} आणि त्यांच्यासोबत आलेल्या समविचारी लोकांची होती. आज लोकमंगल मल्टीस्टेट महाराष्ट्र आणि कर्नाटकातील शहरे व खेड्यांमधील शाखा आणि एटीएमद्वारे सभासदांची सेवा करते.',
    whoP2: '{motto} हे आमचे ब्रीद आहे. प्रामाणिक व्यवहार, स्पष्ट आणि कार्यक्षम सेवा, प्रशिक्षित कर्मचारी आणि आमचे अध्यक्ष {chairman} यांच्या नेतृत्वाखाली समाजाच्या प्रत्येक घटकाला आर्थिक प्रवाहात आणण्याचे काम आम्ही करतो.',
    motto: '‘अखंड गतीतून सार्थकता’',
    contact: 'संपर्क करा',
    board: 'संचालक मंडळ',
    videoAlt: 'पहा: लोकमंगल मल्टीस्टेट परिचय व्हिडिओ',
    videoPlay: 'व्हिडिओ सुरू करा',
    videoCaption: 'आमची कहाणी पहा',
    numbersEyebrow: 'आकड्यांमध्ये लोकमंगल',
    vision: 'आमची दृष्टी',
    visionText: 'समाजाच्या प्रत्येक घटकाची सेवा करणारी, भविष्याचा वेध घेणारी, तंत्रज्ञानाधारित आणि ग्राहककेंद्री सहकारी संस्था बनणे; सहकारी संपत्तीतून सभासद आणि कर्मचाऱ्यांसाठी मूल्य निर्माण करत देशभर विस्तार करणे.',
    promise: 'आमचे वचन',
    promiseText: 'इतर आमच्याकडून जेवढी अपेक्षा करतात, त्याहून अधिक अपेक्षा आम्ही स्वतःकडून ठेवतो. खालील तत्त्वांनुसार आमच्या सभासदांना दररोज सुखद आणि फायदेशीर अनुभव देण्याचा आमचा प्रयत्न असतो.',
    valuesEyebrow: 'आमची मूल्ये',
    valuesTitle: 'प्रत्येक शाखेमागील',
    valuesAccent: 'पाच तत्त्वे',
    v1: 'विश्वास आणि पारदर्शकता',
    v1t: 'प्रत्येक निर्णय निवडून आलेले संचालक मंडळ एकत्रितपणे घेते आणि आमच्या हिशेबांचे दरवर्षी लेखापरीक्षण होते.',
    v2: 'प्रशिक्षित कर्मचारी',
    v2t: 'आपल्या परिसराची जाण असलेल्या आणि प्रत्येक टप्प्यावर सभासदांना मार्गदर्शन करणाऱ्या शाखा टीम.',
    v3: 'विश्वासार्ह जाळे',
    v3t: 'महाराष्ट्र आणि कर्नाटकातील शहरे व खेड्यांमध्ये शाखा आणि एटीएम.',
    v4: 'डिजिटल बँकिंग',
    v4t: 'नेट बँकिंग, मोबाइल बँकिंग, यूपीआय, आयएमपीएस, एनईएफटी/आरटीजीएस आणि एसएमएस बँकिंग.',
    v5: 'आर्थिक समावेशन',
    v5t: 'समाजाच्या सर्व स्तरांतील लोकांना औपचारिक आर्थिक व्यवस्थेत आणणे.',
    journeyEyebrow: 'आतापर्यंतची वाटचाल',
    journeyTitle: 'सोलापूरपासून',
    journeyAccent: 'दोन राज्यांपर्यंत',
    journeyLead: 'लोकमंगलच्या व्यवसायाचा प्रत्येक भाग सहकाराच्या तत्त्वांवर चालतो.',
    j1y: '2004',
    j1: 'संस्थेची स्थापना',
    j1t: 'आमचे मार्गदर्शक {mentor} यांच्या दूरदृष्टीतून प्रेरणा घेऊन लोकमंगल मल्टीस्टेट को-ऑपरेटिव्ह सोसायटी लि.ची {act} अंतर्गत नोंदणी झाली (नोंदणी क्र. {reg}).',
    j2y: '2008',
    j2: 'पूर्ण कार्यास सुरुवात',
    j2t: 'सोलापूर जिल्ह्यात कामकाज सुरू झाले, जिथे आमचे बहुतेक पहिले सभासद शेतकरी कुटुंबांतील होते. स्वतःचे काही सुरू करू किंवा वाढवू इच्छिणाऱ्या लोकांना आर्थिक आधार देणे, हे आमचे पहिले उद्दिष्ट होते.',
    j3y: 'वाढ',
    j3: 'आर्थिक सेवांच्या पलीकडे',
    j3t: '{chairman} यांच्या नेतृत्वाखाली लोकमंगलने मंगळवेढा, करमाळा आणि सांगोला येथील दूध शीतकरण केंद्रांसह दुग्धव्यवसाय, तसेच जैविक व रासायनिक खते तयार करणारा आणि इफ्को उत्पादनांचे वितरण करणारा खत व्यवसाय सुरू केला.',
    j4y: 'आज',
    j4: 'लाखो जीवनांना स्पर्श',
    j4t: 'महाराष्ट्र आणि कर्नाटकातील {branches} शाखा, वाढते एटीएम जाळे आणि डिजिटल सेवांमधून लोकमंगल लाखो सभासदांची सेवा करते आणि आणखी अनेकांपर्यंत पोहोचण्याची योजना आहे.',
    welcome: '{family} सहभागी होण्यासाठी आपले स्वागत आहे. सहकाराच्या तत्त्वांवर आपण मिळून अधिक सक्षम समाज घडवू शकतो.',
    family: 'लोकमंगल परिवारात',
    momentsEyebrow: 'क्षणचित्रे',
    momentsTitle: 'लोकमंगलमधील',
    momentsAccent: 'काही क्षण',
    momentsLink: 'छायाचित्र दालन पहा',
  },
);

const branches = stats.find((s) => s.prefix === '' && s.suffix === '')?.value ?? 60;
const facts = [
  [c('factSince'), String(site.founded)],
  [c('factReg'), site.registration],
  [c('factBranches'), String(branches)],
  [c('factArea'), c('factAreaValue')],
];
const values = [1, 2, 3, 4, 5].map((n) => ({ title: c(`v${n}` as 'v1'), text: c(`v${n}t` as 'v1t') }));
const vars = { act: site.act, reg: site.registration, mentor: mentor.name, chairman: chairman.name, branches };
const journey = [1, 2, 3, 4].map((n) => ({ year: c(`j${n}y` as 'j1y'), title: c(`j${n}` as 'j1'), text: c(`j${n}t` as 'j1t', vars) }));

// The introduction video is set in the admin panel (Settings → Organisation).
const videoId = site.aboutVideo?.match(/(?:embed\/|youtu\.be\/|v=)([\w-]{6,})/)?.[1];
// Our own photo as the video's cover (the YouTube thumbnail of the current video is a "coming soon" card).
const poster = '/images/gallery/gallery-10.webp';
const moments = gallery.filter((g) => g.src !== poster).slice(0, 10);
const words = (text: string, offset = 0) => text.split(' ').map((w, i) => ({ w, i: i + offset }));
---

<Base title={c('metaTitle')} description={c('metaDescription')}>
  <!-- BANNER -->
  <section class="ab-hero">
    <img src="/images/about/banner.webp" alt="" class="ab-hero__img" width="1672" height="941" fetchpriority="high" />
    <div class="container ab-hero__inner">
      <nav class="ab-crumbs" aria-label={t('breadcrumb')}>
        <a href={l('/')}>{t('home')}</a>
        <Icon name="chevron-right" size={14} />
        <span aria-current="page">{t('nav.about')}</span>
      </nav>
      <p class="eyebrow ab-hero__eyebrow">{c('eyebrow')}</p>
      <h1 class="h1 words ab-hero__title" data-words>
        {words(c('title')).map(({ w, i }) => (<><span class="w"><span style={`--i:${i}`}>{w}</span></span>{' '}</>))}
        <em>{words(c('accent'), c('title').split(' ').length).map(({ w, i }, k, arr) => (<><span class="w"><span style={`--i:${i}`}>{w}</span></span>{k < arr.length - 1 ? ' ' : ''}</>))}</em>
      </h1>
      <p class="lead ab-hero__lead" data-reveal style="--d:350ms">{c('lead')}</p>
      <div class="btn-row" data-reveal style="--d:480ms">
        <a href={l('/branches/')} class="btn btn--primary">{c('findBranch')} <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
        <a href={l('/chairman-message/')} class="btn btn--outline-light">{c('chairmanMsg')}</a>
      </div>
    </div>
    <div class="ab-facts">
      <dl class="container ab-facts__row" data-stagger>
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </section>

  <!-- WHO WE ARE -->
  <section class="section ab-who">
    <div class="container split">
      <div class="stack" style="--stack:1.2rem">
        <p class="eyebrow" data-reveal>{c('whoEyebrow')}</p>
        <h2 class="h2" data-reveal>{c('whoTitle')} <em>{c('whoAccent')}</em></h2>
        <div class="prose lead" data-reveal>
          <p>{c('whoP1', { mentor: mentor.name })}</p>
          <p set:html={c('whoP2', { chairman: chairman.name, motto: `<strong>${c('motto')}</strong>` })} />
        </div>
        <div class="btn-row" data-reveal>
          <a href={l('/contact-us/')} class="btn btn--green">{c('contact')} <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
          <a href={l('/board-of-directors/')} class="btn btn--ghost">{c('board')}</a>
        </div>
      </div>
      <div class="ab-media" data-reveal="right">
        {videoId ? (
          <div class="ab-video" data-video={videoId}>
            <img src={poster} alt={c('videoAlt')} loading="lazy" width="1400" height="1050" />
            <button class="ab-video__play" data-video-play aria-label={c('videoPlay')}><Icon name="play" size={28} /></button>
            <span class="ab-video__cap">{c('videoCaption')}</span>
          </div>
        ) : (
          <img src="/images/home/intro.webp" alt="" class="ab-media__photo" loading="lazy" width="1000" height="1250" />
        )}
        <p class="ab-motto">
          <img src="/images/brand/emblem.png" alt="" width="40" height="48" />
          <span>
            {lang === 'mr' ? <strong>{site.taglineMr}</strong> : <><strong>{site.tagline}</strong><small lang="mr">{site.taglineMr}</small></>}
          </span>
        </p>
      </div>
    </div>
  </section>

  <!-- NUMBERS -->
  <section class="ab-numbers" aria-label={c('numbersEyebrow')}>
    <div class="container">
      <p class="ab-numbers__kicker" data-reveal>{c('numbersEyebrow')}</p>
      <div class="ab-numbers__row" data-stagger>
        {stats.map((s) => (
          <div>
            <strong><span data-count={s.value} data-prefix={s.prefix} data-suffix={s.suffix}>{s.prefix}{s.value}{s.suffix}</span></strong>
            <span class="ab-numbers__label">{s.label}</span>
            <small>{s.sub}</small>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- VISION & PROMISE -->
  <section class="section ab-vm">
    <div class="container ab-vm__grid">
      <article class="ab-vm__vision" data-reveal="left">
        <p class="ab-vm__kicker">{c('vision')}</p>
        <p class="ab-vm__text">{c('visionText')}</p>
      </article>
      <article class="ab-vm__promise" data-reveal="right">
        <p class="ab-vm__kicker">{c('promise')}</p>
        <p class="ab-vm__text">{c('promiseText')}</p>
      </article>
    </div>
  </section>

  <!-- VALUES -->
  <section class="section ab-values">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{c('valuesEyebrow')}</p>
        <h2 class="h2">{c('valuesTitle')} <em>{c('valuesAccent')}</em></h2>
      </div>
      <ol class="ab-values__grid" data-stagger>
        {values.map((v, i) => (
          <li class="ab-value">
            <span class="ab-value__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="ab-value__title">{v.title}</h3>
            <p>{v.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- JOURNEY -->
  <section class="section ab-journey">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">{c('journeyEyebrow')}</p>
        <h2 class="h2">{c('journeyTitle')} <em>{c('journeyAccent')}</em></h2>
        <p class="lead">{c('journeyLead')}</p>
      </div>
      <div class="ab-tl">
        <span class="ab-tl__rail" aria-hidden="true"><span class="ab-tl__line"></span></span>
        <ol class="ab-tl__list">
          {journey.map((j, i) => (
            <li class:list={['ab-tl__item', { 'ab-tl__item--right': i % 2 === 1 }]} data-reveal={i % 2 === 1 ? 'right' : 'left'}>
              <span class="ab-tl__dot" aria-hidden="true"></span>
              <div class="ab-tl__card">
                <span class="ab-tl__year">{j.year}</span>
                <h3 class="h4">{j.title}</h3>
                <p>{j.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <p class="ab-welcome" data-reveal set:html={c('welcome', { family: `<strong>${c('family')}</strong>` })} />
    </div>
  </section>

  <!-- MOMENTS: real photos from the gallery, gliding slowly -->
  {moments.length > 3 && (
    <section class="section ab-moments">
      <div class="container ab-moments__head" data-reveal>
        <div>
          <p class="eyebrow">{c('momentsEyebrow')}</p>
          <h2 class="h2">{c('momentsTitle')} <em>{c('momentsAccent')}</em></h2>
        </div>
        <a href={l('/gallery/')} class="link-arrow">{c('momentsLink')} <Icon name="arrow-right" size={16} /></a>
      </div>
      <div class="ab-strip">
        <div class="ab-strip__track">
          {[0, 1].map((copy) =>
            moments.map((m) => (
              <figure class="ab-strip__item" aria-hidden={copy === 1 ? 'true' : undefined}>
                <img src={m.src.replace('/images/gallery/', '/images/gallery/thumb/')} alt={copy === 1 ? '' : m.caption} loading="lazy" width="640" height="425" />
              </figure>
            )),
          )}
        </div>
      </div>
    </section>
  )}

  <AboutNav current="/about-us/" />
  <CtaBand />
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    const wrap = document.querySelector<HTMLElement>('[data-video]');
    wrap?.querySelector('[data-video-play]')?.addEventListener('click', () => {
      const id = encodeURIComponent(wrap.dataset.video ?? '');
      wrap.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0" title="Lokmangal Multistate" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
      wrap.classList.add('is-playing');
    });
  });
</script>

