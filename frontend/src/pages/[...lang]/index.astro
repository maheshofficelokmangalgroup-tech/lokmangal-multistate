---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Calculator from '../../components/Calculator.astro';
import BlogCard from '../../components/BlogCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { siteData } from '../../data/site';
import { depositsData, fmtRate } from '../../data/deposits';
import { loansData } from '../../data/loans';
import { csrData } from '../../data/csr';
import { servicesFor } from '../../data/services';
import { postsFor } from '../../data/posts';
import { getLang, langPaths, localePath } from '../../i18n';
import { compute } from '@lokmangal/finance';
import { useT } from '../../i18n/ui';

export function getStaticPaths() {
  return langPaths();
}

const lang = getLang(Astro);
const t = useT(lang);
const l = (p: string) => localePath(p, lang);
const { site, stats, notices } = siteData(lang);
const { schemes, fdSlabs } = depositsData(lang);
const schemesEn = depositsData('en');
const { loans } = loansData(lang);
const { initiatives } = csrData(lang);
const { services } = servicesFor(lang);
const posts = postsFor(lang);

const slides = [
  {
    eyebrow: t('home.slide1.eyebrow'),
    title: t('home.slide1.title'),
    accent: t('home.slide1.accent'),
    text: t('home.slide1.text'),
    cta: [t('home.slide1.cta'), l('/open-an-account/')],
    cta2: [t('home.slide1.cta2'), l('/deposits/')],
    image: '/images/hero/hero-1.webp',
    pos: '85% 35%',
  },
  {
    eyebrow: t('home.slide2.eyebrow'),
    title: t('home.slide2.title'),
    accent: t('home.slide2.accent'),
    text: t('home.slide2.text'),
    cta: [t('home.slide2.cta'), l('/deposits/')],
    cta2: [t('home.slide2.cta2'), l('/interest-rates/')],
    image: '/images/hero/hero-2.webp',
    pos: '68% 45%',
  },
  {
    eyebrow: t('home.slide3.eyebrow'),
    title: t('home.slide3.title'),
    accent: t('home.slide3.accent'),
    text: t('home.slide3.text'),
    cta: [t('home.slide3.cta'), l('/apply-loan/')],
    cta2: [t('home.slide3.cta2'), l('/loans/')],
    image: '/images/hero/hero-3.webp',
    pos: '80% 40%',
  },
];

// Photo cards, one picture per product (other brands' logos removed from the photos).
const fdTop = schemes.find((s) => s.kind === 'fd' && s.rate !== null)?.rate;
const quick = [
  { tone: 'var(--g-600)', image: '/images/home/card-account.webp', pos: '50% 30%', tag: t('home.quick.tagAccount'), title: t('home.quick.account'), text: t('home.quick.accountText'), href: l('/open-an-account/'), links: [[t('home.quick.savings'), `${l('/open-an-account/')}?type=Savings%20Account`], [t('home.quick.current'), `${l('/open-an-account/')}?type=Current%20Account`]] },
  { tone: 'var(--o-strong-hover)', image: '/images/home/card-fd.webp', pos: '50% 30%', tag: fdTop ? t('home.quick.tagFd', { rate: fmtRate(fdTop) }) : t('home.quick.fd'), title: t('home.quick.fd'), text: t('home.quick.fdText'), href: l('/deposits/'), links: [[t('btn.apply'), l('/apply-for-deposits/')]] },
  { tone: '#7a5300', image: '/images/home/card-rd.webp', pos: '50% 30%', tag: t('home.quick.tagRd'), title: t('home.quick.rd'), text: t('home.quick.rdText'), href: l('/deposits/vishvamangal-recurring-deposit/'), links: [[t('btn.apply'), `${l('/apply-for-deposits/')}?scheme=Vishwamangal%20Recurring%20Deposit`]] },
  { tone: 'var(--g-700)', image: '/images/home/card-loan.webp', pos: '50% 30%', tag: t('home.quick.tagLoan'), title: t('home.quick.loan'), text: t('home.quick.loanText'), href: l('/loans/'), links: [[t('btn.apply'), l('/apply-loan/')]] },
];

const journey = [
  { year: t('home.j1.year'), title: t('home.j1.title'), text: t('home.j1.text', { act: site.act, reg: site.registration }) },
  { year: t('home.j2.year'), title: t('home.j2.title'), text: t('home.j2.text') },
  { year: t('home.j3.year'), title: t('home.j3.title'), text: t('home.j3.text') },
  { year: t('home.j4.year'), title: t('home.j4.title'), text: t('home.j4.text') },
];

// Trust signals, all from the society's registration and FAQ.
const trust = [
  { icon: 'shield-check', title: t('home.trust.reg'), text: t('home.trust.regText', { act: lang === 'mr' ? 'बहुराज्य सहकारी संस्था कायदा, 2002' : 'Multi-State Co-op. Act, 2002', reg: site.registration }) },
  { icon: 'file-text', title: t('home.trust.audit'), text: t('home.trust.auditText') },
  { icon: 'users', title: t('home.trust.owned'), text: t('home.trust.ownedText') },
  { icon: 'lock', title: t('home.trust.secure'), text: t('home.trust.secureText') },
];

const featured = schemes.filter((s) => s.featured).slice(0, 6);
// Deposits board: the top fixed deposit as a feature card with its rate ladder, the rest as receipts.
const fdFeature = featured.find((s) => s.kind === 'fd' && s.rate !== null);
const tickets = featured.filter((s) => s !== fdFeature).slice(0, 5);
const decimalsOf = (r: number) => (fmtRate(r).includes('.') ? 2 : 0);
// The application form receives the English scheme name, whatever language the visitor reads.
const applyHref = (slug: string) => `${l('/apply-for-deposits/')}?scheme=${encodeURIComponent(schemesEn.schemeBySlug(slug)?.name ?? slug)}`;
const slabRates = fdSlabs.map((s) => s.regular);
const [minRate, maxRate] = [Math.min(...slabRates), Math.max(...slabRates)];
const barHeight = (r: number) => Math.round(30 + ((r - minRate) / (maxRate - minRate || 1)) * 70);
const premium = fdSlabs.length ? fdSlabs[0].special - fdSlabs[0].regular : 0;
const rupees = (n: number) => `₹${new Intl.NumberFormat('en-IN', { maximumFractionDigits: 0 }).format(Math.round(n))}`;
// The same formula and approved rate as the scheme page's {calc} figures.
const fdExample = fdFeature ? { ...fdFeature.calc, result: compute(fdFeature.calc.mode, fdFeature.calc.amount, fdFeature.calc.rate, fdFeature.calc.months).result } : null;
const chartLabel = t('home.dep.chartLabel', { list: fdSlabs.map((s) => `${s.tenure} ${fmtRate(s.regular)}%`).join(', ') });
const latest = posts.slice(0, 3);
const words = (text: string, offset = 0) => text.split(' ').map((w, i) => ({ w, i: i + offset }));
---

<Base>
  <!-- HERO -->
  <section class="hero" data-hero>
    <h1 class="sr-only">{t('home.title')}</h1>
    <div class="hero__media" aria-hidden="true">
      {slides.map((s, i) => (
        <img src={s.image} alt="" class:list={['hero__img', { 'is-active': i === 0 }]} data-visual style={`object-position:${s.pos}`} width="1920" height="1080" fetchpriority={i === 0 ? 'high' : 'low'} />
      ))}
    </div>

    <div class="container hero__inner">
      <div class="hero__copy">
        <div class="hero__slides">
          {slides.map((s, i) => (
            <div class:list={['hero__slide', { 'is-active': i === 0 }]} data-slide aria-hidden={i !== 0 ? 'true' : 'false'}>
              <p class="eyebrow">{s.eyebrow}</p>
              <h2 class="display hero__title">
                {words(s.title).map(({ w, i: n }) => (<><span class="w"><span style={`--i:${n}`}>{w}</span></span>{' '}</>))}
                <em>{words(s.accent, s.title.split(' ').length).map(({ w, i: n }, k, arr) => (<><span class="w"><span style={`--i:${n}`}>{w}</span></span>{k < arr.length - 1 ? ' ' : ''}</>))}</em>
              </h2>
              <p class="lead hero__text">{s.text}</p>
              <div class="btn-row hero__ctas">
                <a href={s.cta[1]} class="btn btn--primary btn--lg" tabindex={i !== 0 ? -1 : undefined}>{s.cta[0]} <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
                <a href={s.cta2[1]} class="btn btn--outline-light btn--lg" tabindex={i !== 0 ? -1 : undefined}>{s.cta2[0]}</a>
              </div>
            </div>
          ))}
        </div>

        <div class="hero__controls">
          <button class="hero__arrow hero__toggle" data-hero-toggle aria-pressed="false" aria-label={t('home.hero.pause')}>
            <svg class="hero__toggle-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1.2" /><rect x="14" y="5" width="4" height="14" rx="1.2" /></svg>
            <svg class="hero__toggle-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l12-7.5z" /></svg>
          </button>
          <button class="hero__arrow" data-hero-prev aria-label={t('home.hero.prev')}><Icon name="chevron-left" size={20} /></button>
          <div class="hero__dots">
            {slides.map((s, i) => (
              <button class:list={['hero__dot', { 'is-active': i === 0 }]} data-dot aria-label={t('home.hero.show', { n: i + 1, title: s.eyebrow })}><span></span></button>
            ))}
          </div>
          <button class="hero__arrow" data-hero-next aria-label={t('home.hero.next')}><Icon name="chevron-right" size={20} /></button>
        </div>
        <p class="sr-only" aria-live="polite" data-hero-status></p>
      </div>
    </div>
  </section>

  <!-- STATS RIBBON -->
  <section class="stats-wrap">
    <div class="container">
      <div class="stats" data-stagger>
        {stats.map((s) => (
          <div class="stat">
            <p class="stat__num"><span data-count={s.value} data-prefix={s.prefix} data-suffix={s.suffix}>{s.prefix}{s.value}{s.suffix}</span></p>
            <p class="stat__label">{s.label}</p>
            <p class="stat__sub">{s.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TRUST / PROOF -->
  <section class="trust-wrap" aria-labelledby="trust-title">
    <div class="container">
      <h2 class="sr-only" id="trust-title">{t('home.trust.title')}</h2>
      <ul class="trust" data-stagger>
        {trust.map((item) => (
          <li class="trust__item">
            <span class="trust__icon"><Icon name={item.icon} size={20} /></span>
            <span><strong>{item.title}</strong><small>{item.text}</small></span>
          </li>
        ))}
      </ul>
      <p class="trust__more" data-reveal="fade"><a href={l('/faq/')} class="link-arrow">{t('home.trust.more')} <Icon name="arrow-right" size={15} /></a></p>
    </div>
  </section>

  <!-- QUICK ACTIONS -->
  <section class="section section--dark quick-sec">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">{t('home.quick.eyebrow')}</p>
        <h2 class="h2">{t('home.quick.h2a')} <em>{t('home.quick.h2b')}</em></h2>
      </div>
      <div class="quick-grid" data-stagger>
        {quick.map((q) => (
          <article class="qcard" style={`--tone:${q.tone}`}>
            <img src={q.image} alt="" class="qcard__img" style={`object-position:${q.pos}`} width="800" height="1000" loading="lazy" />
            <span class="qcard__tag">{q.tag}</span>
            <h3 class="qcard__title"><a href={q.href}>{q.title}</a></h3>
            <p class="qcard__text">{q.text}</p>
            <div class="qcard__links">
              {q.links.map(([label, href]) => <a href={href}>{label} <Icon name="arrow-right" size={15} /></a>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="section">
    <div class="container split">
      <figure class="intro-visual" data-reveal="left">
        <img src="/images/home/intro.webp" alt={t('home.intro.alt')} width="1000" height="1250" loading="lazy" />
        <figcaption class="intro-visual__badge">
          <span class="intro-visual__year">{t('home.intro.years')}</span>
          <span>{t('home.intro.yearsText')}</span>
        </figcaption>
      </figure>
      <div class="stack" style="--stack:1.25rem">
        <p class="eyebrow" data-reveal>{t('home.intro.eyebrow')}</p>
        <h2 class="h2 words" data-words>
          {words(t('home.intro.h2a')).map(({ w, i }) => (<><span class="w"><span style={`--i:${i}`}>{w}</span></span>{' '}</>))}
          <em>{words(t('home.intro.h2b'), t('home.intro.h2a').split(' ').length).map(({ w, i }, k, arr) => (<><span class="w"><span style={`--i:${i}`}>{w}</span></span>{k < arr.length - 1 ? ' ' : ''}</>))}</em>
        </h2>
        <p class="lead" data-reveal>{t('home.intro.lead')}</p>
        <ul class="check-list check-list--2" data-stagger>
          <li>{t('home.intro.c1')}</li>
          <li>{t('home.intro.c2')}</li>
          <li>{t('home.intro.c3')}</li>
          <li>{t('home.intro.c4')}</li>
          <li>{t('home.intro.c5')}</li>
          <li>{t('home.intro.c6')}</li>
        </ul>
        <div class="btn-row" data-reveal>
          <a href={l('/about-us/')} class="btn btn--green">{t('home.intro.more')} <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
          <a href={l('/contact-us/')} class="btn btn--ghost">{t('home.intro.touch')}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- DEPOSITS -->
  <section class="section dep-sec">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div class="section-head__text">
          <p class="eyebrow">{t('home.dep.eyebrow')}</p>
          <h2 class="h2">{t('home.dep.h2a')} <em>{t('home.dep.h2b')}</em></h2>
          <p class="lead">{t('home.dep.lead', { validity: site.ratesValidity })}</p>
        </div>
        <a href={l('/deposits/')} class="btn btn--ghost">{t('home.dep.all')} <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
      </div>
      <div class="dep-board">
        {fdFeature && (
          <article class="dep-hero" data-reveal>
            <div class="dep-hero__top">
              <span class="dep-chip dep-chip--light">{t('kind.fd')}</span>
              {lang === 'en' && <span class="dep-hero__mr" lang="mr">{fdFeature.nameMr}</span>}
            </div>
            <p class="dep-hero__rate"><span data-count={fdFeature.rate!} data-decimals={decimalsOf(fdFeature.rate!)}>{fmtRate(fdFeature.rate!)}</span><small>%</small></p>
            <p class="dep-hero__note">{fdFeature.rateNote}</p>
            <h3 class="dep-hero__name"><a href={l(`/deposits/${fdFeature.slug}/`)}>{fdFeature.name}</a></h3>
            <p class="dep-hero__pitch">{fdFeature.pitch}</p>
            <figure class="dep-chart" role="img" aria-label={chartLabel}>
              <figcaption class="dep-chart__title">{t('home.dep.chart')}</figcaption>
              <ol class="dep-chart__bars" aria-hidden="true">
                {fdSlabs.map((s, i) => (
                  <li style={`--h:${barHeight(s.regular)}%;--i:${i}`}>
                    <span class="dep-chart__val">{fmtRate(s.regular)}%</span>
                    <span class="dep-chart__bar"></span>
                    <span class="dep-chart__label">{s.max == null ? `${s.min}+` : `${s.min}–${s.max}`}</span>
                  </li>
                ))}
              </ol>
              <p class="dep-chart__axis" aria-hidden="true"><span>{t('home.dep.days')}</span>{premium > 0 && <span>{t('home.dep.special', { rate: fmtRate(premium) })}</span>}</p>
            </figure>
            {fdExample && (
              <p class="dep-example">
                <span>{t('home.dep.example', { amount: rupees(fdExample.amount), months: fdExample.months })}</span>
                <strong><span data-count={Math.round(fdExample.result)} data-prefix="₹">{rupees(fdExample.result)}</span> <small>{t('home.dep.maturity')}</small></strong>
              </p>
            )}
            <div class="dep-hero__actions">
              <a href={applyHref(fdFeature.slug)} class="btn btn--primary">{t('btn.apply')} <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
              <a href={l(`/deposits/${fdFeature.slug}/`)} class="dep-hero__more">{t('btn.details')} <Icon name="arrow-right" size={16} /></a>
            </div>
          </article>
        )}
        <div class="dep-tickets" data-stagger>
          {tickets.map((s) => (
            <article class="ticket">
              <div class="ticket__main">
                <div class="ticket__top">
                  <span class="dep-chip">{t(`kind.${s.kind}` as 'kind.fd')}</span>
                  {lang === 'en' && <span class="ticket__mr" lang="mr">{s.nameMr}</span>}
                </div>
                <p class="ticket__rate">
                  {s.rate !== null
                    ? <><span data-count={s.rate} data-decimals={decimalsOf(s.rate)}>{fmtRate(s.rate)}</span><small>%</small></>
                    : <><span>2</span><small>×</small></>}
                </p>
                <p class="ticket__note">{s.rateNote}</p>
                <h3 class="ticket__name"><a href={l(`/deposits/${s.slug}/`)}>{s.name}</a></h3>
              </div>
              <div class="ticket__stub">
                <dl class="ticket__facts">
                  {s.highlight.slice(0, 3).map((h) => <div><dt>{h.label}</dt><dd>{h.value}</dd></div>)}
                </dl>
                <a href={applyHref(s.slug)} class="ticket__apply" aria-label={`${t('btn.apply')}: ${s.name}`}>{t('btn.applyShort')} <Icon name="arrow-right" size={15} /></a>
              </div>
            </article>
          ))}
          <a href={l('/deposits/')} class="ticket-all">
            <span class="ticket-all__n">{schemes.length}</span>
            <strong>{t('home.dep.allTile')}</strong>
            <small>{t('home.dep.allSub')}</small>
            <span class="ticket-all__go"><Icon name="arrow-right" size={20} /></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CALCULATOR -->
  <section class="section">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">{t('home.calc.eyebrow')}</p>
        <h2 class="h2">{t('home.calc.h2a')} <em>{t('home.calc.h2b')}</em></h2>
        <p class="lead">{t('home.calc.lead')}</p>
      </div>
      <div data-reveal="zoom"><Calculator /></div>
    </div>
  </section>

  <!-- JOURNEY -->
  <section class="section section--dark journey-sec">
    <div class="container split split--wide-right on-dark" style="position:relative;z-index:1">
      <div class="stack" style="--stack:1.3rem">
        <p class="eyebrow" data-reveal>{t('home.story.eyebrow')}</p>
        <h2 class="h2" data-reveal>{t('home.story.h2a')} <em>{t('home.story.h2b')}</em> {t('home.story.h2c')}</h2>
        <p class="lead" data-reveal>{t('home.story.lead')}</p>
        <div class="journey-links" data-stagger>
          <a href={l('/about-us/')}><Icon name="landmark" size={18} /> {t('home.story.about')} <Icon name="arrow-up-right" size={16} /></a>
          <a href={l('/social-responsibility/')}><Icon name="heart" size={18} /> {t('home.story.csr')} <Icon name="arrow-up-right" size={16} /></a>
          <a href={l('/branches/')}><Icon name="map-pin" size={18} /> {t('home.story.branches')} <Icon name="arrow-up-right" size={16} /></a>
          <a href={l('/careers/')}><Icon name="briefcase" size={18} /> {t('home.story.careers')} <Icon name="arrow-up-right" size={16} /></a>
        </div>
      </div>
      <ol class="timeline" data-stagger>
        {journey.map((j) => (
          <li class="timeline__item">
            <span class="timeline__dot" aria-hidden="true"></span>
            <div>
              <span class="timeline__year">{j.year}</span>
              <h3 class="h4">{j.title}</h3>
              <p>{j.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- LOANS -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div class="section-head__text">
          <p class="eyebrow">{t('home.loans.eyebrow')}</p>
          <h2 class="h2">{t('home.loans.h2a')} <em>{t('home.loans.h2b')}</em></h2>
          <p class="lead">{t('home.loans.lead')}</p>
        </div>
        <div class="carousel-nav">
          <button class="carousel-btn carousel-toggle" data-carousel-toggle aria-pressed="false" aria-label={t('home.loans.pause')} data-label-pause={t('home.loans.pause')} data-label-play={t('home.loans.play')} hidden>
            <svg class="carousel-toggle__pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1.2" /><rect x="14" y="5" width="4" height="14" rx="1.2" /></svg>
            <svg class="carousel-toggle__play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l12-7.5z" /></svg>
          </button>
          <button class="carousel-btn" data-scroll="-1" aria-label={t('home.loans.left')}><Icon name="chevron-left" size={20} /></button>
          <button class="carousel-btn" data-scroll="1" aria-label={t('home.loans.right')}><Icon name="chevron-right" size={20} /></button>
        </div>
      </div>
    </div>
    <div class="carousel" data-carousel data-reveal>
      <div class="carousel__track">
        {loans.map((ln) => (
          <a href={l(`/loans/#${ln.slug}`)} class="loan-tile">
            <div class="loan-tile__img zoom"><img src={ln.image} alt="" loading="lazy" width="360" height="400" /></div>
            <div class="loan-tile__body">
              <span class="loan-tile__icon"><Icon name={ln.icon} size={20} /></span>
              <h3>{ln.name}</h3>
              <p>{ln.summary}</p>
              <dl>
                <div><dt>{t('home.loans.interest')}</dt><dd>{ln.rate}</dd></div>
                <div><dt>{t('home.loans.amount')}</dt><dd>{ln.amount}</dd></div>
              </dl>
            </div>
          </a>
        ))}
      </div>
    </div>
    <div class="container">
      <div class="carousel-progress" aria-hidden="true"><span data-carousel-bar></span></div>
    </div>
    <div class="container center mt-4" data-reveal>
      <a href={l('/apply-loan/')} class="btn btn--primary btn--lg">{t('home.loans.apply')} <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
    </div>
  </section>

  <!-- CSR -->
  <section class="section csr">
    <div class="container split split--wide-left">
