---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import CtaBand from '../../components/CtaBand.astro';
import { faqsFor } from '../../data/faq';
import { siteData } from '../../data/site';
import { getLang, langPaths, localePath } from '../../i18n';
import { pageCopy, useT } from '../../i18n/ui';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

export function getStaticPaths() {
  return langPaths();
}

const lang = getLang(Astro);
const t = useT(lang);
const l = (p: string) => localePath(p, lang);
const { site } = siteData(lang);
const faqs = faqsFor(lang);

const c = pageCopy(
  lang,
  'faq',
  {
    metaTitle: 'FAQ',
    metaDescription: 'Frequently asked questions about Lokmangal Multistate Co-operative Society: registration, safety of deposits, interest rates and who can invest.',
    eyebrow: 'Help centre',
    title: 'Questions,',
    accent: 'answered simply',
    lead: 'Everything you need to know about Lokmangal Multistate, registered under the {act}, Registration No. {reg}.',
    searchLabel: 'Search the questions',
    searchPh: 'Type a word: deposit, TDS, senior',
    count: '{n} of {total} questions',
    none: 'No question matches “{q}”. Call {phone} and we will help.',
    clear: 'Clear search',
    listLabel: 'Questions and answers',
    helpEyebrow: 'Helpline',
    helpTitle: 'Still have a question?',
    helpText: 'Our team is happy to help. Call us, write to us, or ask for a callback.',
    emailUs: 'Email us',
    formTitle: 'Request a callback',
  },
  {
    metaTitle: 'प्रश्नोत्तरे',
    metaDescription: 'लोकमंगल मल्टीस्टेट को-ऑपरेटिव्ह सोसायटीबद्दल नेहमी विचारले जाणारे प्रश्न: नोंदणी, ठेवींची सुरक्षितता, व्याजदर आणि कोण गुंतवणूक करू शकते.',
    eyebrow: 'मदत केंद्र',
    title: 'तुमचे प्रश्न,',
    accent: 'सोपी उत्तरे',
    lead: 'लोकमंगल मल्टीस्टेटबद्दल तुम्हाला हवी ती माहिती. संस्था {act} अंतर्गत नोंदणीकृत आहे, नोंदणी क्र. {reg}.',
    searchLabel: 'प्रश्न शोधा',
    searchPh: 'शब्द लिहा: ठेव, टीडीएस, ज्येष्ठ',
    count: '{total} पैकी {n} प्रश्न',
    none: '“{q}” शी जुळणारा प्रश्न नाही. {phone} वर कॉल करा, आम्ही मदत करू.',
    clear: 'शोध पुसा',
    listLabel: 'प्रश्न आणि उत्तरे',
    helpEyebrow: 'हेल्पलाइन',
    helpTitle: 'अजून काही प्रश्न आहे?',
    helpText: 'आमची टीम मदतीसाठी तयार आहे. कॉल करा, ईमेल करा किंवा कॉलबॅकची विनंती करा.',
    emailUs: 'ईमेल करा',
    formTitle: 'कॉलबॅकची विनंती',
  },
);

const banner = existsSync(join(process.cwd(), 'public', '/images/faq/banner.webp')) ? '/images/faq/banner.webp' : '/images/services/photo-neft.webp';
const total = String(faqs.length);

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang === 'mr' ? 'mr-IN' : 'en-IN',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() },
  })),
};
---

<Base title={c('metaTitle')} description={c('metaDescription')} jsonLd={faqLd}>
  <!-- BANNER with the question search -->
  <section class="fq-hero">
    <img src={banner} alt="" class="fq-hero__img" width="1920" height="1080" fetchpriority="high" />
    <div class="container fq-hero__inner">
      <nav class="fq-crumbs" aria-label={t('breadcrumb')}>
        <a href={l('/')}>{t('home')}</a>
        <Icon name="chevron-right" size={14} />
        <span aria-current="page">{c('metaTitle')}</span>
      </nav>
      <div class="fq-hero__copy">
        <p class="fq-hero__eyebrow">{c('eyebrow')}</p>
        <h1 class="h1 fq-hero__title" data-reveal>{c('title')} <em>{c('accent')}</em></h1>
        <p class="lead fq-hero__lead" data-reveal style="--d:120ms">{c('lead', { act: site.act, reg: site.registration })}</p>
        <div class="fq-search" role="search" data-reveal style="--d:220ms">
          <label for="faq-q" class="sr-only">{c('searchLabel')}</label>
          <Icon name="search" size={20} />
          <input id="faq-q" type="search" placeholder={c('searchPh')} autocomplete="off" data-faq-q />
          <button type="button" class="fq-search__clear" aria-label={c('clear')} hidden data-faq-clear>×</button>
        </div>
        <p class="fq-count" aria-live="polite" data-faq-count data-tpl={c('count')} data-total={total}>{c('count', { n: total, total })}</p>
      </div>
    </div>
  </section>

  <section class="section fq-sec">
    <div class="container fq-grid">
      <div>
        <div class="fq-list" aria-label={c('listLabel')} data-faq-list>
          {faqs.map((f, i) => (
            <details class="fq" id={`q-${i + 1}`} open={i === 0}>
              <summary>
                <span class="fq__n">{String(i + 1).padStart(2, '0')}</span>
                <span class="fq__q">{f.q}</span>
                <span class="fq__pm" aria-hidden="true"></span>
              </summary>
              <div class="fq__a prose" set:html={f.a} />
            </details>
          ))}
        </div>
        <p class="fq-none" hidden data-faq-none data-tpl={c('none', { phone: site.phone })}></p>
      </div>

      <aside class="fq-side">
        <div class="fq-help" data-reveal>
          <p class="fq-help__eyebrow">{c('helpEyebrow')}</p>
          <h2 class="fq-help__title">{c('helpTitle')}</h2>
          <p class="fq-help__text">{c('helpText')}</p>
          <a href={site.phoneHref} class="fq-help__phone">{site.phone}</a>
          <a href={`mailto:${site.email}`} class="link-arrow">{c('emailUs')}: {site.email} <Icon name="arrow-right" size={16} /></a>
        </div>
        <div data-reveal><EnquiryForm variant="callback" title={c('formTitle')} /></div>
      </aside>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    const list = document.querySelector<HTMLElement>('[data-faq-list]');
    const input = document.querySelector<HTMLInputElement>('[data-faq-q]');
    if (!list || !input) return;
    const items = Array.from(list.querySelectorAll<HTMLDetailsElement>('details'));
    const text = items.map((d) => (d.textContent ?? '').toLowerCase());
    const count = document.querySelector<HTMLElement>('[data-faq-count]');
    const none = document.querySelector<HTMLElement>('[data-faq-none]');
    const clear = document.querySelector<HTMLButtonElement>('[data-faq-clear]');
    const firstOpen = items.map((d) => d.open);

    // Every word typed must appear in the question or its answer; matching answers open.
    const filter = () => {
      const q = input.value.trim();
      const words = q.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      items.forEach((d, i) => {
        const hit = words.every((w) => text[i].includes(w));
        d.hidden = !hit;
        if (hit) shown++;
        d.open = words.length ? hit : firstOpen[i];
      });
      if (count) count.textContent = (count.dataset.tpl ?? '').replace('{n}', String(shown)).replace('{total}', count.dataset.total ?? '');
      if (none) {
        none.hidden = shown > 0;
        none.textContent = (none.dataset.tpl ?? '').replace('{q}', q);
      }
      if (clear) clear.hidden = !q;
    };
    input.addEventListener('input', filter);
    clear?.addEventListener('click', () => { input.value = ''; filter(); input.focus(); });

    // Links like /faq/#q-3 (from the site search) open that answer.
    const open = () => {
      const d = items.find((x) => `#${x.id}` === location.hash);
      if (!d) return;
      d.hidden = false;
      d.open = true;
      d.scrollIntoView({ block: 'start' });
    };
    open();
    window.addEventListener('hashchange', open);
    document.addEventListener('astro:before-swap', () => window.removeEventListener('hashchange', open), { once: true });
  });
</script>

<style>
  /* ---------- Banner ---------- */
  .fq-hero { position: relative; isolation: isolate; overflow: hidden; display: flex; min-height: clamp(500px, 66vh, 620px); color: #fff; background: var(--g-950); }
  .fq-hero__img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 75% 35%; animation: fq-settle 14s cubic-bezier(0.16, 1, 0.3, 1) both; }
  @keyframes fq-settle { from { transform: scale(1.12); } }
  .fq-hero::after {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg, rgb(4 36 23 / 0.97) 0%, rgb(4 36 23 / 0.9) 38%, rgb(4 36 23 / 0.4) 62%, rgb(4 36 23 / 0.08) 85%, transparent 100%), linear-gradient(0deg, rgb(4 36 23 / 0.5), transparent 30%);
  }
  .fq-hero__inner { display: flex; flex-direction: column; padding-block: clamp(40px, 6vw, 72px) clamp(44px, 6vw, 72px); }
  .fq-crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 0.86rem; font-weight: 600; color: rgb(255 255 255 / 0.6); }
  .fq-crumbs a { color: rgb(255 255 255 / 0.8); }
  .fq-crumbs span { color: var(--gold); }
  .fq-hero__copy { margin-block: auto; padding-top: clamp(24px, 4vw, 40px); max-width: 620px; min-width: 0; display: grid; gap: 18px; }
  .fq-hero__eyebrow { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--g-300); }
  :global(html[lang='mr']) .fq-hero__eyebrow { letter-spacing: 0; text-transform: none; font-size: 0.95rem; }
  .fq-hero__title { color: #fff; }
  .fq-hero__title em { display: block; color: var(--gold); }
  .fq-hero__lead { color: rgb(255 255 255 / 0.84); }
  .fq-search {
    position: relative; display: flex; align-items: center; gap: 12px; margin-top: 6px; padding: 0 8px 0 18px; height: 60px;
    border-radius: 12px; background: #fff; color: var(--muted); box-shadow: 0 24px 40px -24px rgb(0 0 0 / 0.6);
    border: 2px solid transparent; transition: border-color 0.25s;
  }
  .fq-search:focus-within { border-color: var(--gold); }
  .fq-search :global(.icon) { flex: none; color: var(--g-700); }
  .fq-search input { flex: 1; min-width: 0; height: 100%; border: 0; outline: 0; background: transparent; font: inherit; font-size: 1rem; font-weight: 500; color: var(--ink); }
  .fq-search input::-webkit-search-cancel-button { display: none; }
  .fq-search__clear { flex: none; width: 40px; height: 40px; border: 0; border-radius: 9px; background: var(--g-100); color: var(--g-800); font-size: 1.4rem; line-height: 1; cursor: pointer; }
  .fq-search__clear:hover { background: var(--g-200); }
  .fq-count { font-size: 0.86rem; font-weight: 600; color: rgb(255 255 255 / 0.7); }
  @media (max-width: 899px) {
    .fq-hero { min-height: 0; }
    .fq-hero__img { inset: 0 0 auto 0; height: min(60vw, 300px); }
    .fq-hero::after { background: linear-gradient(180deg, rgb(4 36 23 / 0.35) 0, rgb(4 36 23 / 0.1) 80px, var(--g-950) min(60vw, 300px)); }
    .fq-hero__copy { padding-top: calc(min(60vw, 300px) - 70px); }
  }

  /* ---------- Questions ---------- */
  .fq-sec { background: var(--bg); }
  .fq-grid { display: grid; gap: clamp(32px, 4vw, 56px); align-items: start; }
  @media (min-width: 1000px) {
    .fq-grid { grid-template-columns: minmax(0, 1fr) 380px; }
    .fq-side { position: sticky; top: calc(var(--header-h) + 20px); }
  }
  .fq-list { border-top: 1px solid var(--line); }
  .fq {
    border-bottom: 1px solid var(--line); scroll-margin-top: calc(var(--header-h) + 20px);
    interpolate-size: allow-keywords;
    transition: background 0.35s, box-shadow 0.35s, border-color 0.35s;
  }
  .fq[open] { border-radius: 14px; background: #fff; border-color: transparent; box-shadow: 0 26px 46px -34px rgb(5 42 26 / 0.5); }
  .fq summary {
    display: grid; grid-template-columns: 2.6rem minmax(0, 1fr) 32px; gap: 14px; align-items: center;
    padding: 20px 18px; cursor: pointer; list-style: none;
  }
  .fq summary::-webkit-details-marker { display: none; }
  .fq summary:focus-visible { outline: 2px solid var(--o-500); outline-offset: 2px; border-radius: 12px; }
  .fq__n { font-size: 0.86rem; font-weight: 700; letter-spacing: 0.04em; color: var(--o-600); font-variant-numeric: tabular-nums; }
  .fq__q { font-size: 1.06rem; font-weight: 700; line-height: 1.4; color: var(--g-900); transition: color 0.25s; }
  .fq summary:hover .fq__q { color: var(--o-strong-hover); }
  /* Plus that turns into a minus */
  .fq__pm { position: relative; width: 32px; height: 32px; border-radius: 50%; border: 1.5px solid var(--line); transition: background 0.3s, border-color 0.3s; }
  .fq__pm::before, .fq__pm::after { content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 2px; margin: -1px 0 0 -6px; border-radius: 2px; background: var(--g-800); transition: transform 0.35s var(--ease-out), background 0.3s; }
  .fq__pm::after { transform: rotate(90deg); }
  .fq[open] .fq__pm { background: var(--o-500); border-color: var(--o-500); }
  .fq[open] .fq__pm::before, .fq[open] .fq__pm::after { background: #fff; }
  .fq[open] .fq__pm::after { transform: rotate(0deg); }
  /* Answers slide open where the browser supports it */
  .fq::details-content { block-size: 0; overflow: clip; transition: block-size 0.45s var(--ease-out), content-visibility 0.45s allow-discrete; }
  .fq[open]::details-content { block-size: auto; }
  .fq__a { padding: 0 24px 26px calc(2.6rem + 32px); color: var(--ink-2); }
  .fq__a :global(p), .fq__a :global(li) { max-width: 74ch; }
  .fq__a :global(a) { color: var(--g-700); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .fq-none { margin-top: 20px; padding: 18px 20px; border-radius: 12px; background: #fff; border: 1px dashed var(--line); font-weight: 600; color: var(--g-900); }
  @media (max-width: 599px) {
    .fq summary { grid-template-columns: 2rem minmax(0, 1fr) 28px; gap: 10px; padding: 16px 12px; }
    .fq__q { font-size: 0.98rem; }
    .fq__pm { width: 28px; height: 28px; }
    .fq__a { padding: 0 14px 20px; }
  }

  /* ---------- Helpline card: white slip with an orange top edge ---------- */
  .fq-side { display: grid; gap: 22px; }
  .fq-help { display: grid; gap: 10px; justify-items: start; padding: 26px; border-radius: var(--r-lg); background: #fff; border-top: 4px solid var(--o-500); box-shadow: 0 26px 46px -34px rgb(5 42 26 / 0.5); }
  .fq-help__eyebrow { font-size: 0.76rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--o-600); }
  :global(html[lang='mr']) .fq-help__eyebrow { letter-spacing: 0; text-transform: none; font-size: 0.9rem; }
  .fq-help__title { font-size: 1.35rem; color: var(--g-900); }
  .fq-help__text { color: var(--muted); font-size: 0.95rem; }
  .fq-help__phone { margin-top: 4px; font-size: clamp(1.5rem, 2.4vw, 1.8rem); font-weight: 800; letter-spacing: -0.01em; color: var(--g-800); font-variant-numeric: tabular-nums; border-bottom: 2px solid var(--gold); line-height: 1.3; transition: color 0.25s; }
  .fq-help__phone:hover { color: var(--o-strong-hover); }
  .fq-help .link-arrow { font-size: 0.9rem; overflow-wrap: anywhere; }

  @media (prefers-reduced-motion: reduce) {
    .fq-hero__img { animation: none; }
    .fq::details-content { transition: none; }
  }
</style>
