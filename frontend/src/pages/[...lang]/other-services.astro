---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import CtaBand from '../../components/CtaBand.astro';
import { servicesFor } from '../../data/services';
import { siteData } from '../../data/site';
import { getLang, langPaths, localePath } from '../../i18n';
import { pageCopy, useT } from '../../i18n/ui';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

export function getStaticPaths() {
  return langPaths();
}

const lang = getLang(Astro);
const t = useT(lang);
const l = (p: string) => localePath(p, lang);
const { site } = siteData(lang);
const { services } = servicesFor(lang);
const english = servicesFor('en').services;

const c = pageCopy(
  lang,
  'other-services',
  {
    metaTitle: 'Other Services',
    metaDescription: 'Net banking, mobile banking, IMPS & UPI, NEFT/RTGS, SMS banking, safe deposit lockers and utility bill payments at Lokmangal Multistate.',
    eyebrow: 'Other services',
    title: 'Banking that',
    accent: 'saves your time',
    lead: 'Use your account from your phone or computer, send money in seconds, and keep valuables safe at the branch.',
    getApp: 'Get it on',
    store: 'Google Play',
    enquire: 'Make an enquiry',
    anywhereEyebrow: 'Bank from anywhere',
    anywhereTitle: 'Your account,',
    anywhereAccent: 'on your phone',
    anywhereLead: 'Check your balance, pay and send money without visiting a branch.',
    branchEyebrow: 'At your branch',
    branchTitle: 'Help you can',
    branchAccent: 'walk in for',
    appLink: 'Download the app',
    branchLink: 'Find your branch',
    stepsEyebrow: 'Getting started',
    stepsTitle: 'Start in',
    stepsAccent: 'three steps',
    s1: 'Visit your branch',
    s1t: 'Bring your KYC documents and fill a short form to switch on the services you want.',
    s2: 'Install the app',
    s2t: 'Download the Lokmangal app and register with the mobile number linked to your account.',
    s3: 'Bank from anywhere',
    s3t: 'Check balances, send money and pay bills any time, from your own phone.',
    safety: 'Lokmangal will never ask for your PIN, password or OTP. Do not share them with anyone.',
    formEyebrow: 'Get in touch',
    formTitle: 'An enquiry or a',
    formAccent: 'service request?',
    formLead: 'Write to us and we will get back to you. You can also call {phone} or email {email}.',
    formCard: 'Service enquiry',
  },
  {
    metaTitle: 'इतर सेवा',
    metaDescription: 'लोकमंगल मल्टीस्टेटच्या सेवा: नेट बँकिंग, मोबाइल बँकिंग, आयएमपीएस व यूपीआय, एनईएफटी/आरटीजीएस, एसएमएस बँकिंग, लॉकर आणि बिल भरणा.',
    eyebrow: 'इतर सेवा',
    title: 'तुमचा वेळ',
    accent: 'वाचवणारे बँकिंग',
    lead: 'फोन किंवा संगणकावरून खाते वापरा, काही सेकंदांत पैसे पाठवा आणि मौल्यवान वस्तू शाखेत सुरक्षित ठेवा.',
    getApp: 'डाउनलोड करा',
    store: 'गुगल प्ले',
    enquire: 'चौकशी करा',
    anywhereEyebrow: 'कुठूनही बँकिंग',
    anywhereTitle: 'तुमचे खाते,',
    anywhereAccent: 'तुमच्या फोनवर',
    anywhereLead: 'शाखेत न जाता शिल्लक पाहा, बिले भरा आणि पैसे पाठवा.',
    branchEyebrow: 'तुमच्या शाखेत',
    branchTitle: 'शाखेत मिळणाऱ्या',
    branchAccent: 'सुविधा',
    appLink: 'ॲप डाउनलोड करा',
    branchLink: 'तुमची शाखा शोधा',
    stepsEyebrow: 'सुरुवात कशी करावी',
    stepsTitle: 'फक्त',
    stepsAccent: 'तीन पायऱ्या',
    s1: 'शाखेत या',
    s1t: 'केवायसी कागदपत्रे घेऊन या आणि हव्या त्या सेवा सुरू करण्यासाठी छोटा फॉर्म भरा.',
    s2: 'ॲप डाउनलोड करा',
    s2t: 'लोकमंगल ॲप डाउनलोड करा आणि खात्याशी जोडलेल्या मोबाइल क्रमांकाने नोंदणी करा.',
    s3: 'कुठूनही बँकिंग',
    s3t: 'कधीही, तुमच्या स्वतःच्या फोनवरून शिल्लक पाहा, पैसे पाठवा आणि बिले भरा.',
    safety: 'लोकमंगल कधीही तुमचा पिन, पासवर्ड किंवा ओटीपी विचारत नाही. तो कोणालाही सांगू नका.',
    formEyebrow: 'संपर्क',
    formTitle: 'चौकशी असो किंवा',
    formAccent: 'सेवेची विनंती',
    formLead: 'आम्हाला लिहा, आम्ही तुम्हाला उत्तर देऊ. तुम्ही {phone} वर कॉल करू शकता किंवा {email} वर ईमेल करू शकता.',
    formCard: 'सेवा चौकशी',
  },
);

// Each service is matched by its English title (staff can reword it in the admin panel without breaking this).
type Key = 'mobile' | 'net' | 'upi' | 'neft' | 'sms' | 'locker' | 'bills';
const keyOf: Record<string, Key> = {
  'Mobile Banking': 'mobile',
  'Net Banking': 'net',
  'IMPS & UPI': 'upi',
  'NEFT / RTGS': 'neft',
  'SMS Banking': 'sms',
  'Safe Deposit Lockers': 'locker',
  'Utility Bill Payments': 'bills',
};
const tone: Record<Key, string> = {
  mobile: 'var(--g-700)',
  net: 'var(--o-strong-hover)',
  upi: '#6b4a07',
  neft: 'var(--g-900)',
  sms: '#8f3608',
  locker: 'var(--g-800)',
  bills: 'var(--o-600)',
};
// A new photo saved as /images/services/photo-<key>.webp replaces the old one automatically.
const photoFor = (key: Key | undefined, old?: string) => {
  const own = key && `/images/services/photo-${key}.webp`;
  if (own && existsSync(join(process.cwd(), 'public', own))) return own;
  if (key === 'mobile') return '/images/home/mobile-banking.webp';
  return old ?? '/images/home/intro.webp';
};
const all = services.map((s, i) => {
  const key = keyOf[english[i]?.title ?? ''];
  return { ...s, key, id: key ?? `service-${i + 1}`, photo: photoFor(key, s.image), tone: key ? tone[key] : 'var(--g-800)' };
});
const digital = all.filter((s) => s.key && s.key !== 'locker' && s.key !== 'bills');
const atBranch = all.filter((s) => !digital.includes(s));
// The mobile app leads the grid.
digital.sort((a, b) => (a.key === 'mobile' ? -1 : b.key === 'mobile' ? 1 : 0));

const bannerOwn = '/images/services/banner.webp';
const banner = existsSync(join(process.cwd(), 'public', bannerOwn)) ? bannerOwn : '/images/hero/hero-2.webp';
const steps = [1, 2, 3].map((n) => ({ title: c(`s${n}` as 's1'), text: c(`s${n}t` as 's1t') }));
---

<Base title={c('metaTitle')} description={c('metaDescription')}>
  <!-- BANNER -->
  <section class="os-hero">
    <img src={banner} alt="" class="os-hero__img" width="1920" height="1080" fetchpriority="high" />
    <div class="container os-hero__inner">
      <nav class="os-crumbs" aria-label={t('breadcrumb')}>
        <a href={l('/')}>{t('home')}</a>
        <Icon name="chevron-right" size={14} />
        <span aria-current="page">{c('eyebrow')}</span>
      </nav>
      <div class="os-hero__copy">
        <p class="os-hero__eyebrow">{c('eyebrow')}</p>
        <h1 class="h1 os-hero__title" data-reveal>{c('title')} <em>{c('accent')}</em></h1>
        <p class="lead os-hero__lead" data-reveal style="--d:120ms">{c('lead')}</p>
        <ul class="os-chips" data-stagger>
          {all.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
        </ul>
        <div class="btn-row" data-reveal style="--d:280ms">
          <a href={site.appUrl} target="_blank" rel="noopener" class="os-play">
            <svg width="22" height="24" viewBox="0 0 24 26" aria-hidden="true"><path d="M2 1.2 14 13 2 24.8c-.6-.3-1-1-1-1.8V3c0-.8.4-1.5 1-1.8Z" fill="#34A853" /><path d="m18.2 8.8-4.2 4.2 4.2 4.2 4.6-2.6c1.6-.9 1.6-2.3 0-3.2l-4.6-2.6Z" fill="#FBBC04" /><path d="M2 1.2c.4-.2 1-.2 1.6.1l14.6 7.5L14 13 2 1.2Z" fill="#4285F4" /><path d="M14 13l4.2 4.2-14.6 7.5c-.6.3-1.2.3-1.6.1L14 13Z" fill="#EA4335" /></svg>
            <span><small>{c('getApp')}</small>{c('store')}</span>
          </a>
          <a href="#enquiry" class="btn btn--outline-light btn--lg">{c('enquire')}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- DIGITAL SERVICES: a bento of photo tiles -->
  <section class="section os-digital">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{c('anywhereEyebrow')}</p>
        <h2 class="h2">{c('anywhereTitle')} <em>{c('anywhereAccent')}</em></h2>
        <p class="lead">{c('anywhereLead')}</p>
      </div>
      <ul class="os-bento" data-stagger>
        {digital.map((s, i) => (
          <li class:list={['os-tile', `os-tile--${i}`]} id={s.id} style={`--tone:${s.tone}`}>
            <img src={s.photo} alt="" class="os-tile__img" width="1200" height="800" loading="lazy" />
            <span class="os-tile__n">{String(i + 1).padStart(2, '0')}</span>
            <div class="os-tile__body">
              <h3 class="os-tile__title">{s.title}</h3>
              <p class="os-tile__text">{s.text}</p>
              {(s.key === 'mobile' || s.key === 'net' || s.key === 'upi') ? (
                <a href={site.appUrl} target="_blank" rel="noopener" class="os-tile__link">{c('appLink')} <Icon name="arrow-up-right" size={16} /></a>
              ) : (
                <a href={l('/branches/')} class="os-tile__link">{c('branchLink')} <Icon name="arrow-right" size={16} /></a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- AT THE BRANCH -->
  {atBranch.length > 0 && (
    <section class="section os-branch">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">{c('branchEyebrow')}</p>
          <h2 class="h2">{c('branchTitle')} <em>{c('branchAccent')}</em></h2>
        </div>
        <ul class="os-wide" data-stagger>
          {atBranch.map((s) => (
            <li class="os-row" id={s.id} style={`--tone:${s.tone}`}>
              <div class="os-row__media"><img src={s.photo} alt="" width="1200" height="800" loading="lazy" /></div>
              <div class="os-row__body">
                <h3 class="os-row__title">{s.title}</h3>
                <p>{s.text}</p>
                <a href={l('/branches/')} class="link-arrow">{c('branchLink')} <Icon name="arrow-right" size={16} /></a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- GETTING STARTED -->
  <section class="section os-steps-sec">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">{c('stepsEyebrow')}</p>
        <h2 class="h2">{c('stepsTitle')} <em>{c('stepsAccent')}</em></h2>
      </div>
      <ol class="os-steps">
        <span class="os-steps__line" aria-hidden="true"></span>
        {steps.map((s, i) => (
          <li data-reveal style={`--d:${i * 140}ms`}>
            <span class="os-steps__n">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="os-safety" data-reveal><Icon name="shield-check" size={20} /> {c('safety')}</p>
    </div>
  </section>

  <!-- ENQUIRY -->
  <section class="section os-enquiry" id="enquiry">
    <div class="container split">
      <div class="stack" style="--stack:1.2rem" data-reveal>
        <p class="eyebrow">{c('formEyebrow')}</p>
        <h2 class="h2">{c('formTitle')} <em>{c('formAccent')}</em></h2>
        <p class="lead" set:html={c('formLead', {
          phone: `<a href="${site.phoneHref}" class="text-green"><strong>${site.phone}</strong></a>`,
          email: `<a href="mailto:${site.email}" class="text-green"><strong>${site.email}</strong></a>`,
        })} />
      </div>
      <div data-reveal="right"><EnquiryForm variant="service" title={c('formCard')} /></div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* ---------- Banner ---------- */
  .os-hero { position: relative; isolation: isolate; overflow: hidden; display: flex; min-height: clamp(560px, 76vh, 720px); color: #fff; background: var(--g-950); }
  .os-hero__img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 70% 40%; animation: os-settle 14s cubic-bezier(0.16, 1, 0.3, 1) both; }
  @keyframes os-settle { from { transform: scale(1.12); } }
  .os-hero::after {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg, rgb(4 36 23 / 0.96) 0%, rgb(4 36 23 / 0.86) 40%, rgb(4 36 23 / 0.4) 72%, rgb(4 36 23 / 0.15) 100%), linear-gradient(0deg, rgb(4 36 23 / 0.6), transparent 35%);
  }
  .os-hero__inner { display: flex; flex-direction: column; padding-block: clamp(40px, 6vw, 72px) clamp(48px, 6vw, 80px); }
  .os-crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 0.86rem; font-weight: 600; color: rgb(255 255 255 / 0.6); }
  .os-crumbs a { color: rgb(255 255 255 / 0.8); }
  .os-crumbs span { color: var(--gold); }
  .os-hero__copy { margin-block: auto; padding-top: clamp(24px, 4vw, 40px); max-width: 620px; display: grid; gap: 18px; }
  .os-hero__eyebrow { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--g-300); }
  :global(html[lang='mr']) .os-hero__eyebrow { letter-spacing: 0; text-transform: none; font-size: 0.95rem; }
  .os-hero__title { color: #fff; }
  .os-hero__title em { display: block; color: var(--gold); }
  .os-hero__lead { color: rgb(255 255 255 / 0.86); }
  .os-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .os-chips a {
    display: inline-block; padding: 7px 13px; border-radius: 999px; font-size: 0.84rem; font-weight: 600; color: #fff;
    background: rgb(255 255 255 / 0.08); border: 1px solid rgb(255 255 255 / 0.22); backdrop-filter: blur(6px);
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }
  .os-chips a:hover { background: var(--gold); border-color: var(--gold); color: var(--ink); }
  .os-play {
    display: inline-flex; align-items: center; gap: 12px; min-height: 58px; padding: 8px 22px 8px 16px; border-radius: 12px;
    background: #111; color: #fff; border: 1px solid #444; transition: background 0.25s, transform 0.35s var(--ease-out);
  }
  .os-play span { display: grid; line-height: 1.1; font-size: 1.12rem; font-weight: 700; }
  .os-play small { font-size: 0.66rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: rgb(255 255 255 / 0.75); }
  :global(html[lang='mr']) .os-play small { text-transform: none; letter-spacing: 0; }
  .os-play:hover { background: #000; transform: translateY(-2px); }
  @media (max-width: 899px) {
    .os-hero { min-height: 0; }
    .os-hero__img { inset: 0 0 auto 0; height: min(66vw, 320px); }
    .os-hero::after { background: linear-gradient(180deg, rgb(4 36 23 / 0.35) 0, rgb(4 36 23 / 0.1) 80px, var(--g-950) min(66vw, 320px)); }
    .os-hero__copy { padding-top: calc(min(66vw, 320px) - 70px); }
  }

  /* ---------- Digital services: bento of photo tiles ---------- */
  .os-digital { background: var(--bg); }
  .os-bento { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(12px, 1.6vw, 18px); grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(230px, 22vw, 290px); }
  .os-tile--0 { grid-column: span 2; grid-row: span 2; }
  .os-tile--1 { grid-column: span 2; }
  .os-tile {
    position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end;
    padding: clamp(16px, 2vw, 24px); border-radius: var(--r-lg); color: #fff; background: var(--tone);
    scroll-margin-top: calc(var(--header-h) + 24px);
    box-shadow: 0 22px 40px -28px rgb(5 42 26 / 0.7);
    transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out);
  }
  .os-tile__img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--ease-out); }
  .os-tile::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, transparent 18%, color-mix(in srgb, var(--tone) 70%, transparent) 52%, var(--tone) 86%); }
  .os-tile__n { position: absolute; top: 14px; right: 16px; font-size: 2.2rem; font-weight: 800; line-height: 1; letter-spacing: -0.04em; color: transparent; -webkit-text-stroke: 1.4px rgb(255 255 255 / 0.85); }
  .os-tile__body { display: grid; gap: 8px; justify-items: start; }
  .os-tile__title { color: #fff; font-size: 1.25rem; line-height: 1.25; }
  .os-tile--0 .os-tile__title { font-size: clamp(1.5rem, 2.6vw, 2rem); }
  .os-tile__text { font-size: 0.9rem; line-height: 1.55; color: rgb(255 255 255 / 0.9); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .os-tile--0 .os-tile__text { font-size: 1rem; -webkit-line-clamp: 4; max-width: 520px; }
  .os-tile__link {
    margin-top: 4px; display: inline-flex; align-items: center; gap: 6px; padding: 8px 13px; border-radius: 9px;
    background: rgb(255 255 255 / 0.14); border: 1px solid rgb(255 255 255 / 0.38); color: #fff; font-weight: 700; font-size: 0.84rem;
    transition: background 0.25s, color 0.25s;
  }
  .os-tile__link:hover { background: #fff; color: var(--tone); }
  .os-tile:hover { transform: translateY(-6px); box-shadow: 0 34px 56px -30px rgb(5 42 26 / 0.8); }
  .os-tile:hover .os-tile__img { transform: scale(1.07); }
  .os-tile:target { box-shadow: 0 0 0 4px var(--gold), 0 34px 56px -30px rgb(5 42 26 / 0.8); }
  @media (max-width: 899px) {
    .os-bento { grid-template-columns: 1fr 1fr; grid-auto-rows: 250px; }
    .os-tile--0 { grid-column: span 2; grid-row: span 1; }
    .os-tile--1 { grid-column: span 2; }
  }
  @media (max-width: 559px) {
    .os-bento { grid-template-columns: 1fr; grid-auto-rows: 240px; }
    .os-tile--0, .os-tile--1 { grid-column: auto; }
    .os-tile__text { -webkit-line-clamp: 2; }
  }

  /* ---------- At the branch ---------- */
  .os-branch { background: var(--surface); }
  .os-wide { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(14px, 2vw, 22px); grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); }
  .os-row {
    display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); overflow: hidden; border-radius: var(--r-lg);
    background: var(--bg); border: 1px solid var(--line-2); scroll-margin-top: calc(var(--header-h) + 24px);
    transition: transform 0.45s var(--ease-out), box-shadow 0.45s var(--ease-out);
  }
  .os-row__media { position: relative; overflow: hidden; min-height: 200px; background: var(--tone); }
  .os-row__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease-out); }
  .os-row__media::after { content: ''; position: absolute; inset: auto 0 0 0; height: 5px; background: var(--tone); }
  .os-row__body { display: grid; gap: 10px; align-content: center; justify-items: start; padding: clamp(18px, 2.4vw, 28px); }
  .os-row__title { font-size: 1.25rem; color: var(--g-900); }
  .os-row__body p { color: var(--muted); font-size: 0.95rem; }
  .os-row:hover { transform: translateY(-4px); box-shadow: 0 26px 44px -30px rgb(120 60 10 / 0.5); }
  .os-row:hover .os-row__media img { transform: scale(1.06); }
  .os-row:target { box-shadow: 0 0 0 4px var(--gold); }
  @media (max-width: 559px) { .os-row { grid-template-columns: 1fr; } .os-row__media { min-height: 180px; } }

  /* ---------- Steps ---------- */
  .os-steps-sec { background: linear-gradient(180deg, #fff8f0, #fdeedd); }
  .os-steps { position: relative; list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(16px, 2vw, 24px); grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .os-steps__line { position: absolute; left: 16%; right: 16%; top: 28px; height: 2px; background: repeating-linear-gradient(90deg, var(--o-300) 0 8px, transparent 8px 14px); }
