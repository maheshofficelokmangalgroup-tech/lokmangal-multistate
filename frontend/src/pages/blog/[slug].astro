---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import BlogCard from '../../components/BlogCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import posts from '../../data/posts';

type Post = (typeof posts)[number] & { content?: string };

export function getStaticPaths() {
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, prev: posts[i + 1] ?? null, next: posts[i - 1] ?? null },
  }));
}
const { post, prev, next } = Astro.props as { post: Post; prev: Post | null; next: Post | null };
const date = new Date(post.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
const isMr = /[ऀ-ॿ]/.test(post.title);
const related = posts.filter((p) => p.slug !== post.slug).slice(0, 3);
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: post.title,
  datePublished: post.date,
  image: post.image ? [new URL(post.image, 'https://lokmangalmultistate.com').href] : undefined,
  publisher: { '@type': 'Organization', name: 'Lokmangal Multistate Co-operative Society Ltd.' },
};
---

<Base title={post.title} description={post.excerpt} image={post.image ?? undefined} jsonLd={articleLd}>
  <article>
    <header class="post-hero">
      <div class="container container--narrow">
        <nav class="post-crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><Icon name="chevron-right" size={14} /><a href="/blog/">Blog</a>
        </nav>
        <p class="post-hero__date" data-reveal="fade"><Icon name="calendar" size={16} /> {date}</p>
        <h1 class="h1 post-hero__title" lang={isMr ? 'mr' : undefined} data-reveal>{post.title}</h1>
      </div>
    </header>

    <div class="container container--narrow post-body">
      {post.image && (
        <a href={post.image} class="post-cover" data-zoom="cover" data-caption={post.title} data-reveal="zoom">
          <img src={post.image} alt={post.title} width="800" height="590" transition:name={`post-${post.id}`} />
        </a>
      )}
      {post.content ? (
        <div class="prose post-content" lang={isMr ? 'mr' : undefined} set:html={post.content} data-reveal />
      ) : (
        <p class="post-content post-content--summary" lang={isMr ? 'mr' : undefined} data-reveal>{post.excerpt}</p>
      )}

      <div class="post-share" data-reveal>
        <span>Share this story</span>
        <a href={`https://wa.me/?text=${encodeURIComponent(`${post.title} ${Astro.url.href}`)}`} target="_blank" rel="noopener" aria-label="Share on WhatsApp"><Icon name="message" size={18} /></a>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener" aria-label="Share on Facebook"><Icon name="facebook" size={18} /></a>
        <button data-share aria-label="Copy link or share"><Icon name="share" size={18} /></button>
      </div>

      <nav class="post-nav" aria-label="More stories">
        {prev ? (
          <a href={`/blog/${prev.slug}/`} class="post-nav__link">
            <span><Icon name="chevron-left" size={16} /> Previous</span>
            <strong lang="mr">{prev.title}</strong>
          </a>
        ) : <span></span>}
        {next && (
          <a href={`/blog/${next.slug}/`} class="post-nav__link post-nav__link--next">
            <span>Next <Icon name="chevron-right" size={16} /></span>
            <strong lang="mr">{next.title}</strong>
          </a>
        )}
      </nav>
    </div>
  </article>

  <section class="section">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div class="section-head__text"><p class="eyebrow">Keep reading</p><h2 class="h2">More <em>stories</em></h2></div>
        <a href="/blog/" class="btn btn--ghost">All stories <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
      </div>
      <div class="grid grid-3" data-stagger>{related.map((p) => <BlogCard post={p} />)}</div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .post-hero {
    position: relative;
    padding: clamp(48px, 7vw, 88px) 0 clamp(140px, 16vw, 220px);
    background: radial-gradient(70% 100% at 100% 0%, rgb(236 106 30 / 0.3), transparent 60%), linear-gradient(160deg, var(--g-900), var(--g-950));
    color: rgb(255 255 255 / 0.75);
  }
  .post-crumbs { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; font-weight: 600; }
  .post-crumbs a:hover { color: #fff; }
  .post-hero__date { display: inline-flex; align-items: center; gap: 8px; margin-top: 26px; font-weight: 700; color: var(--o-300); }
  .post-hero__title { color: #fff; margin-top: 14px; }
  .post-hero__title[lang='mr'] { font-family: var(--font-deva); font-weight: 700; letter-spacing: 0; line-height: 1.25; font-size: clamp(1.9rem, 4.2vw, 3.1rem); }
  .post-body { position: relative; margin-top: clamp(-180px, -13vw, -110px); }
  .post-cover { display: block; border-radius: var(--r-xl); overflow: hidden; box-shadow: var(--shadow-lg); background: var(--g-50); cursor: zoom-in; }
  .post-cover img { width: 100%; height: auto; max-height: 620px; object-fit: cover; }
  .post-content { margin-top: 40px; font-size: 1.12rem; line-height: 1.85; color: var(--ink-2); }
  .post-content[lang='mr'] { font-size: 1.2rem; }
  .post-content--summary { padding-left: 22px; border-left: 4px solid var(--o-400); }
  .post-share { display: flex; align-items: center; gap: 10px; margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--line); }
  .post-share span { font-weight: 700; color: var(--ink); margin-right: 6px; }
  .post-share a, .post-share button { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: var(--g-50); color: var(--g-700); transition: background 0.25s, color 0.25s, transform 0.4s var(--ease-spring); }
  .post-share a:hover, .post-share button:hover { background: var(--o-500); color: #fff; transform: translateY(-3px); }
  .post-share button[data-copied]::after { content: 'Link copied'; position: absolute; translate: 0 -40px; padding: 4px 10px; border-radius: 8px; background: var(--ink); color: #fff; font-size: 0.75rem; white-space: nowrap; }
  .post-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 32px; }
  @media (max-width: 640px) { .post-nav { grid-template-columns: 1fr; } }
  .post-nav__link { display: grid; gap: 6px; padding: 18px 20px; border-radius: var(--r); background: var(--surface); border: 1px solid var(--line-2); transition: border-color 0.3s, transform 0.4s var(--ease-out); }
  .post-nav__link:hover { border-color: var(--g-300); transform: translateY(-3px); }
  .post-nav__link span { display: inline-flex; align-items: center; gap: 4px; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--o-600); }
  .post-nav__link strong { font-family: var(--font-deva); font-weight: 600; color: var(--ink); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .post-nav__link--next { text-align: right; justify-items: end; }
</style>
