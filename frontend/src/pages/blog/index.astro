---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import BlogCard from '../../components/BlogCard.astro';
import posts from '../../data/posts';

const PAGE = 12;
const [feature, ...rest] = posts;
const fDate = new Date(feature.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title="Blog & News" description="Latest stories, branch news and social happenings from the Lokmangal Multistate family.">
  <PageHero
    title="Stories from the"
    accent="Lokmangal family"
    eyebrow="Blog & news"
    subtitle="Articles, branch news and social happenings from across our network."
    crumbs={[{ label: 'Blog' }]}
    compact
  />

  <section class="section">
    <div class="container">
      <a href={`/blog/${feature.slug}/`} class="feature-post" data-reveal="zoom">
        <div class="feature-post__img zoom">{feature.image && <img src={feature.image} alt="" width="800" height="590" transition:name={`post-${feature.id}`} />}</div>
        <div class="feature-post__body">
          <span class="chip chip--orange">Latest story</span>
          <h2 class="h2" lang="mr">{feature.title}</h2>
          <p class="lead" lang="mr">{feature.excerpt}</p>
          <span class="feature-post__meta"><Icon name="calendar" size={16} /> {fDate}</span>
          <span class="btn btn--green">Read story <Icon name="arrow-right" size={18} class="icon--arrow" /></span>
        </div>
      </a>

      <div class="grid grid-3 mt-5" data-blog-grid>
        {rest.map((p, i) => (
          <div class="blog-item" hidden={i >= PAGE} data-blog-item><BlogCard post={p} /></div>
        ))}
      </div>
      {rest.length > PAGE && (
        <div class="center mt-5">
          <button class="btn btn--ghost btn--lg" data-load-more data-step={PAGE}>
            Load more stories <Icon name="chevron-down" size={18} />
          </button>
        </div>
      )}
    </div>
  </section>
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.querySelector<HTMLButtonElement>('[data-load-more]');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const hidden = Array.from(document.querySelectorAll<HTMLElement>('[data-blog-item][hidden]'));
      hidden.slice(0, Number(btn.dataset.step)).forEach((el, i) => {
        el.hidden = false;
        el.animate([{ opacity: 0, transform: 'translateY(24px)' }, { opacity: 1, transform: 'none' }], { duration: 600, delay: i * 50, easing: 'cubic-bezier(.16,1,.3,1)', fill: 'backwards' });
      });
      if (hidden.length <= Number(btn.dataset.step)) btn.remove();
    });
  });
</script>

<style>
  .feature-post { display: grid; gap: 0; border-radius: var(--r-xl); overflow: hidden; background: var(--surface); border: 1px solid var(--line-2); box-shadow: var(--shadow); transition: transform 0.6s var(--ease-out), box-shadow 0.6s; }
  .feature-post:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); }
  @media (min-width: 900px) { .feature-post { grid-template-columns: 1.1fr 1fr; } }
  .feature-post__img { min-height: 300px; background: var(--g-50); }
  .feature-post__img img { width: 100%; height: 100%; object-fit: cover; }
  .feature-post__body { padding: clamp(24px, 4vw, 48px); display: grid; gap: 16px; justify-items: start; align-content: center; }
  .feature-post__body h2 { font-family: var(--font-deva); font-weight: 700; letter-spacing: 0; line-height: 1.3; }
  .feature-post__meta { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); font-weight: 600; font-size: 0.92rem; }
  .blog-item[hidden] { display: none; }
  .blog-item { display: grid; }
</style>
