---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import ApplyShell from '../components/ApplyShell.astro';
import { depositDocuments } from '../data/deposits';

const steps = [
  { title: 'Choose your scheme', text: 'Pick a fixed, recurring, monthly-income or doubling deposit.' },
  { title: 'Share your details', text: 'Submit the form and our team will call you to confirm the plan.' },
  { title: 'Complete KYC', text: 'Visit your nearest branch with your documents and deposit amount.' },
  { title: 'Watch it grow', text: 'Receive your deposit receipt and track it anytime on our app.' },
];
---

<Base title="Apply for a Deposit" description="Apply for a Lokmangal Multistate fixed deposit, recurring deposit, Lakshadish, monthly interest or Daam Duppat scheme online.">
  <PageHero
    title="Save for the"
    accent="future"
    eyebrow="Apply for a deposit account"
    subtitle="Book a fixed deposit at up to 10% p.a., or start a recurring deposit from just ₹100 a month."
    crumbs={[{ label: 'Deposits', href: '/deposits/' }, { label: 'Apply' }]}
    compact
  />
  <ApplyShell steps={steps} docs={depositDocuments}>
    <EnquiryForm variant="deposit" title="Apply now!" subtitle="Fields marked * are required." submitLabel="Submit application" />
  </ApplyShell>
</Base>
