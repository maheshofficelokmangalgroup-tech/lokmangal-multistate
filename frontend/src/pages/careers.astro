---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site, jobOpenings } from '../data/site';

const roles = jobOpenings;
const perks = [
  { icon: 'award', title: 'Learn from the best', text: 'Work alongside experienced professionals in the co-operative sector.' },
  { icon: 'sprout', title: 'Grow with us', text: 'A growing network means real opportunities to take on more responsibility.' },
  { icon: 'heart', title: 'Make a difference', text: 'Your work directly supports farmers, families and small businesses.' },
  { icon: 'users', title: 'Lively culture', text: 'A warm, close-knit team that celebrates success together.' },
];
---

<Base title="Careers" description="Build your career with Lokmangal Multistate Co-operative Society: opportunities in business development, account management and relationship management across Maharashtra & Karnataka.">
  <PageHero
    title="Build a career that"
    accent="matters"
    eyebrow="Careers at Lokmangal"
    subtitle="Looking for an opportunity that motivates you, challenges you and helps you grow? You’ve come to the right place."
    crumbs={[{ label: 'Careers' }]}
  >
    <a href="#apply" class="btn btn--primary">Apply now <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
    <a href={`mailto:${site.hrEmail}`} class="btn btn--outline-light"><Icon name="mail" size={18} /> {site.hrEmail}</a>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Why join us</p>
        <h2 class="h2">More than a job, a <em>purpose</em></h2>
        <p class="lead">As part of Lokmangal Multistate you’ll enjoy a lively work culture and learn from the best in the co-operative sector. We would love to meet you.</p>
      </div>
      <div class="grid grid-4" data-stagger>
        {perks.map((p) => (
          <article class="card card--hover perk">
            <span class="icon-badge"><Icon name={p.icon} size={24} /></span>
            <h3 class="h4">{p.title}</h3>
            <p class="muted">{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Roles we hire for</p>
        <h2 class="h2">Find your <em>place</em> with us</h2>
        <p class="lead">Current openings are announced on this page and at our branches. You are welcome to apply for any of these roles at any time.</p>
      </div>
      <div class="roles" data-stagger>
        {roles.map((r) => (
          <a href="#apply" class="role">
            <span class="icon-badge icon-badge--orange"><Icon name={r.icon} size={22} /></span>
            <div><h3 class="h4">{r.title}</h3><p>{r.text}</p></div>
            <Icon name="arrow-up-right" size={22} class="role__go" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="apply">
    <div class="container split">
      <div class="stack" style="--stack:1.2rem" data-reveal>
        <p class="eyebrow">Apply now</p>
        <h2 class="h2">Send us your <em>application</em></h2>
        <p class="lead">Fill in the form and email your résumé to <a href={`mailto:${site.hrEmail}`} class="text-green"><strong>{site.hrEmail}</strong></a>. Our HR team will get in touch if your profile matches an opening.</p>
        <ul class="check-list">
          <li>Experience in a financial institution is an advantage</li>
          <li>Openings across divisions in Maharashtra & Karnataka</li>
          <li>Head office: {site.address.line1}, {site.address.line2}, {site.address.city}</li>
        </ul>
      </div>
      <div data-reveal="right"><EnquiryForm variant="career" title="Job application" submitLabel="Submit application" /></div>
    </div>
  </section>
</Base>

<style>
  .perk { display: grid; gap: 12px; align-content: start; }
  .roles { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 480px), 1fr)); }
  .role { display: flex; align-items: center; gap: 18px; padding: 24px; border-radius: var(--r-lg); background: var(--bg); border: 1px solid var(--line-2); transition: transform 0.45s var(--ease-out), box-shadow 0.45s, background 0.3s; }
  .role p { font-size: 0.93rem; color: var(--muted); margin-top: 4px; }
  .role :global(.role__go) { margin-left: auto; flex: none; color: var(--muted-2); transition: transform 0.4s var(--ease-out), color 0.3s; }
  .role:hover { transform: translateY(-4px); box-shadow: var(--shadow); background: #fff; }
  .role:hover :global(.role__go) { color: var(--o-500); transform: translate(3px, -3px); }
</style>
