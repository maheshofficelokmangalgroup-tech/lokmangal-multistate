---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqs } from '../data/faq';
import { site } from '../data/site';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() },
  })),
};
---

<Base title="FAQ" description="Frequently asked questions about Lokmangal Multistate Co-operative Society — registration, safety of deposits, interest rates and who can invest." jsonLd={faqLd}>
  <PageHero
    title="Frequently asked"
    accent="questions"
    eyebrow="Help centre"
    subtitle={`Everything you need to know about Lokmangal Multistate — registered under the ${site.act}, Registration No. ${site.registration}.`}
    crumbs={[{ label: 'FAQ' }]}
    compact
  />

  <section class="section">
    <div class="container faq">
      <div class="accordion">
        {faqs.map((f, i) => (
          <details class="acc" open={i === 0} data-reveal style={`--d:${Math.min(i, 5) * 60}ms`}>
            <summary>
              <span class="faq__q"><span class="faq__n">{String(i + 1).padStart(2, '0')}</span>{f.q}</span>
              <span class="acc__icon"><Icon name="chevron-down" size={18} /></span>
            </summary>
            <div class="acc__body prose" set:html={f.a} />
          </details>
        ))}
      </div>

      <aside class="faq__side">
        <div class="faq__help" data-reveal>
          <span class="icon-badge icon-badge--dark"><Icon name="help-circle" size={26} /></span>
          <h2 class="h3">Still have a question?</h2>
          <p>Our team is happy to help. Call us or request a callback.</p>
          <a href={site.phoneHref} class="btn btn--light btn--block"><Icon name="phone" size={18} /> {site.phone}</a>
          <a href={`mailto:${site.email}`} class="btn btn--outline-light btn--block"><Icon name="mail" size={18} /> Email us</a>
        </div>
        <div data-reveal><EnquiryForm variant="callback" title="Request a callback" /></div>
      </aside>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .faq { display: grid; gap: clamp(32px, 4vw, 56px); align-items: start; }
  @media (min-width: 1000px) { .faq { grid-template-columns: minmax(0, 1fr) 380px; } .faq__side { position: sticky; top: calc(var(--header-h) + 20px); } }
  .faq__side { display: grid; gap: 22px; }
  .faq__q { display: flex; gap: 16px; align-items: baseline; }
  .faq__n { font-size: 0.82rem; font-weight: 800; color: var(--o-500); }
  .acc__body { padding-left: 58px; }
  @media (max-width: 600px) { .acc__body { padding-left: 24px; } }
  .faq__help { padding: 30px; border-radius: var(--r-xl); display: grid; gap: 12px; justify-items: start; color: rgb(255 255 255 / 0.78); background: radial-gradient(90% 90% at 100% 0%, rgb(236 106 30 / 0.4), transparent 60%), linear-gradient(150deg, var(--g-800), var(--g-950)); }
  .faq__help h2 { color: #fff; }
</style>
