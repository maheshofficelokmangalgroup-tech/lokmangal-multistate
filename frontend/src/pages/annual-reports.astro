---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import AboutNav from '../components/AboutNav.astro';
import { site, annualReports } from '../data/site';

// Reports are managed in the admin panel (Notices & documents → Annual reports).
const reports = annualReports;
const mail = (y: string) => `mailto:${site.email}?subject=${encodeURIComponent(`Request: Annual Report ${y}`)}`;
---

<Base title="Annual Reports" description="Annual reports of Lokmangal Multistate Co-operative Society Ltd. — performance, audited accounts and disclosures.">
  <PageHero
    title="Annual"
    accent="reports"
    eyebrow="Transparency"
    subtitle="Our books are audited every year and submitted to the Government of India. Members can download or request a copy of our annual reports."
    crumbs={[{ label: 'About Us', href: '/about-us/' }, { label: 'Annual Reports' }]}
    compact
  />

  <section class="section">
    <div class="container">
      <div class="reports" data-stagger>
        {reports.map((r) => (
          <article class="report">
            <div class="report__cover">
              {r.cover ? (
                <img src={r.cover} alt={`Annual Report ${r.year}`} loading="lazy" width="302" height="413" />
              ) : (
                <div class="report__placeholder">
                  <img src="/images/brand/emblem.png" alt="" width="70" height="84" />
                  <span>Annual Report</span>
                  <strong>{r.year}</strong>
                </div>
              )}
            </div>
            <div class="report__body">
              <span class="chip">Financial year</span>
              <h2 class="h3">Annual Report {r.year}</h2>
              {r.file ? (
                <a href={r.file} class="btn btn--green btn--sm" download><Icon name="download" size={16} /> Download PDF</a>
              ) : (
                <a href={mail(r.year)} class="btn btn--ghost btn--sm"><Icon name="mail" size={16} /> Request a copy</a>
              )}
            </div>
          </article>
        ))}
      </div>
      <p class="center muted mt-4" data-reveal>Members can also obtain printed copies of the annual report at any branch or at the head office in Shelgi, Solapur.</p>
    </div>
  </section>

  <AboutNav current="/annual-reports/" />
</Base>

<style>
  .reports { display: grid; gap: 24px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  .report { border-radius: var(--r-lg); overflow: hidden; background: var(--surface); border: 1px solid var(--line-2); transition: transform 0.5s var(--ease-out), box-shadow 0.5s; }
  .report:hover { transform: translateY(-8px) rotate(-0.5deg); box-shadow: var(--shadow); }
  .report__cover { aspect-ratio: 3 / 3.4; display: grid; place-items: center; padding: 26px; background: linear-gradient(160deg, var(--g-50), var(--o-50)); }
  .report__cover > img { max-height: 100%; width: auto; border-radius: 8px; box-shadow: 0 24px 40px -18px rgb(5 42 26 / 0.45); transition: transform 0.6s var(--ease-out); }
  .report:hover .report__cover > img { transform: translateY(-6px) rotate(-2deg); }
  .report__placeholder { width: 72%; aspect-ratio: 3 / 4; display: grid; place-content: center; justify-items: center; gap: 8px; border-radius: 8px; color: #fff; text-align: center; background: linear-gradient(160deg, var(--g-700), var(--g-950)); box-shadow: 0 24px 40px -18px rgb(5 42 26 / 0.55); }
  .report__placeholder img { width: 52px; height: auto; padding: 8px; border-radius: 14px; background: #fff; }
  .report__placeholder span { font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.75; }
  .report__placeholder strong { font-size: 1.3rem; }
  .report__body { padding: 22px; display: grid; gap: 12px; justify-items: start; }
</style>
