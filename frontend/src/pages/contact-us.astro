---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site } from '../data/site';

const cards = [
  { icon: 'map-pin', title: 'Visit us', lines: [`${site.address.line1}, ${site.address.line2}`, `${site.address.city} – ${site.address.pin}, ${site.address.state}`], href: site.mapLink, cta: 'Get directions', ext: true },
  { icon: 'phone', title: 'Call us', lines: [site.phone, 'Mobile banking & general enquiries'], href: site.phoneHref, cta: 'Call now' },
  { icon: 'mail', title: 'Email us', lines: [site.email, `Careers: ${site.hrEmail}`], href: `mailto:${site.email}`, cta: 'Send an email' },
  { icon: 'landmark', title: 'Bank details', lines: [`IFSC: ${site.ifsc}`, `Regd. No. ${site.registration}`], href: '/branches/', cta: 'All branches' },
];
---

<Base title="Contact Us" description={`Contact Lokmangal Multistate Co-operative Society Ltd.: head office at Shelgi, Solapur. Call ${site.phone} or email ${site.email}.`}>
  <PageHero
    title="We’d love to"
    accent="hear from you"
    eyebrow="Contact us"
    subtitle="Questions about deposits, loans or your account? Reach out. Our team is here to help."
    crumbs={[{ label: 'Contact Us' }]}
    compact
  />

  <section class="section">
    <div class="container">
      <div class="contact-cards" data-stagger>
        {cards.map((c) => (
          <a href={c.href} class="card card--hover contact-card" target={c.ext ? '_blank' : undefined} rel={c.ext ? 'noopener' : undefined}>
            <span class="icon-badge icon-badge--orange"><Icon name={c.icon} size={24} /></span>
            <h2 class="h4">{c.title}</h2>
            {c.lines.map((l, i) => <p class:list={{ strong: i === 0 }}>{l}</p>)}
            <span class="link-arrow">{c.cta} <Icon name="arrow-right" size={16} /></span>
          </a>
        ))}
      </div>

      <div class="contact-main">
        <div class="stack" style="--stack:1.25rem" data-reveal="left">
          <p class="eyebrow">Our story in brief</p>
          <h2 class="h2">Serving members <em>since 2004</em></h2>
          <div class="prose muted">
            <p>Lokmangal Multistate Co-operative Society Ltd. was established in 2004 to support the all-round development and prosperity of farmers, consumers and entrepreneurs. It is registered under the {site.act}, Registration No. {site.registration}.</p>
            <p>Full-fledged operations began in 2008 in Solapur district. Today we offer a wide range of financial products through our branches, ATMs and digital channels (internet, phone and mobile banking) across Maharashtra and Karnataka.</p>
          </div>
          <div class="map">
            <iframe src={site.mapEmbed} title="Lokmangal Multistate head office location" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
          </div>
          <div class="social-row">
            <span>Follow us</span>
            {site.social.map((s) => <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.icon} size={18} /></a>)}
          </div>
        </div>
        <div data-reveal="right">
          <EnquiryForm variant="contact" title="Send us a message" subtitle="We usually respond within one working day." submitLabel="Send message" />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-cards { display: grid; gap: 18px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); }
  .contact-card { display: grid; gap: 8px; align-content: start; }
  .contact-card .h4 { margin-top: 8px; }
  .contact-card p { color: var(--muted); font-size: 0.94rem; overflow-wrap: anywhere; }
  .contact-card p.strong { color: var(--ink); font-weight: 700; }
  .contact-card .link-arrow { margin-top: 8px; }
  .contact-main { display: grid; gap: clamp(36px, 5vw, 64px); margin-top: clamp(56px, 7vw, 96px); align-items: start; }
  @media (min-width: 980px) { .contact-main { grid-template-columns: 1fr 1fr; } }
  .map { border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow); aspect-ratio: 16 / 10; background: var(--g-50); }
  .map iframe { width: 100%; height: 100%; border: 0; }
  .social-row { display: flex; align-items: center; gap: 10px; }
  .social-row span { font-weight: 700; color: var(--ink); margin-right: 6px; }
  .social-row a { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: var(--g-50); color: var(--g-700); transition: background 0.25s, color 0.25s, transform 0.4s var(--ease-spring); }
  .social-row a:hover { background: var(--o-500); color: #fff; transform: translateY(-3px) rotate(-6deg); }
</style>
