---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import ApplyShell from '../components/ApplyShell.astro';
import { depositDocuments } from '../data/deposits';

const steps = [
  { title: 'Fill in the form', text: 'Tell us which account you’d like to open. It takes under a minute.' },
  { title: 'We call you back', text: 'Our branch team confirms your details and answers your questions.' },
  { title: 'Visit with your KYC', text: 'Bring your documents to the nearest branch to complete the process.' },
  { title: 'Start banking', text: 'Use your account at any branch, online or on our mobile app.' },
];
---

<Base title="Open an Account" description="Open a savings account, current account or recurring deposit with Lokmangal Multistate. Apply online and our team will call you back.">
  <PageHero
    title="Access your money with"
    accent="ease & convenience"
    eyebrow="Open an account"
    subtitle="Savings, current and recurring deposit accounts, backed by a wide branch network and easy net banking."
    crumbs={[{ label: 'Open an Account' }]}
    compact
  />
  <ApplyShell steps={steps} docs={depositDocuments}>
    <EnquiryForm variant="account" title="Apply now" subtitle="Fields marked * are required." submitLabel="Submit application" />
  </ApplyShell>
</Base>
