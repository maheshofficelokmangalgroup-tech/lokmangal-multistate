# Local development settings for `cargo run` (copy to backend/.env). Never use these values in production.
APP_ENV=development
DATABASE_URL=postgres://lokmangal:lokmangal@127.0.0.1:5432/lokmangal
API_BIND=127.0.0.1:8000
INTERNAL_BIND=127.0.0.1:8001
INTERNAL_URL=http://127.0.0.1:8001
ADMIN_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:4400
PREVIEW_URL=http://localhost:4401
# Serve the active release and previews locally (development only).
DEV_SITE_BIND=127.0.0.1:4400
DEV_PREVIEW_BIND=127.0.0.1:4401
BUILD_SERVICE_URL=http://127.0.0.1:4300
DATA_ROOT=../var
ACTIVATION_DRIVER=file
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=none
RUST_LOG=info,lokmangal=debug
