{
  "name": "lokmangal-multistate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lokmangal Multistate: public website (Astro), admin panel (React) and shared packages. The Rust API lives in backend/.",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "frontend",
    "admin"
  ],
  "scripts": {
    "dev:site": "npm run dev -w @lokmangal/frontend",
    "dev:admin": "npm run dev -w @lokmangal/admin",
    "build:site:seed": "npm run build:seed -w @lokmangal/frontend",
    "build:admin": "npm run build -w @lokmangal/admin",
    "test:finance": "npm test -w @lokmangal/finance",
    "test": "npm test -w @lokmangal/finance && npm test -w @lokmangal/admin --if-present"
  }
}
