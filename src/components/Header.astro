---
import Icon from './Icon.astro';
import { nav, site } from '../data/site';
import { schemes, fmtRate } from '../data/deposits';
import { loans } from '../data/loans';

const path = Astro.url.pathname;
const productPaths = ['/deposits/', '/loans/', '/interest-rates/', '/calculators/', '/apply-for-deposits/', '/apply-loan/'];
const isActive = (href: string, label?: string) => {
  if (href === '/') return path === '/';
  if (label === 'Our Products') return productPaths.some((p) => path.startsWith(p));
  if (label === 'About Us')
    return ['/about-us/', '/chairman-message/', '/board-of-directors/', '/social-responsibility/', '/annual-reports/', '/gallery/'].some((p) => path.startsWith(p));
  return path.startsWith(href);
};
---

<div class="announce" data-announce>
  <div class="container--wide announce__inner">
    <span class="announce__pulse" aria-hidden="true"></span>
    <Icon name="megaphone" size={16} />
    <p><strong>Election 2025:</strong> Board of Directors &amp; Office Bearers election notices are published.</p>
    <a href="/notices/" class="announce__link">View notices <Icon name="arrow-right" size={14} /></a>
    <button class="announce__close" data-announce-close aria-label="Dismiss announcement"><Icon name="x" size={16} /></button>
  </div>
</div>

<div class="topbar">
  <div class="container--wide topbar__inner">
    <div class="topbar__info">
      <a href={`mailto:${site.email}`}><Icon name="mail" size={15} />{site.email}</a>
      <a href={site.phoneHref}><Icon name="phone" size={15} />{site.phone}</a>
      <span class="topbar__ifsc"><Icon name="landmark" size={15} />IFSC: <strong>{site.ifsc}</strong></span>
    </div>
    <div class="topbar__links">
      <a href="/contact-us/">Contact Us</a>
      <a href="/careers/">Careers</a>
      <a href="/blog/">Blog</a>
      <span class="topbar__sep" aria-hidden="true"></span>
      {site.social.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="topbar__social"><Icon name={s.icon} size={15} /></a>
      ))}
    </div>
  </div>
</div>

<header class="header" data-header transition:name="site-header" transition:animate="none">
  <div class="container--wide header__inner">
    <a href="/" class="brand" aria-label="Lokmangal Multistate — home">
      <img src="/images/brand/logo-full.png" alt="Lokmangal — Success through total dedication" width="854" height="253" class="brand__logo" />
    </a>

    <nav class="nav" aria-label="Main">
      <ul class="nav__list">
        {nav.map((item) => (
          <li class:list={['nav__item', { 'has-menu': item.children || item.mega, 'is-mega': item.mega, 'nav__item--home': item.href === '/' }]} data-nav-item>
            {item.children || item.mega ? (
              <button class:list={['nav__link', { 'is-active': isActive(item.href, item.label) }]} aria-expanded="false" data-nav-trigger>
                {item.label}
                <Icon name="chevron-down" size={15} class="nav__chev" />
              </button>
            ) : (
              <a href={item.href} class:list={['nav__link', { 'is-active': isActive(item.href, item.label) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            )}

            {item.children && (
              <div class="dropdown">
                <ul class="dropdown__list">
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} class="dropdown__link">
                        <span class="dropdown__icon"><Icon name={c.icon ?? 'arrow-right'} size={18} /></span>
                        <span>
                          <strong>{c.label}</strong>
                          {c.desc && <small>{c.desc}</small>}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {item.mega && (
              <div class="dropdown mega">
                <div class="mega__col">
                  <a href="/deposits/" class="mega__title"><Icon name="piggy-bank" size={18} /> Deposits <Icon name="arrow-right" size={14} /></a>
                  <ul>
                    {schemes.map((s) => (
                      <li>
                        <a href={`/deposits/${s.slug}/`}>
                          <span>{s.name}</span>
                          <em>{s.rate ? `${fmtRate(s.rate)}%` : '2×'}</em>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="mega__col">
                  <a href="/loans/" class="mega__title"><Icon name="hand-coins" size={18} /> Loans <Icon name="arrow-right" size={14} /></a>
                  <ul class="mega__loans">
                    {loans.map((l) => (
                      <li><a href={`/loans/#${l.slug}`}><span>{l.name}</span></a></li>
                    ))}
                  </ul>
                </div>
                <div class="mega__promo">
                  <span class="chip chip--dark">Vishwamangal FD 2026</span>
                  <p class="mega__rate">10<span>%</span></p>
                  <p class="mega__promo-text">p.a. on fixed deposits of 365 days &amp; above. Special categories earn up to 0.50% extra.</p>
                  <div class="mega__promo-links">
                    <a href="/interest-rates/"><Icon name="percent" size={16} /> Interest rates</a>
                    <a href="/calculators/"><Icon name="calculator" size={16} /> Calculators</a>
                  </div>
                  <a href="/apply-for-deposits/" class="btn btn--primary btn--sm">Book an FD <Icon name="arrow-right" size={16} class="icon--arrow" /></a>
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <button class="search-trigger" data-search-open aria-label="Search the website" aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K">
        <Icon name="search" size={18} />
        <span class="search-trigger__label">Search</span>
        <kbd class="search-trigger__kbd">Ctrl K</kbd>
      </button>
      <div class="nav__item has-menu login" data-nav-item>
        <button class="btn btn--ghost btn--sm login__btn" aria-expanded="false" data-nav-trigger>
          <Icon name="log-in" size={17} /> Login
        </button>
        <div class="dropdown dropdown--right">
          <ul class="dropdown__list">
            <li>
              <a href={site.appUrl} target="_blank" rel="noopener" class="dropdown__link">
                <span class="dropdown__icon"><Icon name="smartphone" size={18} /></span>
                <span><strong>Mobile Banking App</strong><small>Download on Google Play</small></span>
              </a>
            </li>
            <li>
              <a href="/other-services/" class="dropdown__link">
                <span class="dropdown__icon"><Icon name="globe" size={18} /></span>
                <span><strong>Net Banking</strong><small>Activate at your branch</small></span>
              </a>
            </li>
          </ul>
        </div>
      </div>
      <a href="/open-an-account/" class="btn btn--primary btn--sm header__cta">Open Account <Icon name="arrow-right" size={16} class="icon--arrow" /></a>
      <button class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="drawer" data-burger>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="drawer" data-drawer aria-hidden="true">
  <div class="drawer__panel">
    <div class="drawer__top">
      <img src="/images/brand/emblem.png" alt="" width="42" height="51" class="drawer__emblem" />
      <span class="drawer__title">Lokmangal<small>Multistate</small></span>
      <button class="drawer__close" data-drawer-close aria-label="Close menu"><Icon name="x" size={22} /></button>
    </div>
    <button class="drawer__search" data-search-open aria-haspopup="dialog">
      <Icon name="search" size={18} /> Search schemes, loans, branches…
    </button>
    <nav aria-label="Mobile">
      <ul class="drawer__list">
        <li style="--i:0"><a href="/" class="drawer__link">Home</a></li>
        <li style="--i:1">
          <details class="drawer__group">
            <summary class="drawer__link">About Us <Icon name="chevron-down" size={20} /></summary>
            <div class="drawer__sub">
              {nav[1].children!.map((c) => <a href={c.href}>{c.label}</a>)}
            </div>
          </details>
        </li>
        <li style="--i:2">
          <details class="drawer__group">
            <summary class="drawer__link">Deposits <Icon name="chevron-down" size={20} /></summary>
            <div class="drawer__sub">
              <a href="/deposits/"><strong>All deposit schemes</strong></a>
              {schemes.map((s) => <a href={`/deposits/${s.slug}/`}>{s.name}</a>)}
              <a href="/interest-rates/">Interest rates</a>
            </div>
          </details>
        </li>
        <li style="--i:3">
          <details class="drawer__group">
            <summary class="drawer__link">Loans <Icon name="chevron-down" size={20} /></summary>
            <div class="drawer__sub">
              <a href="/loans/"><strong>All loans</strong></a>
              {loans.map((l) => <a href={`/loans/#${l.slug}`}>{l.name}</a>)}
              <a href="/apply-loan/">Apply for a loan</a>
            </div>
          </details>
        </li>
        <li style="--i:4"><a href="/other-services/" class="drawer__link">Other Services</a></li>
        <li style="--i:5"><a href="/rural-wealth-manager/" class="drawer__link">Rural Wealth Manager</a></li>
        <li style="--i:6"><a href="/calculators/" class="drawer__link">Calculators</a></li>
        <li style="--i:7"><a href="/faq/" class="drawer__link">FAQ</a></li>
        <li style="--i:8"><a href="/branches/" class="drawer__link">Branches</a></li>
        <li style="--i:9"><a href="/contact-us/" class="drawer__link">Contact Us</a></li>
      </ul>
    </nav>
    <div class="drawer__foot">
      <a href="/open-an-account/" class="btn btn--primary btn--block">Open an Account <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
      <a href={site.appUrl} target="_blank" rel="noopener" class="btn btn--outline-light btn--block"><Icon name="smartphone" size={18} /> Mobile Banking App</a>
      <div class="drawer__contact">
        <a href={site.phoneHref}><Icon name="phone" size={16} /> {site.phone}</a>
        <a href={`mailto:${site.email}`}><Icon name="mail" size={16} /> {site.email}</a>
      </div>
    </div>
  </div>
</div>

<style>
  /* Announcement */
  .announce {
    background: linear-gradient(90deg, var(--o-strong-hover), var(--o-strong) 55%, #b84c0c);
    color: #fff;
    font-size: 0.86rem;
  }
  .announce.is-hidden { display: none; }
  .announce__inner { display: flex; align-items: center; gap: 10px; min-height: 40px; padding-block: 6px; }
  .announce__inner p { flex: 1; min-width: 0; line-height: 1.4; }
  .announce__pulse {
    width: 8px; height: 8px; border-radius: 50%; background: #fff; flex: none;
    box-shadow: 0 0 0 0 rgb(255 255 255 / 0.7);
    animation: pulse 2s infinite;
  }
  @keyframes pulse { 70% { box-shadow: 0 0 0 10px rgb(255 255 255 / 0); } 100% { box-shadow: 0 0 0 0 rgb(255 255 255 / 0); } }
  .announce__link { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; white-space: nowrap; border-bottom: 1px solid rgb(255 255 255 / 0.5); }
  .announce__link:hover { border-color: #fff; }
  .announce__close { color: #fff; opacity: 0.8; padding: 6px; border-radius: 50%; display: grid; }
  .announce__close:hover { opacity: 1; background: rgb(255 255 255 / 0.15); }
  @media (max-width: 720px) { .announce__inner p { font-size: 0.8rem; } .announce__inner > :global(.icon) { display: none; } }

  /* Top bar */
  .topbar { background: var(--g-950); color: rgb(255 255 255 / 0.72); font-size: 0.84rem; }
  .topbar__inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 42px; }
  .topbar a, .topbar__ifsc { display: inline-flex; align-items: center; gap: 7px; transition: color 0.2s; }
  .topbar a:hover { color: #fff; }
  .topbar__info, .topbar__links { display: flex; align-items: center; gap: 22px; }
  .topbar__ifsc strong { color: var(--o-300); font-weight: 700; letter-spacing: 0.04em; }
  .topbar__sep { width: 1px; height: 16px; background: rgb(255 255 255 / 0.2); }
  .topbar__social { width: 28px; height: 28px; justify-content: center; border-radius: 50%; }
  .topbar__social:hover { background: rgb(255 255 255 / 0.12); }
  .topbar__links { gap: 16px; }
  @media (max-width: 1100px) { .topbar__links > a:not(.topbar__social), .topbar__sep { display: none; } }
  @media (max-width: 760px) { .topbar { display: none; } }

  /* Header */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.86);
    backdrop-filter: saturate(1.6) blur(16px);
    -webkit-backdrop-filter: saturate(1.6) blur(16px);
    border-bottom: 1px solid rgb(228 223 212 / 0.7);
    transition: transform 0.45s var(--ease-out), box-shadow 0.35s, background 0.3s;
  }
  .header.is-scrolled { box-shadow: 0 10px 30px -18px rgb(5 42 26 / 0.35); background: rgb(255 255 255 / 0.94); }
  .header.is-hidden { transform: translateY(-100%); }
  .header__inner { display: flex; align-items: center; gap: 24px; height: var(--header-h); transition: height 0.35s var(--ease-out); }
  .header.is-scrolled .header__inner { height: 72px; }
  .brand { flex: none; display: block; }
  .brand__logo { width: auto; height: 50px; transition: height 0.35s var(--ease-out), transform 0.4s var(--ease-spring); }
  .brand:hover .brand__logo { transform: scale(1.03); }
  .header.is-scrolled .brand__logo { height: 44px; }

  .nav { margin-inline: auto; }
  .nav__list { list-style: none; display: flex; align-items: center; gap: 2px; }
  .nav__item { position: relative; }
  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 10px 13px;
    border-radius: 999px;
    font-weight: 650;
    font-size: 0.93rem;
    color: var(--ink-2);
    white-space: nowrap;
    transition: color 0.2s, background 0.2s;
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 3px;
    width: 18px;
    height: 3px;
    border-radius: 3px;
    background: var(--o-500);
    transform: translateX(-50%) scaleX(0);
    transition: transform 0.35s var(--ease-out);
  }
  .nav__link:hover, .nav__item.is-open > .nav__link { color: var(--g-700); background: var(--g-50); }
  .nav__link.is-active { color: var(--g-700); }
  .nav__link.is-active::after { transform: translateX(-50%) scaleX(1); }
  .nav__chev { transition: transform 0.3s var(--ease-out); }
  .nav__item.is-open .nav__chev { transform: rotate(180deg); }

  .dropdown {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    min-width: 300px;
    padding: 10px;
    background: #fff;
    border-radius: 20px;
    border: 1px solid var(--line-2);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 8px) scale(0.98);
    transform-origin: top center;
    /* closing (exit) is quicker than opening */
    transition: opacity var(--dur-m-exit) var(--ease-in), transform var(--dur-m-exit) var(--ease-in), visibility var(--dur-m-exit);
  }
  .nav__item.is-open > .dropdown,
  .nav__item.has-menu:hover > .dropdown {
    transition: opacity var(--dur-m) var(--ease-out), transform var(--dur-m) var(--ease-out), visibility var(--dur-m);
  }
  .dropdown::before { content: ''; position: absolute; inset: -14px 0 auto; height: 14px; }
  .dropdown--right { left: auto; right: 0; transform: translate(0, 10px) scale(0.98); transform-origin: top right; }
  .nav__item.is-open > .dropdown { opacity: 1; visibility: visible; transform: translate(-50%, 0) scale(1); }
  .nav__item.is-open > .dropdown--right { transform: translate(0, 0) scale(1); }
  @media (hover: hover) and (min-width: 1281px) {
    .nav__item.has-menu:hover > .dropdown { opacity: 1; visibility: visible; transform: translate(-50%, 0) scale(1); }
    .nav__item.has-menu:hover > .dropdown--right { transform: translate(0, 0) scale(1); }
    .nav__item.has-menu:hover > .nav__link .nav__chev { transform: rotate(180deg); }
  }
  .dropdown__list { list-style: none; display: grid; gap: 2px; }
  .dropdown__link { display: flex; align-items: center; gap: 14px; padding: 10px 12px; border-radius: 14px; transition: background 0.2s; }
  .dropdown__link strong { display: block; font-size: 0.93rem; color: var(--ink); font-weight: 700; }
  .dropdown__link small { display: block; font-size: 0.8rem; color: var(--muted); }
  .dropdown__icon { display: grid; place-items: center; width: 40px; height: 40px; flex: none; border-radius: 12px; background: var(--g-50); color: var(--g-600); transition: background 0.25s, color 0.25s, transform 0.4s var(--ease-spring); }
  .dropdown__link:hover { background: var(--bg); }
  .dropdown__link:hover .dropdown__icon { background: var(--g-600); color: #fff; transform: rotate(-6deg); }

  .mega {
    display: grid;
    grid-template-columns: 1.15fr 1fr 0.95fr;
    gap: 8px;
    width: min(920px, calc(100vw - 48px));
    padding: 14px;
  }
  .mega__col { padding: 12px; }
  .mega__title { display: inline-flex; align-items: center; gap: 8px; font-weight: 800; color: var(--g-700); margin-bottom: 10px; font-size: 0.98rem; }
  .mega__title:hover { color: var(--o-600); }
  .mega ul { list-style: none; display: grid; gap: 1px; }
  .mega ul a { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 7px 10px; border-radius: 10px; font-size: 0.89rem; color: var(--ink-2); transition: background 0.2s, color 0.2s, padding 0.3s var(--ease-out); }
  .mega ul a:hover { background: var(--g-50); color: var(--g-700); padding-left: 14px; }
  .mega ul em { font-style: normal; font-weight: 800; font-size: 0.78rem; color: var(--o-700); background: var(--o-50); padding: 2px 8px; border-radius: 999px; }
  .mega__promo {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    padding: 22px;
    color: rgb(255 255 255 / 0.8);
    background: radial-gradient(120% 90% at 100% 0%, rgb(236 106 30 / 0.55), transparent 55%), linear-gradient(160deg, var(--g-800), var(--g-950));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .mega__rate { font-size: 4.2rem; font-weight: 800; line-height: 0.95; color: #fff; letter-spacing: -0.04em; }
  .mega__rate span { font-size: 2rem; color: var(--o-400); }
  .mega__promo-text { font-size: 0.85rem; line-height: 1.5; }
  .mega__promo-links { display: grid; gap: 6px; margin: 4px 0 8px; font-size: 0.88rem; font-weight: 600; }
  .mega__promo-links a { display: inline-flex; align-items: center; gap: 8px; color: #fff; }
  .mega__promo-links a:hover { color: var(--o-300); }
  .nav__item.is-mega { position: static; }
  .nav__item.is-mega > .dropdown { left: 50%; }
  .nav { position: static; }
  .header__inner { position: relative; }

  .header__actions { display: flex; align-items: center; gap: 10px; flex: none; }
  .search-trigger {
    display: inline-flex; align-items: center; gap: 8px; min-height: 42px; padding: 8px 10px 8px 14px;
    border-radius: 999px; border: 1.5px solid var(--line); background: #fff; color: var(--muted);
    font-size: 0.88rem; font-weight: 600;
    transition: border-color var(--dur-s), color var(--dur-s), box-shadow var(--dur-s);
  }
  .search-trigger:hover { border-color: var(--g-400); color: var(--g-700); box-shadow: 0 0 0 4px rgb(35 146 82 / 0.08); }
  .search-trigger__kbd { font: 700 0.7rem/1 var(--font-sans); padding: 5px 7px; border-radius: 8px; background: var(--bg); border: 1px solid var(--line); color: var(--muted); }
  @media (max-width: 1699px) { .search-trigger__label, .search-trigger__kbd { display: none; } .search-trigger { width: 42px; padding: 0; justify-content: center; } }
  /* The logo already links home; keep the desktop nav lean (Home stays in the mobile menu). */
  .nav__item--home { display: none; }
  .login { position: relative; }
  .login__btn { gap: 8px; }

  /* Burger */
  .burger { display: none; position: relative; width: 46px; height: 46px; border-radius: 14px; background: var(--g-50); border: 1px solid var(--g-100); }
  .burger span { position: absolute; left: 13px; right: 13px; height: 2px; border-radius: 2px; background: var(--g-800); transition: transform 0.4s var(--ease-out), opacity 0.2s, top 0.4s var(--ease-out); }
  .burger span:nth-child(1) { top: 16px; }
  .burger span:nth-child(2) { top: 22px; right: 18px; }
  .burger span:nth-child(3) { top: 28px; }
  .burger[aria-expanded='true'] span:nth-child(1) { top: 22px; transform: rotate(45deg); }
  .burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded='true'] span:nth-child(3) { top: 22px; transform: rotate(-45deg); }

  @media (max-width: 1440px) {
    .nav__link { padding: 10px 9px; font-size: 0.9rem; }
    .header__inner { gap: 16px; }
  }
  @media (max-width: 1280px) {
    .nav, .login { display: none; }
    .burger { display: block; }
    .header__actions { margin-left: auto; }
  }
  @media (max-width: 480px) {
    .header__cta { display: none; }
    .brand__logo { height: 42px; }
    .header__inner { height: 70px; }
  }

  /* Drawer */
  .drawer {
    position: fixed;
    inset: 0;
    z-index: 60;
    visibility: hidden;
    pointer-events: none;
  }
  .drawer::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(5 42 26 / 0.5);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .drawer__panel {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(100%, 440px);
    padding: 18px 24px 28px;
    overflow-y: auto;
    background: radial-gradient(90% 50% at 100% 0%, rgb(236 106 30 / 0.28), transparent 60%), var(--g-950);
    color: #fff;
    transform: translateX(100%);
    transition: transform var(--dur-l-exit) var(--ease-in);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .drawer { overflow: hidden; transition: visibility 0s linear var(--dur-l-exit); }
  .drawer.is-open { visibility: visible; pointer-events: auto; transition: visibility 0s; }
  .drawer.is-open::before { opacity: 1; }
  .drawer.is-open .drawer__panel { transform: none; transition: transform var(--dur-l) var(--ease-out); }
  .drawer__search {
