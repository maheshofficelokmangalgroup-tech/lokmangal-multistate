---
import Icon from './Icon.astro';

interface Props {
  title: string;
  accent?: string;
  eyebrow?: string;
  subtitle?: string;
  crumbs?: { label: string; href?: string }[];
  compact?: boolean;
}
const { title, accent, eyebrow, subtitle, crumbs = [], compact = false } = Astro.props;
const words = title.split(' ');
const accentWords = accent ? accent.split(' ') : [];
const hasAside = Astro.slots.has('aside');
---

<section class:list={['page-hero grain', { 'page-hero--compact': compact, 'page-hero--aside': hasAside }]}>
  <div class="blobs" aria-hidden="true">
    <span class="blob blob--o" style="width:480px;height:480px;right:-120px;top:-180px"></span>
    <span class="blob blob--g" style="width:420px;height:420px;left:-140px;bottom:-220px;animation-delay:-5s"></span>
    <span class="blob blob--gold" style="width:260px;height:260px;right:28%;bottom:-160px;opacity:.25;animation-delay:-9s"></span>
  </div>
  <img src="/images/brand/emblem.png" alt="" class="page-hero__emblem" width="210" height="253" aria-hidden="true" />

  <div class="container page-hero__inner">
    <div class="page-hero__content">
      <nav class="crumbs" aria-label="Breadcrumb" data-reveal="fade">
        <a href="/"><Icon name="home" size={14} /> Home</a>
        {crumbs.map((c) => (
          <>
            <Icon name="chevron-right" size={14} class="crumbs__sep" />
            {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
          </>
        ))}
      </nav>
      {eyebrow && <p class="eyebrow" data-reveal style="--d:80ms">{eyebrow}</p>}
      <h1 class="h1 words" data-words>
        {words.map((w, i) => (<><span class="w"><span style={`--i:${i}`}>{w}</span></span>{' '}</>))}
        {accentWords.length > 0 && (
          <em>{accentWords.map((w, i) => (<><span class="w"><span style={`--i:${i + words.length}`}>{w}</span></span>{i < accentWords.length - 1 ? ' ' : ''}</>))}</em>
        )}
      </h1>
      {subtitle && <p class="lead" data-reveal style="--d:280ms">{subtitle}</p>}
      {Astro.slots.has('default') && <div class="page-hero__actions" data-reveal style="--d:380ms"><slot /></div>}
    </div>
    {hasAside && <div class="page-hero__aside" data-reveal="right" style="--d:250ms"><slot name="aside" /></div>}
  </div>

  <svg class="page-hero__wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 80V40C240 8 480 0 720 18s480 46 720 22v40Z" fill="currentColor"></path>
  </svg>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: rgb(255 255 255 / 0.76);
    background:
      radial-gradient(80% 120% at 85% -10%, rgb(236 106 30 / 0.32), transparent 55%),
      radial-gradient(60% 90% at 0% 110%, rgb(35 146 82 / 0.45), transparent 60%),
      linear-gradient(160deg, var(--g-900), var(--g-950) 70%);
    padding: clamp(56px, 8vw, 104px) 0 clamp(96px, 11vw, 150px);
  }
  .page-hero--compact { padding-bottom: clamp(84px, 9vw, 120px); }
  .page-hero__inner { position: relative; z-index: 1; display: grid; gap: 40px; align-items: center; }
  @media (min-width: 1000px) { .page-hero--aside .page-hero__inner { grid-template-columns: 1.15fr 0.85fr; } }
  .page-hero__content { max-width: 820px; }
  .page-hero__content > * + * { margin-top: 18px; }
  .page-hero h1 { color: #fff; }
  .page-hero h1 em { color: var(--o-400); }
  .page-hero .eyebrow { color: var(--g-300); }
  .page-hero .lead { color: rgb(255 255 255 / 0.74); max-width: 640px; }
  .page-hero__actions { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 10px; }

  .crumbs {
    display: flex; width: fit-content; max-width: 100%; flex-wrap: wrap; align-items: center; gap: 6px;
    padding: 7px 14px; border-radius: 999px;
    background: rgb(255 255 255 / 0.07); border: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.82rem; font-weight: 600; backdrop-filter: blur(6px);
  }
  .crumbs a { display: inline-flex; align-items: center; gap: 6px; color: rgb(255 255 255 / 0.7); transition: color 0.2s; }
  .crumbs a:hover { color: #fff; }
  .crumbs span { color: var(--o-300); }
  .crumbs :global(.crumbs__sep) { opacity: 0.4; }

  .page-hero__emblem {
    position: absolute;
    right: -60px;
    top: 50%;
    width: clamp(260px, 32vw, 460px);
    height: auto;
    translate: 0 -50%;
    filter: brightness(0) invert(1);
    opacity: 0.045;
    z-index: 0;
    animation: emblem-spin 80s linear infinite;
    pointer-events: none;
  }
  @keyframes emblem-spin { to { rotate: 360deg; } }
  .page-hero--aside .page-hero__emblem { opacity: 0.03; }

  .page-hero__wave { position: absolute; left: 0; right: 0; bottom: -1px; width: 100%; height: clamp(36px, 5vw, 72px); color: var(--bg); z-index: 1; }
</style>
