---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import ApplyShell from '../components/ApplyShell.astro';

const steps = [
  { title: 'Tell us your need', text: 'Choose a loan type and the amount you require.' },
  { title: 'Eligibility check', text: 'A loan officer calls you to explain eligibility, security and documents.' },
  { title: 'Submit documents', text: 'Visit your branch with the required papers and guarantor details.' },
  { title: 'Quick disbursal', text: 'Once approved, funds are disbursed quickly to your account.' },
];
const docs = ['Photo identity proof & photographs', 'Address proof', 'Income proof / salary certificate / ITR', 'Property 7/12 or valuation (for secured loans)', 'Quotation (for vehicle loans)', 'Guarantor details'];
---

<Base title="Apply for a Loan" description="Apply online for an agriculture, housing, vehicle, personal, business, mortgage, microfinance or bachat gat loan with Lokmangal Multistate.">
  <PageHero
    title="Loans for all your"
    accent="financial needs"
    eyebrow="Apply for a loan"
    subtitle="Quick processing, minimal paperwork and a branch team that understands you."
    crumbs={[{ label: 'Loans', href: '/loans/' }, { label: 'Apply' }]}
    compact
  />
  <ApplyShell steps={steps} docs={docs} docsTitle="Documents usually required">
    <EnquiryForm variant="loan" title="Apply now" subtitle="Fields marked * are required." submitLabel="Submit application" />
  </ApplyShell>
</Base>
