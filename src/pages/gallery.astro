---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import AboutNav from '../components/AboutNav.astro';
import { gallery } from '../data/site';
---

<Base title="Photo Gallery" description="Moments from Lokmangal Multistate — celebrations, community programmes and social initiatives.">
  <PageHero title="Photo" accent="gallery" eyebrow="Moments from our journey" subtitle="Celebrations, community programmes and social initiatives from across the Lokmangal family." crumbs={[{ label: 'About Us', href: '/about-us/' }, { label: 'Photo Gallery' }]} compact />

  <section class="section">
    <div class="container">
      <div class="masonry">
        {gallery.map((g, i) => (
          <a href={g.src} class="shot" data-zoom="gallery" data-caption={g.caption} data-reveal="zoom" style={`--d:${(i % 3) * 60}ms`}>
            <img
              src={g.src.replace('/gallery/', '/gallery/thumb/')}
              srcset={`${g.src.replace('/gallery/', '/gallery/thumb/')} 640w, ${g.src} 1400w`}
              sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 400px"
              alt={g.caption}
              width="640"
              height="480"
              loading="lazy"
              decoding="async"
            />
            <span class="shot__cap"><Icon name="search" size={16} /> {g.caption}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <AboutNav current="/gallery/" />
</Base>

<style>
  .masonry { columns: 3 300px; column-gap: 18px; }
  .shot { position: relative; display: block; margin-bottom: 18px; break-inside: avoid; border-radius: var(--r-lg); overflow: hidden; background: var(--g-50); cursor: zoom-in; }
  .shot img { width: 100%; height: auto; transition: transform 1s var(--ease-out), filter 0.5s; }
  .shot:hover img { transform: scale(1.06); filter: saturate(1.1); }
  .shot__cap {
    position: absolute; left: 12px; right: 12px; bottom: 12px; display: flex; align-items: center; gap: 8px;
    padding: 10px 14px; border-radius: 12px; background: rgb(255 255 255 / 0.92); backdrop-filter: blur(6px);
    font-size: 0.86rem; font-weight: 700; color: var(--g-900);
    opacity: 0; transform: translateY(10px); transition: opacity 0.35s, transform 0.45s var(--ease-out);
  }
  .shot:hover .shot__cap, .shot:focus-visible .shot__cap { opacity: 1; transform: none; }
</style>
