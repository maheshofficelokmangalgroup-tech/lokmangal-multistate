---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SchemeCard from '../components/SchemeCard.astro';
import Calculator from '../components/Calculator.astro';
import BlogCard from '../components/BlogCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, stats, notices } from '../data/site';
import { schemes } from '../data/deposits';
import { loans } from '../data/loans';
import { initiatives } from '../data/csr';
import { services } from '../data/services';
import posts from '../data/posts.json';

const slides = [
  {
    eyebrow: 'Welcome to Lokmangal Multistate',
    title: 'A convenient, safe &',
    accent: 'rewarding experience',
    text: 'Savings, deposits and loans for every financial need — from a co-operative that has stood by families, farmers and entrepreneurs since 2004.',
    cta: ['Open an account', '/open-an-account/'],
    cta2: ['Explore deposits', '/deposits/'],
    image: '/images/hero/hero-1.webp',
    pos: '100% 50%',
  },
  {
    eyebrow: 'Be a smart investor',
    title: 'Grow your savings at up to',
    accent: '10% p.a.',
    text: 'A small investment every month can bring you one step closer to your dreams. Choose from fixed, recurring, monthly-income and doubling schemes.',
    cta: ['Start investing', '/deposits/'],
    cta2: ['See interest rates', '/interest-rates/'],
    image: '/images/hero/hero-2.webp',
    pos: '86% 50%',
  },
  {
    eyebrow: 'Fast & hassle-free loans',
    title: 'The right loan for',
    accent: 'every dream',
    text: 'Agriculture, housing, vehicle, business or personal — with many loan products and minimal paperwork, you will find the one that suits you best.',
    cta: ['Get a loan', '/apply-loan/'],
    cta2: ['View all loans', '/loans/'],
    image: '/images/hero/hero-3.webp',
    pos: '84% 40%',
  },
];

const quick = [
  { icon: 'user-plus', title: 'Open an account', text: 'Savings and current accounts with easy access at all our branches.', href: '/open-an-account/', links: [['Savings account', '/open-an-account/?type=Savings%20Account'], ['Current account', '/open-an-account/?type=Current%20Account']] },
  { icon: 'piggy-bank', title: 'Fixed deposits', text: 'Save for the future with our range of deposits at up to 10% p.a.', href: '/deposits/', links: [['Apply now', '/apply-for-deposits/']] },
  { icon: 'calendar', title: 'Recurring deposits', text: 'A small saving each month brings you closer to your dreams.', href: '/deposits/vishvamangal-recurring-deposit/', links: [['Apply now', '/apply-for-deposits/?scheme=Vishwamangal%20Recurring%20Deposit']] },
  { icon: 'hand-coins', title: 'Get a loan', text: 'One-stop solutions for all your financial needs, quickly approved.', href: '/loans/', links: [['Apply now', '/apply-loan/']] },
];

const journey = [
  { year: '2004', title: 'Registered', text: `Registered under the Multi-State Co-operative Societies Act, 2002 (No. ${site.registration}) to empower farmers, consumers and entrepreneurs.` },
  { year: '2008', title: 'Full operations', text: 'Began full-fledged operations in Solapur district, offering financial support to aspiring people from agricultural backgrounds.' },
  { year: 'Growth', title: 'Beyond banking', text: 'Diversified into dairy — with chilling plants at Mangalvedha, Karmala and Sangola — and fertilisers, including IFFCO distribution.' },
  { year: 'Today', title: '60 branches, two states', text: '₹751+ crore in deposits and ₹1195+ crore total business across Maharashtra & Karnataka, with net, mobile and UPI banking.' },
];

// Trust signals — all from the society's registration and FAQ.
const trust = [
  { icon: 'shield-check', title: 'Govt. registered', text: `Multi-State Co-op. Act, 2002 · ${site.registration}` },
  { icon: 'file-text', title: 'Audited every year', text: 'Accounts submitted to the Govt. of India' },
  { icon: 'users', title: 'Member-owned', text: 'Board elected by members at the AGM' },
  { icon: 'lock', title: 'Secure banking', text: 'Device-bound app · IMPS · UPI · NEFT/RTGS' },
];

const featured = schemes.filter((s) => s.featured).slice(0, 6);
const latest = posts.slice(0, 3);
const words = (t: string, offset = 0) => t.split(' ').map((w, i) => ({ w, i: i + offset }));
---

<Base>
  <!-- HERO -->
  <section class="hero grain" data-hero>
    <div class="blobs" aria-hidden="true">
      <span class="blob blob--o" style="width:620px;height:620px;right:-180px;top:-240px"></span>
      <span class="blob blob--g" style="width:560px;height:560px;left:-220px;bottom:-260px;animation-delay:-4s"></span>
      <span class="blob blob--gold" style="width:300px;height:300px;left:38%;top:-140px;opacity:.22;animation-delay:-8s"></span>
    </div>
    <h1 class="sr-only">Lokmangal Multistate Co-operative Society Ltd., Solapur</h1>

    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="hero__kicker" data-reveal="fade">
          <span class="chip chip--dark"><Icon name="shield-check" size={15} /> Multi-State Co-operative Society · Since {site.founded}</span>
        </p>
        <div class="hero__slides">
          {slides.map((s, i) => (
            <div class:list={['hero__slide', { 'is-active': i === 0 }]} data-slide aria-hidden={i !== 0 ? 'true' : 'false'}>
              <p class="eyebrow">{s.eyebrow}</p>
              <h2 class="display hero__title">
                {words(s.title).map(({ w, i: n }) => (<><span class="w"><span style={`--i:${n}`}>{w}</span></span>{' '}</>))}
                <em>{words(s.accent, s.title.split(' ').length).map(({ w, i: n }, k, arr) => (<><span class="w"><span style={`--i:${n}`}>{w}</span></span>{k < arr.length - 1 ? ' ' : ''}</>))}</em>
              </h2>
              <p class="lead hero__text">{s.text}</p>
              <div class="btn-row hero__ctas">
                <a href={s.cta[1]} class="btn btn--primary btn--lg" data-magnetic tabindex={i !== 0 ? -1 : undefined}>{s.cta[0]} <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
                <a href={s.cta2[1]} class="btn btn--outline-light btn--lg" tabindex={i !== 0 ? -1 : undefined}>{s.cta2[0]}</a>
              </div>
            </div>
          ))}
        </div>

        <div class="hero__controls" data-reveal="fade" style="--d:600ms">
          <button class="hero__arrow hero__toggle" data-hero-toggle aria-pressed="false" aria-label="Pause slideshow">
            <svg class="hero__toggle-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1.2" /><rect x="14" y="5" width="4" height="14" rx="1.2" /></svg>
            <svg class="hero__toggle-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l12-7.5z" /></svg>
          </button>
          <button class="hero__arrow" data-hero-prev aria-label="Previous slide"><Icon name="chevron-left" size={20} /></button>
          <div class="hero__dots">
            {slides.map((s, i) => (
              <button class:list={['hero__dot', { 'is-active': i === 0 }]} data-dot aria-label={`Show slide ${i + 1}: ${s.eyebrow}`}><span></span></button>
            ))}
          </div>
          <button class="hero__arrow" data-hero-next aria-label="Next slide"><Icon name="chevron-right" size={20} /></button>
        </div>
        <p class="sr-only" aria-live="polite" data-hero-status></p>
      </div>

      <div class="hero__visual" data-parallax data-drift data-reveal="zoom" style="--d:150ms;--drift:22px">
        <div class="hero__frame">
          {slides.map((s, i) => (
            <img src={s.image} alt="" class:list={['hero__img', { 'is-active': i === 0 }]} data-visual style={`object-position:${s.pos}`} width="1440" height="500" fetchpriority={i === 0 ? 'high' : 'low'} />
          ))}
          <div class="hero__frame-shade" aria-hidden="true"></div>
        </div>

        <div class="float-card float-card--1">
          <span class="icon-badge icon-badge--orange"><Icon name="percent" size={22} /></span>
          <div><strong>10% p.a.</strong><small>Vishwamangal FD 2026</small></div>
        </div>
        <div class="float-card float-card--2">
          <span class="icon-badge"><Icon name="map-pin" size={22} /></span>
          <div><strong>60 branches</strong><small>Maharashtra &amp; Karnataka</small></div>
        </div>
        <div class="float-card float-card--3">
          <div class="mini-chart" aria-hidden="true"><i style="--h:38%"></i><i style="--h:55%"></i><i style="--h:48%"></i><i style="--h:72%"></i><i style="--h:90%"></i></div>
          <div><strong>₹1195+ Cr</strong><small>Total business</small></div>
        </div>

        <div class="seal" aria-hidden="true">
          <svg viewBox="0 0 200 200" class="seal__text">
            <defs><path id="seal-circle" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"></path></defs>
            <text><textPath href="#seal-circle" startOffset="0">SUCCESS THROUGH TOTAL DEDICATION • SINCE 2004 • </textPath></text>
          </svg>
          <img src="/images/brand/emblem.png" alt="" width="60" height="72" />
        </div>
      </div>
    </div>
  </section>

  <!-- STATS RIBBON -->
  <section class="stats-wrap">
    <div class="container">
      <div class="stats" data-stagger>
        {stats.map((s) => (
          <div class="stat">
            <p class="stat__num"><span data-count={s.value} data-prefix={s.prefix} data-suffix={s.suffix}>{s.prefix}{s.value}{s.suffix}</span></p>
            <p class="stat__label">{s.label}</p>
            <p class="stat__sub">{s.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TRUST / PROOF -->
  <section class="trust-wrap" aria-labelledby="trust-title">
    <div class="container">
      <h2 class="sr-only" id="trust-title">Why your savings are safe with Lokmangal</h2>
      <ul class="trust" data-stagger>
        {trust.map((t) => (
          <li class="trust__item">
            <span class="trust__icon"><Icon name={t.icon} size={20} /></span>
            <span><strong>{t.title}</strong><small>{t.text}</small></span>
          </li>
        ))}
      </ul>
      <p class="trust__more" data-reveal="fade"><a href="/faq/" class="link-arrow">How we keep deposits safe <Icon name="arrow-right" size={15} /></a></p>
    </div>
  </section>

  <!-- QUICK ACTIONS -->
  <section class="section section--tight">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">How can we help you today?</p>
        <h2 class="h2">Banking made <em>simple</em> for every family</h2>
      </div>
      <div class="grid grid-4" data-stagger>
        {quick.map((q) => (
          <article class="card card--hover quick">
            <span class="icon-badge icon-badge--orange"><Icon name={q.icon} size={24} /></span>
            <h3 class="h4"><a href={q.href}>{q.title}</a></h3>
            <p class="muted">{q.text}</p>
            <div class="quick__links">
              {q.links.map(([label, href]) => <a href={href} class="link-arrow">{label} <Icon name="arrow-right" size={15} /></a>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="section">
    <div class="container split">
      <div class="intro-visual" data-reveal="left" data-drift style="--drift:16px">
        <div class="intro-visual__main"><img src="/images/home/community.webp" alt="Lokmangal — a business owned by its members" width="444" height="527" loading="lazy" /></div>
        <div class="intro-visual__badge">
          <span class="intro-visual__year">20+</span>
          <span>years of<br />trusted service</span>
        </div>
        <div class="intro-visual__ring" aria-hidden="true"></div>
      </div>
      <div class="stack" style="--stack:1.25rem">
        <p class="eyebrow" data-reveal>Improve your financial flexibility</p>
        <h2 class="h2 words" data-words>
          {words('A co-operative built on').map(({ w, i }) => (<><span class="w"><span style={`--i:${i}`}>{w}</span></span>{' '}</>))}
          <em>{words('trust & dedication', 4).map(({ w, i }, k, arr) => (<><span class="w"><span style={`--i:${i}`}>{w}</span></span>{k < arr.length - 1 ? ' ' : ''}</>))}</em>
        </h2>
        <p class="lead" data-reveal>
          From savings accounts and fixed deposits to loans designed around your needs, Lokmangal Multistate brings complete financial services to towns and villages through 60 branches — backed by net banking, mobile banking and UPI that make everyday life easier.
        </p>
        <ul class="check-list check-list--2" data-stagger>
          <li>Complete trust &amp; transparency</li>
          <li>Highly trained staff</li>
          <li>Trusted branch network</li>
          <li>Robust technology</li>
          <li>Financial inclusion for all</li>
          <li>Member-owned co-operative</li>
        </ul>
        <div class="btn-row" data-reveal>
          <a href="/about-us/" class="btn btn--green">More about us <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
          <a href="/contact-us/" class="btn btn--ghost">Get in touch</a>
        </div>
      </div>
    </div>
  </section>

  <!-- DEPOSITS -->
  <section class="section section--white">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div class="section-head__text">
          <p class="eyebrow">Save for the future</p>
          <h2 class="h2">Deposit schemes that make your <em>money work</em></h2>
          <p class="lead">Be part of the fast-growing Lokmangal family and put your savings to work while you enjoy a fulfilling life.</p>
        </div>
        <a href="/deposits/" class="btn btn--ghost">View all schemes <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
      </div>
      <div class="grid grid-3" data-stagger>
        {featured.map((s, i) => <SchemeCard scheme={s} index={i} />)}
      </div>
    </div>
  </section>

  <!-- CALCULATOR -->
  <section class="section">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Plan with confidence</p>
        <h2 class="h2">See how your money <em>grows</em></h2>
        <p class="lead">Move the sliders to estimate maturity value, monthly income or loan EMI in seconds.</p>
      </div>
      <div data-reveal="zoom"><Calculator /></div>
    </div>
  </section>

  <!-- JOURNEY -->
  <section class="section section--dark grain journey-sec">
    <div class="blobs" aria-hidden="true">
      <span class="blob blob--o" style="width:500px;height:500px;right:-160px;bottom:-200px;opacity:.35"></span>
    </div>
    <div class="container split split--wide-right on-dark" style="position:relative;z-index:1">
      <div class="stack" style="--stack:1.3rem">
        <p class="eyebrow" data-reveal>Building an inclusive economy</p>
        <h2 class="h2" data-reveal>Changing the face &amp; fate of the <em>rural economy</em></h2>
        <p class="lead" data-reveal>
          Standing apart takes something extraordinary. Since our inception, years of hard work in the co-operative space have made Lokmangal one of the leading multi-state co-operative societies in Maharashtra — with inclusive development as a priority for both our business and our community.
        </p>
        <div class="journey-links" data-stagger>
          <a href="/about-us/"><Icon name="landmark" size={18} /> About us <Icon name="arrow-up-right" size={16} /></a>
          <a href="/social-responsibility/"><Icon name="heart" size={18} /> Social responsibility <Icon name="arrow-up-right" size={16} /></a>
          <a href="/branches/"><Icon name="map-pin" size={18} /> Branch locations <Icon name="arrow-up-right" size={16} /></a>
          <a href="/careers/"><Icon name="briefcase" size={18} /> Careers <Icon name="arrow-up-right" size={16} /></a>
        </div>
      </div>
      <ol class="timeline" data-stagger>
        {journey.map((j) => (
          <li class="timeline__item">
            <span class="timeline__dot" aria-hidden="true"></span>
            <div>
              <span class="timeline__year">{j.year}</span>
              <h3 class="h4">{j.title}</h3>
              <p>{j.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- LOANS -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div class="section-head__text">
          <p class="eyebrow">Wide range of loan solutions</p>
          <h2 class="h2">Get a loan that best <em>suits your needs</em></h2>
          <p class="lead">We understand our members completely — and offer loans built around their real requirements.</p>
        </div>
        <div class="carousel-nav">
          <button class="carousel-btn" data-scroll="-1" aria-label="Scroll loans left"><Icon name="chevron-left" size={20} /></button>
          <button class="carousel-btn" data-scroll="1" aria-label="Scroll loans right"><Icon name="chevron-right" size={20} /></button>
        </div>
      </div>
    </div>
    <div class="carousel" data-carousel data-reveal>
      <div class="carousel__track">
        {loans.map((l) => (
          <a href={`/loans/#${l.slug}`} class="loan-tile">
            <div class="loan-tile__img zoom"><img src={l.image} alt="" loading="lazy" width="360" height="400" /></div>
            <div class="loan-tile__body">
              <span class="loan-tile__icon"><Icon name={l.icon} size={20} /></span>
              <h3>{l.name}</h3>
              <p>{l.summary}</p>
              <dl>
                <div><dt>Interest</dt><dd>{l.rate}</dd></div>
                <div><dt>Amount</dt><dd>{l.amount}</dd></div>
              </dl>
            </div>
          </a>
        ))}
      </div>
    </div>
    <div class="container center mt-4" data-reveal>
      <a href="/apply-loan/" class="btn btn--primary btn--lg">Apply for a loan <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
    </div>
  </section>

  <!-- CSR -->
  <section class="section section--cream">
    <div class="container split split--wide-left">
      <div class="csr-collage" data-reveal="left" data-drift style="--drift:16px">
        <img src="/images/csr/healthcare.webp" alt="Village health camp" loading="lazy" width="400" height="265" class="csr-collage__a" />
        <img src="/images/csr/tree-plantation.webp" alt="Tree plantation drive" loading="lazy" width="400" height="265" class="csr-collage__b" />
        <img src="/images/csr/youth-festival.webp" alt="District level youth festival" loading="lazy" width="400" height="265" class="csr-collage__c" />
        <div class="csr-collage__stat">
          <strong data-count="2500" data-suffix="+">2,500+</strong>
          <span>weddings supported through community marriage events</span>
        </div>
      </div>
      <div class="stack" style="--stack:1.25rem">
        <p class="eyebrow" data-reveal>Lokmangal Group</p>
        <h2 class="h2" data-reveal>One step forward through <em>social responsibility</em></h2>
        <p class="lead" data-reveal>
          Social responsibility is an enduring commitment at Lokmangal. Through the Lokmangal Foundation, we support meaningful socio-economic growth in rural India — helping more people take part in, and benefit from, economic progress.
        </p>
        <div class="csr-chips" data-stagger>
          {initiatives.map((it) => <span class="csr-chip"><Icon name={it.icon} size={16} /> {it.title}</span>)}
        </div>
        <div class="btn-row" data-reveal>
          <a href="/social-responsibility/" class="btn btn--green">Learn more <Icon name="arrow-right" size={18} class="icon--arrow" /></a>
          <a href="/contact-us/" class="btn btn--ghost">Get involved</a>
        </div>
      </div>
    </div>
  </section>

  <!-- DIGITAL -->
  <section class="section">
    <div class="container split">
      <div class="stack" style="--stack:1.25rem">
        <p class="eyebrow" data-reveal>Banking in your pocket</p>
        <h2 class="h2" data-reveal>Bank anytime, <em>anywhere</em></h2>
        <p class="lead" data-reveal>
          Check balances, transfer funds and pay bills on the Lokmangal mobile banking app — secured to your registered device and SIM. Prefer simple SMS? We have that too.
        </p>
        <div class="digital-grid" data-stagger>
          {services.slice(0, 6).map((s) => (
            <div class="digital-item"><span class="icon-badge"><Icon name={s.icon} size={20} /></span><span>{s.title}</span></div>
          ))}
        </div>
        <div class="btn-row" data-reveal>
          <a href={site.appUrl} target="_blank" rel="noopener" class="btn btn--green"><Icon name="play" size={18} /> Get it on Google Play</a>
          <a href="/other-services/" class="btn btn--ghost">All services</a>
        </div>
      </div>
      <div class="phone-wrap" data-reveal="right" data-drift style="--drift:20px">
        <div class="phone">
          <div class="phone__notch"></div>
          <div class="phone__screen">
            <div class="phone__top">
              <img src="/images/brand/emblem.png" alt="" width="28" height="34" />
              <span>Lokmangal</span>
              <Icon name="sparkles" size={16} />
            </div>
            <div class="phone__card">
              <small>Savings account</small>
              <strong>₹ 1,24,580.00</strong>
              <span>A/c •••• 4821</span>
            </div>
            <div class="phone__actions">
              <span><Icon name="arrow-left-right" size={18} />Transfer</span>
              <span><Icon name="zap" size={18} />UPI</span>
              <span><Icon name="receipt" size={18} />Bills</span>
              <span><Icon name="piggy-bank" size={18} />Deposits</span>
            </div>
            <div class="phone__list">
              <p><span>FD maturity</span><b class="text-green">+ ₹10,000</b></p>
              <p><span>Electricity bill</span><b>− ₹1,240</b></p>
              <p><span>RD instalment</span><b>− ₹2,000</b></p>
            </div>
          </div>
        </div>
        <div class="phone-chip phone-chip--1"><Icon name="lock" size={16} /> Device-bound security</div>
        <div class="phone-chip phone-chip--2"><Icon name="check-circle" size={16} /> IMPS · UPI · NEFT</div>
      </div>
    </div>
  </section>

  <!-- NOTICES -->
  <section class="section section--tight section--white">
    <div class="container">
      <div class="notice-card" data-reveal>
        <div class="notice-card__head">
          <span class="icon-badge icon-badge--orange"><Icon name="megaphone" size={24} /></span>
          <div>
            <p class="eyebrow">Notices</p>
            <h2 class="h3">{notices.title}</h2>
          </div>
          <a href="/notices/" class="btn btn--ghost btn--sm">All notices <Icon name="arrow-right" size={16} class="icon--arrow" /></a>
        </div>
        <ul class="notice-list" data-stagger>
          {notices.items.slice(0, 6).map((n) => (
            <li>
              <a href={n.href} target={n.kind === 'page' ? undefined : '_blank'} rel={n.kind === 'page' ? undefined : 'noopener'}>
                <Icon name={n.kind === 'pdf' ? 'file-text' : n.kind === 'drive' ? 'external-link' : 'users'} size={18} />
                <span>{n.label}</span>
                <Icon name="arrow-up-right" size={16} class="notice-list__go" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- STORIES -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div class="section-head__text">
          <p class="eyebrow">Read latest stories</p>
          <h2 class="h2">News from the <em>Lokmangal family</em></h2>
