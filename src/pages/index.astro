<script>
  // Loan carousel arrows.
  document.addEventListener('astro:page-load', () => {
    const carousel = document.querySelector<HTMLElement>('[data-carousel]');
    if (!carousel) return;
    document.querySelectorAll<HTMLButtonElement>('[data-scroll]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const card = carousel.querySelector<HTMLElement>('.loan-tile');
        const step = card ? card.offsetWidth + 20 : 320;
        carousel.scrollBy({ left: Number(btn.dataset.scroll) * step * 2, behavior: 'smooth' });
      }),
    );
  });
</script>

