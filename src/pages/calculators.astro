---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Calculator from '../components/Calculator.astro';
import CtaBand from '../components/CtaBand.astro';

const notes = [
  { icon: 'piggy-bank', title: 'Fixed deposit', text: 'Simple interest for tenures up to 12 months; half-yearly compounding beyond that.' },
  { icon: 'calendar', title: 'Recurring deposit', text: 'Each monthly instalment earns interest compounded half-yearly until maturity — matching our Lakshadish maturity values.' },
  { icon: 'coins', title: 'Monthly income', text: 'Interest is paid out every month; your principal is returned at maturity.' },
  { icon: 'hand-coins', title: 'Loan EMI', text: 'Standard reducing-balance EMI with monthly repayment.' },
];
---

<Base title="Calculators" description="FD, RD, monthly income and loan EMI calculators — estimate maturity values and repayments with Lokmangal Multistate rates.">
  <PageHero
    title="Savings & loan"
    accent="calculators"
    eyebrow="Plan with confidence"
    subtitle="Estimate maturity values, monthly income and EMIs using our current rates. All figures are indicative."
    crumbs={[{ label: 'Calculators' }]}
    compact
  />

  <section class="section">
    <div class="container">
      <div data-reveal="zoom"><Calculator /></div>
      <div class="grid grid-4 mt-5" data-stagger>
        {notes.map((n) => (
          <div class="card">
            <span class="icon-badge"><Icon name={n.icon} size={22} /></span>
            <h2 class="h4 mt-2">{n.title}</h2>
            <p class="muted mt-2">{n.text}</p>
          </div>
        ))}
      </div>
      <p class="muted center mt-4" data-reveal>Actual returns depend on the scheme, exact tenure and applicable TDS. Please confirm with your branch before investing.</p>
    </div>
  </section>

  <CtaBand title="Like what you see?" accent="Let’s get started" text="Book a deposit or apply for a loan online — our team will help you with the rest." />
</Base>
