---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
---

<Base title="Privacy Policy" description="How Lokmangal Multistate Co-operative Society collects, uses and protects your personal information.">
  <PageHero title="Privacy" accent="policy" eyebrow="Legal" crumbs={[{ label: 'Privacy Policy' }]} compact />
  <section class="section">
    <div class="container container--narrow prose legal" data-reveal>
      <p>{site.legalName} respects your privacy. This policy explains what information we collect through this website and how we use it.</p>
      <h2>Information we collect</h2>
      <p>When you submit a form — such as an account, deposit, loan, callback, contact or job application — we collect the details you provide, for example your name, phone number, email address, city and message. We do not ask for passwords, PINs or card details on this website, and you should never share them with anyone.</p>
      <h2>How we use it</h2>
      <ul>
        <li>To contact you about your enquiry or application.</li>
        <li>To help you open an account, deposit or loan at a branch.</li>
        <li>To respond to service requests and improve our services.</li>
      </ul>
      <h2>Sharing</h2>
      <p>We do not sell your personal information. We share it only with our own staff and branches who need it to serve you, or where required by law or a regulator.</p>
      <h2>Security & retention</h2>
      <p>We take reasonable steps to protect the information you share and keep it only for as long as needed to serve you or to meet legal requirements.</p>
      <h2>Cookies</h2>
      <p>This website stores only small, temporary preferences in your browser (for example, whether you dismissed an announcement). Embedded services such as Google Maps or YouTube may set their own cookies when you use them.</p>
      <h2>Your choices</h2>
      <p>You may ask us to update or delete the details you submitted by writing to <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      <h2>Contact</h2>
      <p>{site.legalName}, {site.address.line1}, {site.address.line2}, {site.address.city} – {site.address.pin}. Phone: <a href={site.phoneHref}>{site.phone}</a>.</p>
    </div>
  </section>
</Base>

<style>
  .legal h2 { font-size: 1.35rem; margin-top: 2em; }
  .legal p, .legal li { color: var(--muted); }
</style>
