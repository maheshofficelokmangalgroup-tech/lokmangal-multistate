---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';
import { site } from '../data/site';
---

<Base title="Other Services" description="Net banking, mobile banking, IMPS & UPI, NEFT/RTGS, SMS banking, safe deposit lockers and utility bill payments at Lokmangal Multistate.">
  <PageHero
    title="Banking services that"
    accent="save your time"
    eyebrow="Other services"
    subtitle="Exceptional services and facilities — right in the heart of rural India. Here are the key services available to every Lokmangal member."
    crumbs={[{ label: 'Other Services' }]}
  >
    <a href={site.appUrl} target="_blank" rel="noopener" class="btn btn--primary"><Icon name="smartphone" size={18} /> Download mobile app</a>
    <a href="#enquiry" class="btn btn--outline-light">Make an enquiry</a>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="svc-list">
        {services.map((s, i) => (
          <article class:list={['svc', { 'svc--flip': i % 2 === 1 }]}>
            <div class="svc__media" data-reveal={i % 2 ? 'right' : 'left'}>
              <img src={s.image} alt={s.title} loading="lazy" width="700" height="480" />
              <span class="svc__num">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="svc__text" data-reveal={i % 2 ? 'left' : 'right'}>
              <span class="icon-badge icon-badge--orange"><Icon name={s.icon} size={26} /></span>
              <h2 class="h2">{s.title}</h2>
              <p class="lead">{s.text}</p>
              {s.title === 'Mobile Banking' || s.title === 'Net Banking' ? (
                <a href={site.appUrl} target="_blank" rel="noopener" class="link-arrow">Download the mobile app <Icon name="arrow-right" size={16} /></a>
              ) : (
                <a href="/branches/" class="link-arrow">Visit your nearest branch <Icon name="arrow-right" size={16} /></a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--cream" id="enquiry">
    <div class="container split">
      <div class="stack" style="--stack:1.2rem" data-reveal>
        <p class="eyebrow">Get in touch</p>
        <h2 class="h2">Be it an enquiry or a <em>service request</em></h2>
        <p class="lead">Write to us and we’ll get back to you. You can also call <a href={site.phoneHref} class="text-green"><strong>{site.phone}</strong></a> or email <a href={`mailto:${site.email}`} class="text-green"><strong>{site.email}</strong></a>.</p>
      </div>
      <div data-reveal="right"><EnquiryForm variant="service" title="Service enquiry" /></div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .svc-list { display: grid; gap: clamp(56px, 8vw, 104px); }
  .svc { display: grid; gap: clamp(28px, 5vw, 72px); align-items: center; }
  @media (min-width: 900px) {
    .svc { grid-template-columns: 1fr 1fr; }
    .svc--flip .svc__media { order: 2; }
  }
  .svc__media { position: relative; border-radius: var(--r-xl); overflow: hidden; box-shadow: var(--shadow-lg); aspect-ratio: 16 / 11; background: var(--g-50); }
  .svc__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .svc:hover .svc__media img { transform: scale(1.05); }
  .svc__num { position: absolute; right: 18px; top: 12px; font-size: 4rem; font-weight: 800; letter-spacing: -0.05em; color: #fff; text-shadow: 0 6px 30px rgb(0 0 0 / 0.35); line-height: 1; }
  .svc__text { display: grid; gap: 18px; justify-items: start; }
</style>
