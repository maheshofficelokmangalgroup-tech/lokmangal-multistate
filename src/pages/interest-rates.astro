---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { schemes, fdSlabs, specialCategories, fmtRate } from '../data/deposits';
import { loans } from '../data/loans';
import { site } from '../data/site';

const otherSchemes = schemes.filter((s) => s.slug !== 'vishwamangal-fixed-deposit-scheme');
const tenureOf = (s: (typeof schemes)[number]) => s.facts.find((f) => /tenure|special categories/i.test(f.label))?.value ?? '—';
---

<Base title="Interest Rates" description={`Lokmangal Multistate interest rates 2026-27: fixed deposits up to 10% p.a., special categories up to 0.50% extra, recurring deposits 9.50%, monthly income 9.75%. Valid ${site.ratesValidity}.`}>
  <PageHero
    title="Interest rates on"
    accent="deposits & loans"
    eyebrow="Rate chart 2026–27"
    subtitle={`Current rates on our deposit schemes and loan products. Deposit rates are valid from ${site.ratesValidity}.`}
    crumbs={[{ label: 'Deposits', href: '/deposits/' }, { label: 'Interest Rates' }]}
    compact
  />

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Vishwamangal Fixed Deposit</p>
        <h2 class="h2">Fixed deposit <em>rates</em></h2>
      </div>
      <div class="table-wrap" data-reveal>
        <table class="table rates">
          <thead><tr><th>Sr.</th><th>Tenure</th><th>Regular depositors</th><th>Special categories*</th></tr></thead>
          <tbody>
            {fdSlabs.map((r, i) => (
              <tr>
                <td>{i + 1}</td>
                <td><strong>{r.tenure}</strong></td>
                <td class="rate"><span class="bar" style={`--w:${r.regular * 9}%`}></span>{fmtRate(r.regular)}%</td>
                <td class="rate rate--special"><span class="bar bar--o" style={`--w:${r.special * 9}%`}></span>{fmtRate(r.special)}%</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted mt-2" style="font-size:.9rem" data-reveal>* {specialCategories}</p>

      <div class="section-head mt-5" data-reveal>
        <p class="eyebrow">Other deposit schemes</p>
        <h2 class="h2">Recurring, monthly &amp; <em>doubling</em> schemes</h2>
      </div>
      <div class="table-wrap" data-reveal>
        <table class="table">
          <thead><tr><th>Scheme</th><th>Type</th><th>Rate</th><th>Tenure / term</th><th></th></tr></thead>
          <tbody>
            {otherSchemes.map((s) => (
              <tr>
                <td><strong>{s.name}</strong><br /><span class="muted" lang="mr">{s.nameMr}</span></td>
                <td>{s.facts[0].value}</td>
                <td class="rate">{s.rate !== null ? `${fmtRate(s.rate)}%` : 'Doubles'}</td>
                <td>{tenureOf(s)}</td>
                <td><a href={`/deposits/${s.slug}/`} class="link-arrow">Details <Icon name="arrow-right" size={14} /></a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="section-head mt-5" data-reveal>
        <p class="eyebrow">Loans</p>
        <h2 class="h2">Loan <em>interest rates</em></h2>
      </div>
      <div class="table-wrap" data-reveal>
        <table class="table">
          <thead><tr><th>Loan</th><th>Rate of interest</th><th>Loan amount</th><th></th></tr></thead>
          <tbody>
            {loans.map((l) => (
              <tr>
                <td><strong>{l.name}</strong></td>
                <td class="rate">{l.details.find((d) => d[0] === 'Rate of interest')?.[1] ?? l.rate}</td>
                <td>{l.amount}</td>
                <td><a href={`/loans/#${l.slug}`} class="link-arrow">Details <Icon name="arrow-right" size={14} /></a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="note card mt-4" data-reveal>
        <Icon name="help-circle" size={22} />
        <p>TDS is applicable on interest earned on deposits, except for society members. Rates are subject to change — please confirm the latest rate at your branch or call <a href={site.phoneHref}>{site.phone}</a> before investing.</p>
      </div>
    </div>
  </section>

  <CtaBand title="Lock in today’s" accent="best rates" text="Book a deposit at any of our 60 branches, or apply online and our team will guide you." />
</Base>

<style>
  .rates td { position: relative; }
  .rates .bar { display: block; height: 6px; width: var(--w); max-width: 100%; border-radius: 6px; background: linear-gradient(90deg, var(--g-300), var(--g-600)); margin-bottom: 8px; transform-origin: left; animation: bar-in 1.2s var(--ease-out) both; }
  .rates .bar--o { background: linear-gradient(90deg, var(--o-200), var(--o-500)); }
  @keyframes bar-in { from { transform: scaleX(0); } }
  .note { display: flex; gap: 14px; align-items: flex-start; background: var(--g-50); border-color: var(--g-100); }
  .note :global(.icon) { color: var(--g-600); flex: none; margin-top: 2px; }
  .note a { font-weight: 700; color: var(--g-700); }
</style>
